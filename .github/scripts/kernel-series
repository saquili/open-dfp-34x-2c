#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Paweł Phan <szop.hektar_1w@icloud.com>
#
# kernel-series -- locate our kernel series on top of the release in linux/.
#
# Usage: kernel-series import
#        kernel-series upstream
#        kernel-series files [PATHSPEC...]
#        kernel-series check-log LOG
#
# linux/ is a kernel release imported with "git subtree add --squash", with
# our kernel commits on top (see CONTRIBUTING.rst).
#
#   import      the squash commit of the release linux/ is based on now: the
#               latest "Squashed 'linux/' ..." commit reachable from HEAD.
#               Its tree is the release as it is.
#   upstream    the commit that squash was made from, named by its
#               git-subtree-split trailer: the commit at which the history
#               of "git subtree split -P linux" starts.
#   files       the paths, relative to linux/, that HEAD adds or changes on
#               top of the release, one per line; PATHSPECs, relative to
#               linux/ as well, narrow the list.
#   check-log   print the lines of LOG -- the output of a compiler, a checker
#               or a documentation build -- that name a file the series adds
#               or changes, as "linux/<path>:", and exit 1 if there is any.
#               A file the series adds is judged whole. A file of the release
#               that the series changes is judged by its changed lines: a
#               diagnostic "linux/<path>:<line>" counts only when <line> is
#               one the series added or changed, or when it names no line.
#               Diagnostics about upstream's own files pass unjudged.
#
# Exit status: 0 success, 1 check-log found lines, 2 usage or repository
# error.

set -eu

me=${0##*/}

die() {
	printf '%s: %s\n' "$me" "$*" >&2
	exit 2
}

usage() {
	awk '/^# Usage:/ { p = 1 } p && !/^#/ { exit } p { sub(/^# ?/, ""); print }' \
		"$0" >&2
	exit 2
}

top=$(git rev-parse --show-toplevel) || die "not inside a git repository"

import_commit() {
	commit=$(git -C "$top" log -1 --format=%H --all-match \
		--grep='^git-subtree-dir: linux/*$' \
		--grep="^Squashed 'linux/' " HEAD) || exit 2
	[ -n "$commit" ] || die "no subtree import of linux/ is reachable from HEAD"
	printf '%s\n' "$commit"
}

series_files() {
	squash=$(import_commit)
	git -C "$top" diff --name-only --no-renames --diff-filter=AMT \
		"$squash" HEAD:linux -- "$@"
}

# The lines a modified file of the release gained, as "path first last".
series_hunks() {
	squash=$(import_commit)
	git -C "$top" diff -U0 --no-renames --diff-filter=MT \
		"$squash" HEAD:linux |
		awk '
			/^\+\+\+ / { path = substr($0, 7); next }
			/^@@ / {
				plus = $3
				sub(/^\+/, "", plus)
				n = split(plus, a, ",")
				count = (n > 1) ? a[2] : 1
				if (count > 0)
					print path, a[1], a[1] + count - 1
			}'
}

[ $# -ge 1 ] || usage
command=$1
shift
case $command in
import)
	[ $# -eq 0 ] || usage
	import_commit
	;;
upstream)
	[ $# -eq 0 ] || usage
	squash=$(import_commit)
	split=$(git -C "$top" log -1 --format=%B "$squash" |
		sed -n 's/^git-subtree-split: *\([0-9a-f]\{40,\}\) *$/\1/p')
	[ -n "$split" ] || die "$squash has no git-subtree-split trailer"
	printf '%s\n' "$split"
	;;
files)
	series_files "$@"
	;;
check-log)
	[ $# -eq 1 ] || usage
	[ -r "$1" ] || die "cannot read $1"
	files=$(mktemp)
	hunks=$(mktemp)
	trap 'rm -f "$files" "$hunks"' EXIT
	series_files >"$files"
	[ -s "$files" ] || exit 0
	series_hunks >"$hunks"
	if ! awk -v files="$files" -v hunks="$hunks" '
		BEGIN {
			while ((getline p < files) > 0)
				known[p] = 1
			while ((getline l < hunks) > 0) {
				split(l, f, " ")
				modified[f[1]] = 1
				n[f[1]]++
				lo[f[1], n[f[1]]] = f[2]
				hi[f[1], n[f[1]]] = f[3]
			}
		}
		{
			rest = $0
			while (match(rest, /linux\/[^: \t]+:[0-9]*/)) {
				ref = substr(rest, RSTART + 6, RLENGTH - 6)
				rest = substr(rest, RSTART + RLENGTH)
				split(ref, r, ":")
				if (!(r[1] in known))
					continue
				if ((r[1] in modified) && r[2] != "") {
					judged = 0
					for (i = 1; i <= n[r[1]]; i++)
						if (r[2] + 0 >= lo[r[1], i] && r[2] + 0 <= hi[r[1], i])
							judged = 1
					if (!judged)
						continue
				}
				print
				bad = 1
				break
			}
		}
		END { exit bad }
	' "$1"; then
		exit 1
	fi
	;;
*)
	usage
	;;
esac
