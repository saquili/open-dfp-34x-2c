# The traffic control the kernel backend test of omcid exercises: the tc
# classifiers and actions that omcid installs, among them the vlan action,
# which many distributions' kernels leave out, and the virtual Ethernet pairs
# the test builds its interfaces from.
CONFIG_VETH=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_FLOWER=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_VLAN=y
CONFIG_NET_ACT_GACT=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NET_ACT_SKBEDIT=y
