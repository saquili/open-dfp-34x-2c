#
# The kernel of this tree in qemu, for the tests that need a kernel with the
# features of the board's and no board: see tools/vm/README.rst.
#
#   tools/vm/vm omcid-kernel   omcid's kernel backend test (make check-kernel)
#   tools/vm/vm pon-selftest   the PON class selftest over the stand-in MAC
#   tools/vm/vm kunit          the KUnit tests of the RTL9602C drivers
#   tools/vm/vm image          build the container again
#   tools/vm/vm clean          forget the kernel builds
#
# Needs docker and an aarch64 host. The environment goes on to the test: see
# tools/vm/guest.

set -eu

here=$(cd "$(dirname "$0")" && pwd)
top=$(cd "$here/../.." && pwd)
image=${VM_IMAGE:-open-dfp-34x-2c-vm}
volume=${VM_VOLUME:-open-dfp-34x-2c-vm-kbuild}

usage() {
	sed -n '/^# *tools\/vm\/vm /s/^# *//p' "$0" >&2
	exit 2
}

[ $# -eq 1 ] || usage

case "$1" in
image)
	exec docker build -t "$image" "$here"
	;;
clean)
	exec docker volume rm "$volume"
	;;
omcid-kernel | pon-selftest | kunit)
	docker image inspect "$image" >/dev/null 2>&1 || docker build -t "$image" "$here"
	exec docker run --rm -e REBUILD -e JOBS -e QEMU_TIMEOUT -e VM_CMD -e PYTEST_ARGS \
		-v "$top":/r:ro -v "$volume":/kb "$image" /r/tools/vm/guest "$1"
	;;
*)
	usage
	;;
esac
