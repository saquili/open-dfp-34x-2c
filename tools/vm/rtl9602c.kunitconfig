# The KUnit tests of the RTL9602C switch driver and of its PON driver, for
# kunit.py (tools/vm/vm kunit).
CONFIG_KUNIT=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_DSA=y
CONFIG_I2C=y
CONFIG_NET_DSA_RTL9602C=y
CONFIG_NET_DSA_RTL9602C_KUNIT_TEST=y
CONFIG_PON_RTL9602C=y
CONFIG_PON_RTL9602C_KUNIT_TEST=y
