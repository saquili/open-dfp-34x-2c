"""Run the self-tests of tools/equiv.

Usage: tests/run [-v] [TEST...]

TEST names a module, class or method (test_acceptance,
test_ctok.CommentTest, ...); without one every test_*.py here runs.  Needs
Python 3 and git.  The tests that run tools in the toolchain container are
not here: see repro-check.
"""
import os
import sys
import unittest

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
sys.path.insert(0, os.path.dirname(HERE))


def main(argv):
    verbosity = 1
    names = []
    for arg in argv:
        if arg in ('-v', '--verbose'):
            verbosity = 2
        elif arg in ('-h', '--help'):
            sys.stdout.write(__doc__)
            return 0
        else:
            names.append(arg)
    loader = unittest.defaultTestLoader
    if names:
        suite = loader.loadTestsFromNames(names)
    else:
        suite = loader.discover(HERE, pattern='test_*.py', top_level_dir=HERE)
    result = unittest.TextTestRunner(verbosity=verbosity).run(suite)
    return 0 if result.wasSuccessful() else 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
