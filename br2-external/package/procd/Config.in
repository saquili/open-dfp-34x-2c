config BR2_PACKAGE_PROCD
	bool "procd"
	depends on !BR2_STATIC_LIBS # libubox, ubus
	depends on BR2_TOOLCHAIN_HAS_SYNC_4 # json-c, ubus
	select BR2_PACKAGE_JSON_C
	select BR2_PACKAGE_LIBUBOX
	select BR2_PACKAGE_UBUS
	help
	  OpenWrt's init and service supervisor: the first process,
	  which feeds the watchdog, starts ubusd and the programs of
	  /etc/inittab and starts them again when they end.

	  https://git.openwrt.org/?p=project/procd.git
