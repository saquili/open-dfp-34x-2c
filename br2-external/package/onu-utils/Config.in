config BR2_PACKAGE_ONU_UTILS
	bool "onu-utils"
	depends on !BR2_STATIC_LIBS # libubox, ubus
	depends on BR2_TOOLCHAIN_HAS_SYNC_4 || BR2_mips_1 # json-c, ubus
	select BR2_PACKAGE_JSON_C
	select BR2_PACKAGE_LIBMNL
	select BR2_PACKAGE_LIBUBOX
	select BR2_PACKAGE_UBUS
	select BR2_PACKAGE_ZLIB
	help
	  The small programs of the ONU, from onu-utils/ in this
	  repository: ponid, which prints the identity of the unit
	  from its factory configuration; pon, which shows the PON
	  devices and their ONU as the kernel reports them; and
	  onu-mode, which puts the stick in bridge or router mode.
