#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Paweł Phan <szop.hektar_1w@icloud.com>
#
# The first program of the ODI DFP-34X-2C3 image, which the kernel starts as
# process 1. It mounts the file systems that the kernel does not, and then
# procd, OpenWrt's init and service supervisor, takes its place as process 1:
# procd feeds the watchdog, starts ubusd, runs the boot script
# (/etc/rc.d/S*, from /etc/inittab) and starts the programs of /etc/inittab,
# again whenever one ends.
#
# The root file system is read-only. Everything that is written lives in
# memory and is gone at the next restart: /tmp, /run and /var are tmpfs, and
# /var/run is /run, where ubusd's socket is.

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

# The kernel mounts devtmpfs on /dev itself when it starts this program; it
# is mounted here only if that has not happened. procd keeps it.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
grep -q ' /dev devtmpfs ' /proc/mounts || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts -o gid=5,mode=620,ptmxmode=0666 devpts /dev/pts
ln -sf /proc/self/fd /dev/fd
ln -sf /proc/self/fd/0 /dev/stdin
ln -sf /proc/self/fd/1 /dev/stdout
ln -sf /proc/self/fd/2 /dev/stderr
# Each with a ceiling: a tmpfs takes half the memory by default, and the
# three together could take more than the stick has, which the kernel and
# the data path need. Measured after two hours of two sessions: /run holds
# 376 KiB, /tmp 4 KiB, /var nothing.
mount -t tmpfs -o mode=1777,size=2m tmpfs /tmp
mount -t tmpfs -o mode=0755,nosuid,nodev,size=4m tmpfs /run
mount -t tmpfs -o mode=0755,size=1m tmpfs /var
ln -s ../run /var/run
ln -s ../tmp /var/tmp
mkdir -p /var/log

exec /sbin/procd
