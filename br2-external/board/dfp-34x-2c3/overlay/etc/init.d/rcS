#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Paweł Phan <szop.hektar_1w@icloud.com>
#
# The boot script of the ODI DFP-34X-2C3 image. BusyBox init runs it once from
# /etc/inittab, before the console shell starts. It mounts the file systems that
# the kernel does not, gives the stick its management addresses, starts the ssh
# server and prints a line that says the board is ready.
#
# The root file system is read-only. Everything that is written lives in memory
# and is gone at the next restart, including the host key of the ssh server,
# which is made again at every boot.

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

# The management addresses are in the ranges that RFC 5737 reserves for
# documentation. The first is on the host link itself; the second is on a VLAN
# of that link, so that it is not lost when the link joins a bridge. A bench
# with other addresses puts them in /etc/board.conf (docs/handbook/building.rst).
DATA_ADDRESS=192.0.2.2/30
MGMT_VLAN=4094
MGMT_ADDRESS=198.51.100.2/30
[ -r /etc/board.conf ] && . /etc/board.conf

warn() {
	echo "rcS: $*" >&2
}

# The file systems. The kernel mounts devtmpfs on /dev itself when it starts
# the first program; it is mounted here only if that has not happened.
mount -t proc proc /proc || warn "cannot mount /proc"
mount -t sysfs sysfs /sys || warn "cannot mount /sys"
grep -q ' /dev devtmpfs ' /proc/mounts || mount -t devtmpfs devtmpfs /dev || warn "no /dev"
mkdir -p /dev/pts
mount -t devpts -o gid=5,mode=620,ptmxmode=0666 devpts /dev/pts || warn "cannot mount /dev/pts"
ln -sf /proc/self/fd /dev/fd
ln -sf /proc/self/fd/0 /dev/stdin
ln -sf /proc/self/fd/1 /dev/stdout
ln -sf /proc/self/fd/2 /dev/stderr
mount -t tmpfs -o mode=1777 tmpfs /tmp || warn "cannot mount /tmp"
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run || warn "cannot mount /run"
mount -t tmpfs -o mode=0755 tmpfs /var || warn "cannot mount /var"
ln -s ../run /var/run
ln -s ../tmp /var/tmp
mkdir -p /var/log

hostname -F /etc/hostname

# The packet filter, before any link is up and any server listens. Without it
# the stick accepts everything.
nft -f /etc/nftables.conf || warn "no packet filter: the stick accepts everything"

# The links. The stick's host side is the interface sfp.
ip link set lo up
ip link set sfp up || warn "no interface sfp"
ip address add "$DATA_ADDRESS" dev sfp || warn "no address on sfp"
ip link add link sfp name mgmt type vlan id "$MGMT_VLAN" || warn "no VLAN $MGMT_VLAN on sfp"
ip address add "$MGMT_ADDRESS" dev mgmt || warn "no address on mgmt"
ip link set mgmt up || warn "mgmt does not come up"

# The ssh server takes keys only: /root/.ssh/authorized_keys, which an image
# built with a bench's keys carries and this one does not.
mkdir -p /run/dropbear
dropbearkey -t ed25519 -f /run/dropbear/host_key >/dev/null 2>&1 || warn "no host key"
dropbear -s -r /run/dropbear/host_key -P /run/dropbear.pid || warn "dropbear did not start"

# The identity of the unit, from its factory configuration: omcid reads it,
# and the PON driver takes the serial number before the PON comes up. The
# file holds the PLOAM password, so only root may read it.
umask 077
ponid >/run/onu-identity || warn "no identity in the factory configuration"
umask 022
serial=$(grep '^serial=' /run/onu-identity | cut -d= -f2)
dev=$(devlink dev show | head -n 1)
if [ -n "$serial" ] && [ -n "$dev" ]; then
	devlink dev param set "$dev" name gpon_serial cmode runtime value "$serial" ||
		warn "the PON driver did not take the serial number"
	ip link set pon up || warn "the PON does not come up"
else
	warn "no serial number: the PON stays down"
fi

# The OMCI daemon answers the OLT. Its log is in /run, which is in memory.
if [ -x /usr/sbin/omcid ]; then
	omcid >/run/omcid.log 2>&1 &
else
	warn "no omcid: nothing answers the OLT"
fi

# The HTTP status daemon. Its API needs the token of /etc/pond.token; an
# image without the file serves only /api/health.
if [ -x /usr/sbin/pond ]; then
	pond >/run/pond.log 2>&1 &
fi

echo
echo "open-dfp-34x-2c: the ODI DFP-34X-2C3, $(uname -sr), $(uname -m)"
echo "open-dfp-34x-2c: ssh on $DATA_ADDRESS (sfp) and $MGMT_ADDRESS (VLAN $MGMT_VLAN)"
echo "open-dfp-34x-2c: ready"
