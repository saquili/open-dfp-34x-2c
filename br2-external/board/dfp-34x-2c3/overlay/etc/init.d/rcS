#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Paweł Phan <szop.hektar_1w@icloud.com>
#
# The boot script of the ODI DFP-34X-2C3 image. procd runs it once, as
# /etc/rc.d/S10boot, from /etc/inittab: after /sbin/init has mounted the file
# systems and procd has started ubusd, syslogd and netifd, and before the ssh
# server, the status daemon and the console's login prompt. It reads the
# unit's settings, gives the stick its management addresses, through netifd,
# starts the data path and prints a line on the console that says the board
# is ready. Its output goes to procd's log, but for that line.
#
# The root file system is read-only. Everything that is written lives in memory
# and is gone at the next restart.

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

# The management addresses are in the ranges that RFC 5737 reserves for
# documentation. The first is on the host link itself; the second is on a VLAN
# of that link of its own, which the switch keeps from the PON both ways and
# which works whether the link is bridged or not, as the first does not. A
# bench with other addresses puts them in /etc/board.conf
# (docs/handbook/building.rst); an empty DATA_ADDRESS leaves the stick without
# an address on the subscriber's data path, managed by its VLAN alone, as an
# operator's ONT has none there.
DATA_ADDRESS=192.0.2.2/30
MGMT_VLAN=4094
MGMT_ADDRESS=198.51.100.2/30
[ -r /etc/board.conf ] && . /etc/board.conf

warn() {
	echo "rcS: $*" >&2
}

# The identity of the unit, its saved settings, its PPPoE account and root's
# password, from the configuration store; the identity from the shipped
# firmware's configuration until the store holds one. omcid reads the
# identity, and the PON driver takes the serial number before the PON comes
# up. The file holds the PLOAM password, so only root may read it. Root's
# password goes to /run/shadow, which /etc/shadow names, for the console's
# login and the ssh server.
umask 077
onu-store load || warn "no identity in the configuration store or the factory configuration"
# A bench may name the versions that the software images and the circuit
# packs report to the OLT, so that a unit shows what the firmware it came
# with showed; without them omcid reports its own.
[ -n "${OMCI_SW_VERSION:-}" ] && echo "sw_version=$OMCI_SW_VERSION" >>/run/onu-identity
[ -n "${OMCI_PACK_VERSION:-}" ] && echo "pack_version=$OMCI_PACK_VERSION" >>/run/onu-identity
umask 022

# The stick's own settings that its owner changed (onu-store system): its
# name, and its management VLAN and address, which replace the image's.
# Each value is read as data, never run.
SYS_HOSTNAME=
BOARD_MGMT_VLAN=$MGMT_VLAN
BOARD_MGMT_ADDRESS=$MGMT_ADDRESS
if [ -r /run/onu-system ]; then
	SYS_HOSTNAME=$(sed -n 's/^HOSTNAME=//p' /run/onu-system)
	value=$(sed -n 's/^MGMT_VLAN=//p' /run/onu-system)
	[ -n "$value" ] && MGMT_VLAN=$value
	value=$(sed -n 's/^MGMT_ADDRESS=//p' /run/onu-system)
	[ -n "$value" ] && MGMT_ADDRESS=$value
fi

hostname -F /etc/hostname
[ -n "$SYS_HOSTNAME" ] && { hostname "$SYS_HOSTNAME" || warn "the name $SYS_HOSTNAME was refused"; }

# The CPU port's interface, cpu, would otherwise take each frame that arrives
# alone with an interrupt of its own. Polling again, up to twice, 50 us apart,
# before its interrupt is enabled again takes the frames that arrive meanwhile
# in one pass: under a flood that the switch holds at its limit of 5000 frames
# a second, the CPU keeps about three quarters of its time instead of half.
echo 2 > /sys/class/net/cpu/napi_defer_hard_irqs &&
	echo 50000 > /sys/class/net/cpu/gro_flush_timeout ||
	warn "the CPU port takes an interrupt per frame"

# The stick keeps quiet towards the PON: it has no address there, and nothing
# of its own may leave by it. The PON port and the CPU port carry no IPv6, nor
# does any interface made from here on unless it is given IPv6 (the bridge and
# the GEM interfaces that omcid makes among them), so the stick sends no
# router solicitation, neighbour discovery or listener report of its own to
# the OLT and answers none from it. ARP answers only for an address of the
# interface it is asked on. The host side, sfp and mgmt, keeps IPv6.
echo 1 >/proc/sys/net/ipv6/conf/default/disable_ipv6 &&
	echo 1 >/proc/sys/net/ipv6/conf/cpu/disable_ipv6 &&
	echo 1 >/proc/sys/net/ipv6/conf/pon/disable_ipv6 ||
	warn "IPv6 stays on towards the PON: the stick can show itself there"
echo 1 >/proc/sys/net/ipv4/conf/all/arp_ignore &&
	echo 2 >/proc/sys/net/ipv4/conf/all/arp_announce ||
	warn "ARP answers for every address on every interface"

# The setting of the SFP lane its owner kept (onu-lane), if any; the driver
# looks for the host's otherwise.
onu-lane apply || warn "the stored setting of the SFP lane was refused"

# The links. The stick's host side is the interface sfp. The conduit of the
# switch, cpu, which carries every port's traffic, the PON's too, is up before
# netifd starts: netifd brings a port's parent up with the port, and takes
# down only what it brought up.
ip link set lo up
ip link set cpu up || warn "the switch's conduit does not come up"
ip link set sfp up || warn "no interface sfp"
if [ -n "$DATA_ADDRESS" ]; then
	ip address add "$DATA_ADDRESS" dev sfp || warn "no address on sfp"
fi

# The management VLAN and its address. netifd, which procd runs, brings them
# up, from the part "mgmt" of its configuration in /run/config, which onu-mgmt
# writes (onu-net) now and again when the pair changes. A stored pair that is
# not a VLAN and an address gives way to the image's. The ssh server can
# listen only once the address is there: if netifd has not brought it up
# within ten seconds, the script brings it up itself, so that the stick stays
# reachable; netifd takes the VLAN over as it finds it.
onu-mgmt start "$MGMT_VLAN" "$MGMT_ADDRESS" "$DATA_ADDRESS" || {
	warn "VLAN $MGMT_VLAN with $MGMT_ADDRESS is not a pair, the image's instead"
	MGMT_VLAN=$BOARD_MGMT_VLAN
	MGMT_ADDRESS=$BOARD_MGMT_ADDRESS
	onu-mgmt start "$MGMT_VLAN" "$MGMT_ADDRESS" "$DATA_ADDRESS"
}
onu-net wait mgmt "$MGMT_ADDRESS" 10 || {
	warn "netifd did not bring $MGMT_ADDRESS up in VLAN $MGMT_VLAN, the script does"
	ip link add link sfp name mgmt type vlan id "$MGMT_VLAN"
	ip address add "$MGMT_ADDRESS" dev mgmt || warn "no address on mgmt"
	echo 0 >/proc/sys/net/ipv6/conf/mgmt/disable_ipv6 || warn "no IPv6 on mgmt"
	ip link set mgmt up || warn "mgmt does not come up"
}

# The management VLAN stays between the host side and the stick, so that the
# network behind the PON never sees it and never reaches it: on sfp's ingress
# the switch sends its frames to the CPU alone, which keeps them from the PON,
# and on pon's ingress it drops them.
mgmt_tag="pref 1 protocol 802.1Q flower skip_sw vlan_id $MGMT_VLAN"
tc qdisc add dev sfp clsact &&
	tc filter add dev sfp ingress $mgmt_tag action trap ||
	warn "frames of VLAN $MGMT_VLAN can go out to the PON"
tc qdisc add dev pon clsact &&
	tc filter add dev pon ingress $mgmt_tag action drop ||
	warn "frames of VLAN $MGMT_VLAN can come in from the PON"

# The servers listen on the addresses of the host side and nowhere else: the
# stick has no packet filter, and nothing on the PON side, nor on the WAN of
# router mode, is to reach them. procd starts them once this script is done
# (onu-run): the ssh server, which takes root's password and the keys of
# /root/.ssh/authorized_keys, which an image built with a bench's keys carries
# and this one does not, and the status daemon with its panel, where people
# sign in as root, with root's password, and scripts may present the token of
# /etc/pond.token, which an image without the file does not accept.
data=${DATA_ADDRESS%/*}
mgmt=${MGMT_ADDRESS%/*}

# The identity to the PON driver, which takes it before the PON comes up.
onu-mode identity || warn "the PON stays down"

# The mode of /etc/onu.conf, bridge or router: onu-mode starts omcid, which
# answers the OLT and logs to /run/omcid.log, and in router mode the router.
if [ -x /usr/sbin/omcid ]; then
	onu-mode start || warn "onu-mode did not start"
else
	warn "no omcid: nothing answers the OLT"
fi

# After a start from a bank that the boot loader was told to try once,
# onu-trial makes it the bank the loader starts when the system is up, and
# restarts into the committed bank when it is not; any other start it leaves
# alone.
onu-trial "${data:-$mgmt}" >/run/onu-trial.log 2>&1 &

# The bench waits for the last line on the console.
{
	echo
	echo "open-dfp-34x-2c: the ODI DFP-34X-2C3, $(uname -sr), $(uname -m)"
	echo "open-dfp-34x-2c: ssh on $MGMT_ADDRESS (VLAN $MGMT_VLAN)${data:+ and $DATA_ADDRESS (sfp)}"
	echo "open-dfp-34x-2c: ready"
} >/dev/console
