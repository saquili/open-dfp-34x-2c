#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Paweł Phan <szop.hektar_1w@icloud.com>
#
# The boot script of the ODI DFP-34X-2C3 image. procd runs it once, as
# /etc/rc.d/S10boot, from /etc/inittab: after /sbin/init has mounted the file
# systems and procd has started ubusd, and before the console's login prompt.
# It starts the stick's programs as procd's services, in their order
# (onu-svc), reads the unit's settings, gives the stick its management
# addresses, through netifd, starts the data path and prints a line on the
# console that says the board is ready. Its output goes to procd's log, but
# for that line.
#
# The root file system is read-only. What is written lives in memory and is
# gone at the next restart, but for this system's file in the partition
# "config", which onu-config keeps (onu-config load, below).

# /usr/lib/onu holds the helpers of this tree that only programs run (ADR 0012).
PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/lib/onu
export PATH

# Started from RAM, the root is the kernel's rootfs, whose top directory any
# account may write to (mode 1777). The ssh server refuses login keys in a
# directory that a path writable by others leads to, / included, so the top
# directory is made 0755 as the flash's root file system has it. That one is
# read-only, and the test leaves it alone.
[ ! -w / ] || chmod 0755 /

# After a start from a bank that the boot loader was told to try once,
# onu-trial makes it the bank the loader starts when the system is up, and
# restarts into the committed bank when it is not; any other start it leaves
# alone. It starts first, so that a start that hangs in this script is
# restarted as well; it finds the panel's address in /run/onu-mgmt once
# onu-mgmt has written it, below.
onu-trial >/run/onu-trial.log 2>&1 &

# The management address is on a VLAN of the host link of its own, 4094,
# which the switch keeps from the PON both ways and which works whether the
# link is bridged or not: the one the shipped firmware gave the host link
# (ponid lan_address), so that its owner finds the panel at the address where
# they found the shipped firmware's page, or else that firmware's own
# default. The host link itself has no address of the stick's, as an
# operator's ONT has none on the subscriber's data path: the OLT's services
# put it in a bridge, where an address of the port would take no traffic. A
# bench with other addresses puts them in /etc/board.conf
# (docs/handbook/building.rst), DATA_ADDRESS for one on the host link itself.
DATA_ADDRESS=
MGMT_VLAN=4094
MGMT_ADDRESS=$(ponid lan_address 2>/dev/null) || MGMT_ADDRESS=192.168.1.1/24
[ -r /etc/board.conf ] && . /etc/board.conf

warn() {
	echo "rcS: $*" >&2
}

# The system log, in memory: syslogd keeps /run/messages and one older copy
# (its default), of 64 KiB each, and klogd copies the kernel's messages into
# it. Like every service of the stick, procd starts each again 2 s after it
# ends, and never gives up (onu-svc's default).
onu-svc start syslogd -- /sbin/syslogd -n -O /run/messages -s 64 || warn "no system log"
onu-svc start klogd -- /sbin/klogd -n || warn "the kernel's messages do not reach the system log"

# The flash is partitioned on its 4 KiB sectors (the device tree, and the
# option MTD_SPI_NOR_USE_4K_SECTORS of the kernel). On a chip or a kernel that
# erases larger blocks, the kernel makes the partitions that are not whole
# blocks read-only: the boot loader's environment, 8 KiB, and with it the
# bank switch, and the configuration store. Say so now, and not at the first
# save. /proc/mtd lists a partition's size, its erase size and its name.
erases_in_sectors() {
	grep -q '^mtd[0-9]*: [0-9a-f]* 00001000 "config"$' "${1:-/proc/mtd}"
}
erases_in_sectors ||
	warn "the flash does not erase in 4 KiB sectors: the configuration store and the updates will fail"

# The identity of the unit, its saved settings, its PPPoE accounts and root's
# password. onu-config load makes /config the JFFS2 file system of the
# partition "config", which the shipped firmware keeps its own files in, and
# reads this system's file there; a store of before that took the whole
# partition goes into that file first. The identity is the one of the shipped
# firmware's files, with what the store changed over it. omcid reads the
# identity, and the PON driver takes the serial number before the PON comes
# up. The file holds the PLOAM password, so only root may read it. Root's
# password goes to /run/shadow, which /etc/shadow names, for the console's
# login and the ssh server. The key of the panel's HTTPS and the ssh server's
# host key come from the store too, or are made now and kept there, the first
# time, once the kernel's random number generator is seeded (onu-config tls,
# onu-config ssh); so do an own certificate of the panel's and the public keys
# root logs in to ssh with, which a person gives through the panel (onu-config
# tls own, onu-config ssh-keys).
# pppoed, an account of its own, opens the PPP unit of each session through
# /dev/ppp, which belongs to its group.
[ ! -e /dev/ppp ] || { chown :pppoed /dev/ppp && chmod 660 /dev/ppp; } ||
	warn "pppoed cannot open /dev/ppp"
# omcid, an account of its own, writes everything it keeps in a directory of
# its own: its socket, the MIB, and the files that tell onu-apply what the OLT
# set up. onu-apply puts the identity it reads there.
mkdir -p /run/omcid && chown omcid:omcid /run/omcid && chmod 755 /run/omcid ||
	warn "no directory for omcid"
# dhcp6d, an account of its own, keeps the host's binding in a directory of
# its own, which load fills from the store.
mkdir -p /run/dhcp6d && chown dhcp6d:dhcp6d /run/dhcp6d && chmod 755 /run/dhcp6d ||
	warn "no directory for the binding of dhcp6d"
umask 077
onu-config load || warn "no identity in the configuration store or the factory configuration"
onu-config tls || warn "no key for HTTPS: the panel answers over HTTP"
onu-config ssh || warn "no ssh host key kept: the ssh server makes one of its own"
# A bench may name the versions that the software images and the circuit
# packs report to the OLT, so that a unit shows what the firmware it came
# with showed; without them omcid reports its own.
[ -n "${OMCI_SW_VERSION:-}" ] && echo "sw_version=$OMCI_SW_VERSION" >>/run/onu-identity
[ -n "${OMCI_PACK_VERSION:-}" ] && echo "pack_version=$OMCI_PACK_VERSION" >>/run/onu-identity
umask 022

# The stick's own settings that its owner changed (onu-config system): its
# name, and its management VLAN and address, which replace the image's.
# Each value is read as data, never run.
SYS_HOSTNAME=
SYS_LOG_SERVER=
BOARD_MGMT_VLAN=$MGMT_VLAN
BOARD_MGMT_ADDRESS=$MGMT_ADDRESS
if [ -r /run/onu-system ]; then
	SYS_HOSTNAME=$(sed -n 's/^HOSTNAME=//p' /run/onu-system)
	SYS_LOG_SERVER=$(sed -n 's/^LOG_SERVER=//p' /run/onu-system)
	value=$(sed -n 's/^MGMT_VLAN=//p' /run/onu-system)
	[ -n "$value" ] && MGMT_VLAN=$value
	value=$(sed -n 's/^MGMT_ADDRESS=//p' /run/onu-system)
	[ -n "$value" ] && MGMT_ADDRESS=$value
fi

hostname -F /etc/hostname
[ -n "$SYS_HOSTNAME" ] && { hostname "$SYS_HOSTNAME" || warn "the name $SYS_HOSTNAME was refused"; }

# The CPU port's interface, cpu, would otherwise take each frame that arrives
# alone with an interrupt of its own. Polling again, up to twice, 50 us apart,
# before its interrupt is enabled again takes the frames that arrive meanwhile
# in one pass: under a flood that the switch holds at its limit of 5000 frames
# a second, the CPU keeps about three quarters of its time instead of half.
echo 2 > /sys/class/net/cpu/napi_defer_hard_irqs &&
	echo 50000 > /sys/class/net/cpu/gro_flush_timeout ||
	warn "the CPU port takes an interrupt per frame"

# The stick keeps quiet towards the PON: it has no address there, and nothing
# of its own may leave by it. The PON port and the CPU port carry no IPv6, nor
# does any interface made from here on unless it is given IPv6 (the bridge and
# the GEM interfaces that omcid makes among them), so the stick sends no
# router solicitation, neighbour discovery or listener report of its own to
# the OLT and answers none from it. ARP answers only for an address of the
# interface it is asked on. The host side, sfp and mgmt, keeps IPv6.
echo 1 >/proc/sys/net/ipv6/conf/default/disable_ipv6 &&
	echo 1 >/proc/sys/net/ipv6/conf/cpu/disable_ipv6 &&
	echo 1 >/proc/sys/net/ipv6/conf/pon/disable_ipv6 ||
	warn "IPv6 stays on towards the PON: the stick can show itself there"
echo 1 >/proc/sys/net/ipv4/conf/all/arp_ignore &&
	echo 2 >/proc/sys/net/ipv4/conf/all/arp_announce ||
	warn "ARP answers for every address on every interface"
# On a link to the router the stick answers ARP for a session's gateway
# without taking the address (proxy ARP, onu-apply), at once rather than after
# the kernel's random wait of up to 0.8 s. The links netifd makes later take
# the default.
echo 0 >/proc/sys/net/ipv4/neigh/default/proxy_delay &&
	echo 0 >/proc/sys/net/ipv4/neigh/sfp/proxy_delay ||
	warn "proxy ARP answers late"
# The servers listen on their addresses whether or not an interface has them
# yet, so that one that comes later, or comes back, is served without a
# restart of the server, and a server that procd starts again does not fail
# while an address is away.
echo 1 >/proc/sys/net/ipv4/ip_nonlocal_bind &&
	echo 1 >/proc/sys/net/ipv6/ip_nonlocal_bind ||
	warn "a server does not listen on an address that comes later"
# What packets may hold of the stick's 24 MB while they wait. The kernel's
# limits suit a computer: 4 MB of fragments, kept up to 30 s for the rest of
# their packet, for IPv4, for IPv6 and for the connection tracking's IPv6, and
# 1000 frames in the queue a PPP session hands its frames on by. A session's
# flood of fragments, which the connection tracking of the local networks puts
# together, took the stick out of memory with them, and its daemons were
# killed (measured). Here 256 KB of fragments, kept 10 s, and 300 frames. A
# low threshold goes first: neither may pass the other.
for f in ipv4/ipfrag ipv6/ip6frag netfilter/nf_conntrack_frag6; do
	t=time
	[ "$f" = netfilter/nf_conntrack_frag6 ] && t=timeout
	echo 196608 >/proc/sys/net/${f}_low_thresh &&
		echo 262144 >/proc/sys/net/${f}_high_thresh &&
		echo 10 >/proc/sys/net/${f}_$t ||
		warn "fragments waiting for their packet may take ${f%%/*}'s 4 MB"
done
echo 300 >/proc/sys/net/core/netdev_max_backlog ||
	warn "a PPP session's frames may queue up to the kernel's limit"

# The MAC address the shipped firmware gave the host link, the one on the
# stick's label (ponid mac), on the switch's conduit and its two ports while
# they are down; the interfaces made on them later take it too. The boot
# loader leaves an address of its own, the same on every unit, which stays
# where the shipped firmware's files have none.
mac=$(ponid mac 2>/dev/null) &&
	for dev in cpu sfp pon; do
		onu-nl link set "$dev" address "$mac" ||
			warn "$dev keeps the boot loader's MAC address"
	done

# The setting of the SFP lane its owner kept (onu-lane), if any; the driver
# looks for the host's otherwise.
onu-lane apply || warn "the stored setting of the SFP lane was refused"

# The links. The stick's host side is the interface sfp. The conduit of the
# switch, cpu, which carries every port's traffic, the PON's too, is up before
# netifd starts: netifd brings a port's parent up with the port, and takes
# down only what it brought up.
onu-nl link set lo up
onu-nl link set cpu up || warn "the switch's conduit does not come up"
onu-nl link set sfp up || warn "no interface sfp"

# The management VLAN and its address, and the address on sfp itself. netifd
# brings them up, from the part "mgmt" of its configuration in /run/config,
# which onu-mgmt writes (onu-net) now and again when the pair changes. A
# stored pair that is not a VLAN and an address gives way to the image's.
# The ssh server can listen only once the addresses are there, and waits ten
# seconds for each. netifd alone sets them (ADR 0011), and procd starts it
# again if it ends; an address it does not bring up is in the log. Each
# interface that comes up or goes down, netifd tells onu-apply (its -h),
# which hands a PPPoE session's address on or takes it back. onu-mgmt start
# also has onu-apply put the guard of the stick's own programs in place
# (onu-apply guard, onu-fw guard), before any server starts: what comes in
# to the stick by any interface but the management VLAN's is dropped, but
# what one of its programs takes there.
onu-mgmt start "$MGMT_VLAN" "$MGMT_ADDRESS" "$DATA_ADDRESS" || {
	warn "VLAN $MGMT_VLAN with $MGMT_ADDRESS is not a pair, the image's instead"
	MGMT_VLAN=$BOARD_MGMT_VLAN
	MGMT_ADDRESS=$BOARD_MGMT_ADDRESS
	onu-mgmt start "$MGMT_VLAN" "$MGMT_ADDRESS" "$DATA_ADDRESS"
}
onu-svc start netifd -- /usr/sbin/netifd -c /run/config -r /run/resolv.conf.auto -h /usr/sbin/onu-apply || {
	warn "netifd is no service of procd: started once"
	netifd -c /run/config -r /run/resolv.conf.auto -h /usr/sbin/onu-apply &
}
onu-net wait mgmt "$MGMT_ADDRESS" 10 ||
	warn "netifd did not bring $MGMT_ADDRESS up in VLAN $MGMT_VLAN"
[ -z "$DATA_ADDRESS" ] || onu-net wait sfp "$DATA_ADDRESS" 10 ||
	warn "netifd did not bring $DATA_ADDRESS up on sfp"

# The system log goes to a server of the host side as well when the settings
# name one (LOG_SERVER), now that the management address is there to send
# from; the stick keeps its own copy. procd starts the log again with these
# arguments, which the boot's lacked.
if [ -n "$SYS_LOG_SERVER" ]; then
	onu-svc start syslogd -- /sbin/syslogd -n -O /run/messages -s 64 -L -R "$SYS_LOG_SERVER" ||
		warn "the system log stays on the stick"
fi

# The servers listen on the management addresses and nowhere else, and the
# guard drops what comes to them by any other interface than the management
# VLAN's (and the host link's to its own address there, a bench's): nothing
# on the PON side, nor a local network, is to reach them, in any mode.
# They start now that the addresses are there (onu-run): the ssh server, which
# takes the public keys of /run/dropbear/authorized_keys, those an image built
# with a bench's keys carries and those the store keeps (onu-config load),
# and root's password once it is not the default, unless its owner had it
# take keys alone, and the status daemon with its panel, where people
# sign in as root, with root's password, and scripts may present the token
# that a person made with onu-config token new, which the store keeps. One that
# procd starts again listens on the pair in use then (onu-mgmt).
data=${DATA_ADDRESS%/*}
mgmt=${MGMT_ADDRESS%/*}
onu-svc start ssh -- /usr/lib/onu/onu-run ssh || {
	warn "the ssh server is no service of procd: started once"
	onu-run ssh &
}
# A change on trial that no one kept goes back (ADR 0011): one keeper of the
# deadlines for the settings, the SFP lane and the management pair.
onu-svc start trials -- /usr/lib/onu/onu-change watch ||
	warn "a change on trial that no one keeps does not go back by itself"
# What the status daemon may ask of the stick, onu-act does as root on its
# behalf, and nothing else (ADR 0011): the status daemon does not run a
# program of the stick itself. It runs as the account pond, which no one
# logs in with, and ubusd's access list (/usr/share/acl.d/pond.json) lets it
# call onu-act and read the state of omcid, netifd and dhcp6d. Its directory
# of /run holds its log and its copy of the token of scripts, if a person made
# one (the store's, which root alone reads); the two copies of the boot
# loader's environment, which it shows, are its group's to read, and no other
# partition of the flash.
onu-svc start act -- /usr/lib/onu/onu-act || warn "the panel can change nothing"
mkdir -p /run/pond && chown pond:pond /run/pond && chmod 700 /run/pond
onu-config token install || warn "the token of scripts is not the status daemon's"
# The panel's key, and the own certificate when the store keeps one, for the
# status daemon alone to read (onu-config tls install, which a change through
# the panel does again). The daemon starts as root, binds its ports, 80 and
# 443, and runs as the account pond, keeping only the power to listen on a
# port below 1024 (pond -u).
onu-config tls install ||
	warn "the key of HTTPS is not the status daemon's: the panel answers over HTTP"
envs=$(sed -n 's,^\(mtd[0-9]*\):.* "env2*"$,/dev/\1,p' /proc/mtd)
[ -n "$envs" ] && chown :pond $envs && chmod 640 $envs ||
	warn "the status daemon does not read the boot loader's environment"
onu-svc start pond -- /usr/lib/onu/onu-run pond || warn "no status daemon"

# The time, which the stick has no clock of its own for: timed sets the clock
# and keeps it, through the host side alone, by NTP from the router at the
# other end of the management link or from the server the settings name
# (NTP_SERVER), by PTP from a master on the management link, or from the date
# the OLT gives (onu-run). Its directory, for the state it tells, is its
# account's.
mkdir -p /run/timed && chown ntp:ntp /run/timed && chmod 755 /run/timed ||
	warn "no directory for the time daemon's state"
onu-svc start time -l -- /usr/lib/onu/onu-run time || warn "the clock is not set"

# An ONU that the OLT disabled stays disabled, in O7 with its laser off, even
# after a power-off, until the OLT enables it (ITU-T G.984.3 clause 10.2.4 and
# clause 11.1.2). pon keep follows the state the kernel reports and keeps the
# disable in the configuration store, from which onu-apply identity gives it
# back to the PON driver before the PON comes up. It starts first, so that it
# hears the PON from its start.
onu-svc start pon -- /usr/sbin/pon keep ||
	warn "a disable by the OLT is not kept across a restart"

# The identity to the PON driver, which takes it before the PON comes up.
onu-apply identity || warn "the PON stays down"

# The data path as the settings shape it: onu-apply starts omcid, which
# answers the OLT and logs to /run/omcid.log, and what the settings ask for,
# the PPPoE sessions with their links to the host.
if [ -x /usr/sbin/omcid ]; then
	onu-apply start || warn "onu-apply did not start"
else
	warn "no omcid: nothing answers the OLT"
fi

# The bench waits for the last line on the console. Before it, the panel's
# address and the fingerprint of the certificate a browser is shown there,
# which no authority signed, or the own one, for a person to compare with the
# browser's.
{
	echo
	echo "open-dfp-34x-2c: the ODI DFP-34X-2C3, $(uname -sr), $(uname -m)"
	echo "open-dfp-34x-2c: ssh on $MGMT_ADDRESS (VLAN $MGMT_VLAN)${data:+ and $DATA_ADDRESS (sfp)}"
	[ -r /run/pond/tls.key ] && pond -k /run/pond/tls.key -c /run/pond/tls.own -F "$mgmt" |
		sed 's/^\([^ ]*\) SHA-256 \([^ ]*\) until \([^T]*\).*$/open-dfp-34x-2c: the panel on https:\/\/\1\/, certificate SHA-256 \2, valid until \3/'
	echo "open-dfp-34x-2c: ready"
} >/dev/console
