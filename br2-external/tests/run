"""Run the unit tests of br2-external.

Usage: tests/run [-v] [TEST...]

TEST names a module, class or method; without one every test_*.py in the
directories below tests/ runs: the post-image script, the boot script and the
defconfig (image/) and the comparison of the gate's findings with the list of
the known ones (toolchain/). The tests need Python 3.11 or later and a POSIX
shell. The ones that run mksquashfs and unsquashfs are skipped without them
(squashfs-tools on Debian). The checks that build and run programs with a
toolchain are the other scripts here, and run in the toolchain and image jobs.
"""
import os
import sys
import unittest

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
DIRECTORIES = ("image", "toolchain")


def main(argv):
    verbosity = 1
    names = []
    for arg in argv:
        if arg in ("-v", "--verbose"):
            verbosity = 2
        elif arg in ("-h", "--help"):
            sys.stdout.write(__doc__)
            return 0
        else:
            names.append(arg)
    for directory in DIRECTORIES:
        sys.path.insert(0, os.path.join(HERE, directory))
    loader = unittest.defaultTestLoader
    if names:
        suite = loader.loadTestsFromNames(names)
    else:
        suite = unittest.TestSuite(
            loader.discover(os.path.join(HERE, d), pattern="test_*.py",
                            top_level_dir=os.path.join(HERE, d)) for d in DIRECTORIES)
    result = unittest.TextTestRunner(verbosity=verbosity).run(suite)
    return 0 if result.wasSuccessful() else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
