"""check-applets: run the programs of the built image under qemu-mips.

Usage: check-applets TARGET_DIR [QEMU]

TARGET_DIR is the root filesystem as the build leaves it (build/image/target).
QEMU is the user-mode emulator (default qemu-mips). The programs are the board's
own, MIPS I, and run on the build machine through the emulator, with the image's
own dynamic loader and C library (qemu-mips -L TARGET_DIR), the C library as the
build cut it; no file of the machine is changed. The checks are:

* every command that a shell script of the image runs (the scripts are read by
  imagescripts.py, not run) is a function of its script, a builtin of the
  image's ash (asked with ``type``), a program of the tree or an applet that
  BusyBox lists, each of them found where the board's PATH looks; and the
  options that the scripts give to an applet are in its usage;
* BusyBox lists every applet that /etc/inittab names, and each applet that the
  scripts or the inittab use starts and prints its usage;
* BusyBox's own shell parses every script;
* a few applets do what they should (a shell evaluates arithmetic, text tools
  work on a pipe, ``uname`` names the architecture the image is for);
* dropbear and its key tool report their version and make a host key.

The programs are never given a task that would act on the machine: a mount,
a reboot or a network change is not run, only the usage of those applets.

Exit status: 0 when every check passed, 1 when one failed, 2 when the emulator or
the tree is missing.
"""

import os
import re
import shutil
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import imagescripts  # noqa: E402

BOARD = imagescripts.BOARD
FAILED = []
# Where the scripts' PATH looks, in the tree.
PATH = ("sbin", "usr/sbin", "bin", "usr/bin", "usr/lib/onu")
# The image is built without BusyBox's long usage, so a usage that reads
# "[OPTIONS]" lists none, and the options that a script gives are tried instead:
# the option alone, with no operand and nothing on the standard input, for these
# applets, which read and print and do nothing else. A BusyBox that does not
# take the option says "invalid option"; one that takes it asks for an argument
# or for an operand.
FILTERS = {"awk", "basename", "cat", "cryptpw", "cut", "dirname", "grep", "head", "hexdump", "id", "md5sum",
           "pidof", "readlink", "sed", "sort", "tail", "tr", "uname"}
# The options of the other applets, which this check does not run, that the usage
# does not list and that were read in BusyBox's own help: cp -R is -r, getty -L
# is a line without carrier detection, mount -t names the file system.
REVIEWED = {"cp": {"-R"}, "getty": {"-L"}, "mount": {"-t"}}


def report(ok, what, detail=""):
    print("%s %s%s" % ("pass" if ok else "FAIL", what, ": " + detail if detail and not ok else ""))
    if not ok:
        FAILED.append(what)


def resolve(target, path):
    """The file that a path of the board is, in the target tree, following links; None if there is none."""
    real = os.path.join(target, path.lstrip("/"))
    for _ in range(20):
        if not os.path.islink(real):
            break
        link = os.readlink(real)
        real = os.path.join(target, link.lstrip("/")) if link.startswith("/") \
            else os.path.join(os.path.dirname(real), link)
    return real if os.path.isfile(real) else None


def option_in(usage, option):
    """Whether the usage text of an applet names the option (a letter may be in a cluster: [-sfn])."""
    if option.startswith("--"):
        return option in usage
    return re.search(r"(?<![\w-])-[A-Za-z]*" + re.escape(option[1]), usage) is not None


def main(argv):
    if len(argv) not in (1, 2):
        sys.stderr.write(__doc__.split("\n\n")[0] + "\n")
        return 2
    target = argv[0]
    qemu = shutil.which(argv[1] if len(argv) == 2 else "qemu-mips")
    busybox = os.path.join(target, "bin", "busybox")
    if qemu is None:
        sys.stderr.write("check-applets: no qemu-mips (apt-get install qemu-user)\n")
        return 2
    if not os.path.isfile(busybox):
        sys.stderr.write("check-applets: no %s: is %s a target tree?\n" % (busybox, target))
        return 2

    def run(*args, stdin=None, timeout=120):
        done = subprocess.run([qemu, "-L", target, *args], input=stdin, capture_output=True,
                              text=True, timeout=timeout)
        return done.returncode, done.stdout, done.stderr

    status, out, err = run(busybox, "--list")
    applets = set(out.split())
    report(status == 0 and len(applets) > 20, "busybox --list names %d applets" % len(applets), err)

    found, unread = {}, []
    scripts = imagescripts.tree_scripts(target)
    report(len(scripts) >= 10, "the tree holds %d shell scripts" % len(scripts))
    for label, path in scripts:
        uses, lost = imagescripts.uses(label, imagescripts.read(path))
        found[label] = (path, uses)
        unread += ["%s:%d %s" % (label, line, word) for line, word in lost]
    report(not unread, "every command word of the scripts is one that can be read", " ".join(unread))

    names = sorted({use.name for _, uses in found.values() for use in uses if "/" not in use.spelled})
    status, out, err = run(busybox, "sh", "-c", 'for n; do type "$n"; done 2>&1', "sh", *names)
    builtins = set(re.findall(r"^(\S+) is a (?:special )?shell builtin$", out, re.M))
    report(status in (0, 1) and len(builtins) > 5, "the image's shell says which of the commands are its builtins",
           "status %d, %r" % (status, out[:80]))
    used, options = set(), {}
    for label, (path, uses) in sorted(found.items()):
        lost = []
        for use in uses:
            if "/" in use.spelled:
                if resolve(target, use.spelled) is None:
                    lost.append("%s (line %d)" % (use.spelled, use.line))
            elif use.name in builtins:
                continue
            else:
                where = [resolve(target, d + "/" + use.name) for d in PATH]
                where = [real for real in where if real]
                if not where:
                    lost.append("%s (line %d)" % (use.name, use.line))
                elif use.name in applets and os.path.basename(where[0]) == "busybox":
                    used.add(use.name)
                    options.setdefault(use.name, set()).update(use.options)
        report(not lost, "%s: every command is a function, a builtin, a program or an applet of the image"
               % label, "missing: " + " ".join(sorted(set(lost))))
    with open(os.path.join(BOARD, "overlay", "etc", "inittab"), encoding="utf-8") as handle:
        for line in handle:
            if line.strip() and not line.startswith("#"):
                match = re.match(r"^[^:]*:[^:]*:[^:]*:-?(/(?:bin|sbin|usr)/\S+)", line)
                if match:
                    report(resolve(target, match.group(1)) is not None,
                           "/etc/inittab names %s, which the image holds" % match.group(1))
                    if os.path.basename(match.group(1)) in applets:
                        used.add(os.path.basename(match.group(1)))
    used = sorted(used | {"reboot"})
    missing = [name for name in used if name not in applets]
    report(not missing, "busybox holds the applets the scripts and inittab run (%s)"
           % " ".join(used), "missing: " + " ".join(missing))

    usage = {}
    for name in used:
        status, out, err = run(busybox, name, "--help")
        usage[name] = out + err
        report("Usage:" in out + err and status in (0, 1), "%s --help starts and prints its usage"
               % name, "status %d, %r" % (status, (out + err)[:80]))
    lost, tried = [], 0
    for name, wanted in sorted(options.items()):
        for option in sorted(wanted):
            if option_in(usage.get(name, ""), option) or option in REVIEWED.get(name, ()):
                continue
            tried += 1
            if name in FILTERS:
                status, out, err = run(busybox, name, option, stdin="", timeout=20)
                if "invalid option" not in out + err:
                    continue
            lost.append("%s %s" % (name, option))
    report(not lost, "the options that the scripts give to applets are in their usage or taken by the applet "
           "(%d of %d tried)" % (tried - len(lost), tried), "not taken: " + ", ".join(lost))

    for label, (path, _) in sorted(found.items()):
        status, out, err = run(busybox, "sh", "-n", path)
        report(status == 0, "busybox sh parses /%s" % os.path.relpath(path, target), err)

    status, out, err = run(busybox, "sh", "-c", "echo $((6 * 7))")
    report(out.strip() == "42", "busybox sh evaluates arithmetic", out + err)
    status, out, err = run(busybox, "sed", "s/b/B/", stdin="abc\n")
    report(out.strip() == "aBc", "busybox sed edits a pipe", out + err)
    status, out, err = run(busybox, "awk", "BEGIN { print 1 + 1 }")
    report(out.strip() == "2", "busybox awk computes", out + err)
    status, out, err = run(busybox, "grep", "-c", "a", stdin="a\nb\na\n")
    report(out.strip() == "2", "busybox grep counts", out + err)
    status, out, err = run(busybox, "uname", "-m")
    report(status == 0 and out.strip().startswith("mips"), "busybox uname -m names the architecture",
           out + err)

    dropbear = os.path.join(target, "usr", "sbin", "dropbear")
    status, out, err = run(dropbear, "-V")
    report(re.search(r"Dropbear v\d", out + err) is not None, "dropbear -V reports its version",
           out + err)
    with tempfile.TemporaryDirectory() as tmp:
        key = os.path.join(tmp, "host_key")
        status, out, err = run(dropbear, "-V")  # the multi-call program is named by its link below
        tool = os.path.join(target, "usr", "bin", "dropbearkey")
        if os.path.islink(tool):
            # The link points at ../sbin/dropbear; the emulator needs the program and its name.
            status, out, err = run("-0", "dropbearkey", dropbear, "-t", "ed25519", "-f", key)
        else:
            status, out, err = run(tool, "-t", "ed25519", "-f", key)
        report(status == 0 and os.path.getsize(key) > 0, "dropbearkey makes an ed25519 host key",
               out + err)

    print("check-applets: %s" % ("every check passed" if not FAILED else
                                 "%d checks failed" % len(FAILED)))
    return 1 if FAILED else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
