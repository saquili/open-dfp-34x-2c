"""check-config: hold the final configuration of the kernel to what the product needs.

Usage: check-config [--required FILE] [--fragment FILE] CONFIG

CONFIG is the kernel's resolved .config: the file the build leaves after it
has merged the flash profile over rtl9602c_defconfig and let kbuild resolve
the dependencies (build/image/build/linux-custom/.config in the output
directory). Two things are asked of it, and both are asked of the resolved
file, not of the fragment, because kbuild has the last word: an option that
another option selects comes back whatever the fragment says, and an option
whose dependency is gone disappears whatever the fragment says.

* Every option of the list of required options is set to the value the list
  gives (required-options.txt next to this file; each line names an option,
  its value and the reason the product needs it). A value of n means the
  option must not be set.
* Every setting of the flash profile holds (board/dfp-34x-2c3/kernel-flash.fragment):
  an option the profile drops is not set, and an option it sets has the value
  it gives.

Exit status: 0 when both hold; 1 when something does not, after a line for
each; 2 when the check cannot be made: a file that cannot be read or is
malformed, a configuration with no options in it, an empty list, or a list and
a profile that contradict each other. A check that read nothing has proved
nothing, so none of these is a pass.
"""

import argparse
import os
import re
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
EXTERNAL = os.path.dirname(os.path.dirname(HERE))
DEFAULT_REQUIRED = os.path.join(HERE, "required-options.txt")
DEFAULT_FRAGMENT = os.path.join(EXTERNAL, "board", "dfp-34x-2c3", "kernel-flash.fragment")

NAME = r"CONFIG_[A-Za-z0-9_]+"
_SET = re.compile(r"^(%s)=(.*)$" % NAME)
_UNSET = re.compile(r"^# (%s) is not set$" % NAME)
_REQUIRED = re.compile(r"^(%s)=(\S+)\s+(\S.*)$" % NAME)


class Cannot(Exception):
    """The check cannot be made (exit status 2)."""


def lines_of(path, what):
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read().splitlines()
    except (OSError, UnicodeDecodeError) as exc:
        raise Cannot("cannot read the %s, %s: %s" % (what, path, getattr(exc, "strerror", None) or exc)) from exc


def read_config(path):
    """The options a kernel configuration sets, as {name: value}; an option not set is absent."""
    config = {}
    for line in lines_of(path, "configuration"):
        match = _SET.match(line)
        if match and match.group(2) != "n":
            config[match.group(1)] = match.group(2)
    if not config:
        raise Cannot("the configuration, %s, sets no option" % path)
    return config


def read_fragment(path):
    """The settings of a fragment, as [(name, value)] with None for an option that is not set."""
    settings = []
    for number, line in enumerate(lines_of(path, "flash profile"), 1):
        if not line.strip() or (line.startswith("#") and not _UNSET.match(line)):
            continue
        unset, setting = _UNSET.match(line), _SET.match(line)
        if unset:
            settings.append((unset.group(1), None))
        elif setting:
            settings.append((setting.group(1), None if setting.group(2) == "n" else setting.group(2)))
        else:
            raise Cannot("%s:%d: not a setting of a kernel configuration: %s" % (path, number, line))
    if not settings:
        raise Cannot("the flash profile, %s, has no setting" % path)
    return settings


def read_required(path):
    """The required options, as [(name, value, reason)] with None for an option that must not be set."""
    required = []
    for number, line in enumerate(lines_of(path, "list of required options"), 1):
        if not line.strip() or line.startswith("#"):
            continue
        match = _REQUIRED.match(line)
        if match is None:
            raise Cannot("%s:%d: expected 'CONFIG_NAME=VALUE reason', got: %s" % (path, number, line))
        name, value, reason = match.groups()
        if any(name == other for other, _, _ in required):
            raise Cannot("%s:%d: %s is listed twice" % (path, number, name))
        required.append((name, None if value == "n" else value, reason.strip()))
    if not required:
        raise Cannot("the list of required options, %s, is empty" % path)
    return required


def show(name, value):
    return "%s=%s" % (name, value) if value is not None else "%s not set" % name


def check(config, required, fragment):
    """The problems of a resolved configuration: a list of lines; empty when it is right."""
    dropped = {name: value for name, value in fragment}
    for name, value, _reason in required:
        if name in dropped and dropped[name] != value:
            raise Cannot("the list requires %s and the flash profile sets %s: they contradict each other"
                         % (show(name, value), show(name, dropped[name])))
    problems = []
    for name, value, reason in required:
        if config.get(name) != value:
            problems.append("required %s, found %s -- %s"
                            % (show(name, value), show(name, config.get(name)), reason))
    for name, value in fragment:
        if config.get(name) != value:
            who = "dropped" if value is None else "set"
            problems.append("%s by the flash profile: %s, found %s"
                            % (who, show(name, value), show(name, config.get(name))))
    return problems


def main(argv, out=None, err=None):
    out = out or sys.stdout
    err = err or sys.stderr
    parser = argparse.ArgumentParser(
        prog="check-config",
        description="Hold the kernel's final configuration to the required options and the flash profile.",
        epilog="Exit status: 0 holds; 1 does not; 2 the check cannot be made.")
    parser.add_argument("--required", metavar="FILE", default=DEFAULT_REQUIRED,
                        help="the list of required options (default: required-options.txt beside this file)")
    parser.add_argument("--fragment", metavar="FILE", default=DEFAULT_FRAGMENT,
                        help="the flash profile (default: board/dfp-34x-2c3/kernel-flash.fragment)")
    parser.add_argument("config", metavar="CONFIG", help="the kernel's resolved .config")
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        return 2 if exc.code else 0
    try:
        required = read_required(args.required)
        fragment = read_fragment(args.fragment)
        config = read_config(args.config)
        problems = check(config, required, fragment)
    except Cannot as problem:
        print("check-config: %s" % problem, file=err)
        return 2
    if problems:
        print("check-config: FAIL -- %d problems in %s" % (len(problems), args.config), file=err)
        for problem in problems:
            print("  " + problem, file=err)
        return 1
    print("check-config: ok -- %d required options are set and the %d settings of the flash profile hold (%s)"
          % (len(required), len(fragment), args.config), file=out)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
