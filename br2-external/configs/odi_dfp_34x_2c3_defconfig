#
# The ODI DFP-34X-2C3: the kernel and the root filesystem, built with the
# toolchain this file describes, as the two flash images k0.uImage and
# r0.squashfs. Running make in the top directory of the repository configures
# and builds it; docs/handbook/building.rst says how and what it makes.
#
# Every executable in the image is linked statically and the image holds no
# shared object. The shared libraries of this toolchain contain three
# functions with instructions that the core cannot run (br2-external/README.rst,
# "The instruction-set gate over the toolchain's own objects"), and no option
# leaves them out; a static program takes only the objects it refers to, and
# the instruction-set gate passes the whole target tree. docs/adr/0010 records
# the decision.

# MIPS I, big endian, soft-float: the Lexra core of the RTL9602C. The MIPS I
# variant comes from the patch in buildroot/patches.
BR2_mips=y
BR2_mips_1=y

# The toolchain: the same as configs/toolchain_defconfig, but with static
# libraries only. gcc 14 and binutils 2.44, and uClibc-ng with the C library
# configuration of this product. No threads: the core has no atomic operations.
# Wide characters, because the build system offers nftables only with them.
BR2_STATIC_LIBS=y
BR2_BINUTILS_VERSION_2_44_X=y
BR2_GCC_VERSION_14_X=y
BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_PTHREADS_NONE=y
BR2_TOOLCHAIN_BUILDROOT_USE_SSP=y
BR2_UCLIBC_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_OPEN_DFP_34X_2C_PATH)/board/dfp-34x-2c3/uclibc.fragment"
# The C library's utilities (getconf, ldd, ldconfig) are not part of the image.
# BR2_UCLIBC_INSTALL_UTILS is not set

# The kernel headers of the C library are those of this repository's kernel,
# from the archive that tools/kernel-archive makes of the committed linux/ tree.
BR2_KERNEL_HEADERS_CUSTOM_TARBALL=y
BR2_KERNEL_HEADERS_CUSTOM_TARBALL_LOCATION="file://$(OPEN_DFP_34X_2C_KERNEL_ARCHIVE)"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y

# The same output for the same inputs. The archive tools of the toolchain write
# no times or owners into the archives they make, so an archive does not change
# with the minute it was made.
BR2_REPRODUCIBLE=y
BR2_BINUTILS_EXTRA_CONFIG_OPTIONS="--enable-deterministic-archives"

# Programs are optimised for size, as the kernel is.
BR2_OPTIMIZE_S=y

# The kernel is the same tree, from the same archive, built with this
# toolchain. Its configuration is the board's own, rtl9602c_defconfig, and its
# image the one the boot loader takes: a legacy U-Boot image, LZMA-compressed,
# loaded at the address the kernel's platform file gives.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="file://$(OPEN_DFP_34X_2C_KERNEL_ARCHIVE)"
BR2_LINUX_KERNEL_DEFCONFIG="rtl9602c"
BR2_LINUX_KERNEL_UIMAGE=y
BR2_LINUX_KERNEL_LZMA=y

# The root filesystem: BusyBox, dropbear and the files of the overlay. The
# build system installs no init scripts; BusyBox init and the boot script are in
# the overlay. The files of one bench (an ssh key, other addresses), which do
# not belong to the repository, are laid over the image by the post-image script
# when OPEN_DFP_34X_2C_LOCAL_OVERLAY names a directory of them. The post-build
# script writes the commit the image is built from into /etc/os-release.
BR2_INIT_NONE=y
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_TARGET_GENERIC_HOSTNAME="dfp-34x-2c3"
BR2_TARGET_GENERIC_ISSUE="open-dfp-34x-2c on the ODI DFP-34X-2C3"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OPEN_DFP_34X_2C_PATH)/board/dfp-34x-2c3/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_OPEN_DFP_34X_2C_PATH)/board/dfp-34x-2c3/post-build.sh"
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_OPEN_DFP_34X_2C_PATH)/board/dfp-34x-2c3/busybox.config"
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y

# The images. The post-image script makes the root filesystem image and names
# both, so the build system makes no root filesystem image of its own; the tool
# it uses, mksquashfs, is built for the build machine.
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_SQUASHFS=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_OPEN_DFP_34X_2C_PATH)/board/dfp-34x-2c3/post-image.sh"

# The programs of the ONU: the OMCI daemon, the reader of the unit's identity,
# the PPPoE client and the status daemon of this tree; ip, tc and devlink;
# ethtool, for the counters of the switch's ports; nft, for the packet filter
# that the boot script loads.
BR2_PACKAGE_OMCID=y
BR2_PACKAGE_ONU_UTILS=y
BR2_PACKAGE_PPPOED=y
BR2_PACKAGE_POND=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_LIBMNL=y
