#
# The cross toolchain and nothing else: no kernel, no root filesystem. Running
# make sdk in the Buildroot tree builds it and packs it as a relocatable
# tarball, which a release of the toolchain workflow carries. See
# br2-external/README.rst.

# MIPS I, big endian, soft-float: the Lexra core of the RTL9602C, which also
# runs ll, sc and sync, so atomic operations are ll/sc sequences. The MIPS I
# variant comes from the patch in buildroot/patches.
BR2_mips=y
BR2_mips_1=y

# gcc 14 and binutils 2.44, and uClibc-ng with its C library configuration of
# this product. No threads: the core has no thread pointer for thread-local
# storage. Wide characters, which nftables needs.
BR2_BINUTILS_VERSION_2_44_X=y
BR2_GCC_VERSION_14_X=y
BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_PTHREADS_NONE=y
BR2_TOOLCHAIN_BUILDROOT_USE_SSP=y
BR2_UCLIBC_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_OPEN_DFP_34X_2C_PATH)/board/dfp-34x-2c3/uclibc.fragment"
# No ldd or getconf for the target: the board's image has neither, and an
# image built with this toolchain would take them from its sysroot.
# BR2_UCLIBC_INSTALL_UTILS is not set

# The C library and libgcc are built with the flags of the board's programs
# (odi_dfp_34x_2c3_defconfig): for size, not position-independent, with partial
# RELRO. The board's image takes them from this toolchain when it is built with
# the toolchain of a release (br2-external/toolchain/PIN), so they are the ones
# the board's own build of the toolchain makes.
BR2_OPTIMIZE_S=y
# BR2_PIC_PIE is not set
BR2_RELRO_PARTIAL=y


# The kernel headers are those of this repository's kernel (linux/), from the
# archive that tools/kernel-archive makes.
BR2_KERNEL_HEADERS_CUSTOM_TARBALL=y
BR2_KERNEL_HEADERS_CUSTOM_TARBALL_LOCATION="file://$(OPEN_DFP_34X_2C_KERNEL_ARCHIVE)"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y

# The same output for the same inputs. The archive tools of the toolchain write
# no times or owners into the archives they make, so an archive does not change
# with the minute it was made.
BR2_REPRODUCIBLE=y
BR2_BINUTILS_EXTRA_CONFIG_OPTIONS="--enable-deterministic-archives"

# Nothing for the target: no BusyBox, no init system, no root filesystem image.
# BR2_PACKAGE_BUSYBOX is not set
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_ROOTFS_TAR is not set
