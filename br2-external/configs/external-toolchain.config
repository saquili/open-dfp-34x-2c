#
# Merged over odi_dfp_34x_2c3_defconfig by the top-level Makefile when the
# image is built with the toolchain of a release (br2-external/toolchain/PIN)
# instead of one of its own: the relocatable tarball that "make sdk" packs for
# configs/toolchain_defconfig, unpacked and relocated into
# OPEN_DFP_34X_2C_TOOLCHAIN. It is the toolchain the
# board's defconfig would build: gcc 14, uClibc-ng with the board's
# configuration, wide characters, no threads, the stack protector, and the C
# library and libgcc built with the board's flags. external.mk installs the
# uapi headers of this commit's linux/ over the toolchain's.
# BR2_TOOLCHAIN_BUILDROOT is not set
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(OPEN_DFP_34X_2C_TOOLCHAIN)"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="$(ARCH)-buildroot-linux-uclibc"
BR2_TOOLCHAIN_EXTERNAL_GCC_14=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_12=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_UCLIBC=y
BR2_TOOLCHAIN_EXTERNAL_WCHAR=y
# BR2_TOOLCHAIN_EXTERNAL_LOCALE is not set
# BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS is not set
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP_STRONG=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
# BR2_TOOLCHAIN_EXTERNAL_CXX is not set
