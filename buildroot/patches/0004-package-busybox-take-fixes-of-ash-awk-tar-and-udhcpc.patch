@@ -0,0 +1,43 @@
+From: Denys Vlasenko <vda.linux@googlemail.com>
+Date: Mon, 21 Sep 2026 12:15:19 +0200
+Subject: [PATCH] udhcpc: ensure packet.data.cookie exists before we access
+ it
+
+function                                             old     new   delta
+d4_recv_raw_packet                                   497     500      +3
+
+Signed-off-by: Denys Vlasenko <vda.linux@googlemail.com>
+
+Upstream: https://github.com/vda-linux/busybox_mirror/commit/fd1972099f28636b5deea200022b528f3a0bd523
+Signed-off-by: Paweł Phan <szop.hektar_1w@icloud.com>
+---
+ networking/udhcp/dhcpc.c | 9 +++++++--
+ 1 file changed, 7 insertions(+), 2 deletions(-)
+
+diff --git a/networking/udhcp/dhcpc.c b/networking/udhcp/dhcpc.c
+index e44086c..936687e 100644
+--- a/networking/udhcp/dhcpc.c
++++ b/networking/udhcp/dhcpc.c
+@@ -900,7 +900,12 @@ static NOINLINE int d4_recv_raw_packet(struct dhcp_packet *dhcp_pkt, int fd)
+ 		break;
+ 	}
+ 
+-	if (bytes < (int) (sizeof(packet.ip) + sizeof(packet.udp))) {
++	if (bytes < (int) (
++			sizeof(packet.ip) + sizeof(packet.udp)
++			+ offsetof(struct dhcp_packet, options)
++			/* DHCP requires option 255 is always present, IOW: at least one byte in options[]: */
++			+ 1
++	)) {
+ 		log1s("packet is too short, ignoring");
+ 		return -2;
+ 	}
+@@ -954,7 +959,7 @@ static NOINLINE int d4_recv_raw_packet(struct dhcp_packet *dhcp_pkt, int fd)
+ 	packet.ip.tot_len = packet.udp.len; /* yes, this is needed */
+ 	check = packet.udp.check;
+ 	packet.udp.check = 0;
+-	if (check && check != inet_cksum(&packet, bytes)) {
++	if (check != 0 && check != inet_cksum(&packet, bytes)) {
+ 		log1s("packet with bad UDP checksum, ignoring");
+ 		return -2;
+ 	}
diff --git a/package/busybox/0025-udhcpc-6-check-minimum-packet-size-after-reducing-it.patch b/package/busybox/0025-udhcpc-6-check-minimum-packet-size-after-reducing-it.patch
new file mode 100644
index 00000000..dec384a3
--- /dev/null
+++ b/package/busybox/0025-udhcpc-6-check-minimum-packet-size-after-reducing-it.patch
@@ -0,0 +1,92 @@
+From: Denys Vlasenko <vda.linux@googlemail.com>
+Date: Sat, 7 Nov 2026 14:05:35 +0100
+Subject: [PATCH] udhcpc[6]: check minimum packet size after reducing it to
+ ip.tot_len
+
+For DHCPv6, also require that all fields up until option array exist in the packet.
+I did not find a definitive info that DHCPv6 requires at least one option
+to be present, and the code appears to handle empty option array correctly.
+
+function                                             old     new   delta
+d6_recv_raw_packet                                   228     230      +2
+d4_recv_raw_packet                                   500     501      +1
+------------------------------------------------------------------------------
+(add/remove: 0/0 grow/shrink: 2/0 up/down: 3/0)                 Total: 3 bytes
+
+Signed-off-by: Denys Vlasenko <vda.linux@googlemail.com>
+
+Upstream: https://github.com/vda-linux/busybox_mirror/commit/56e9d36bb64fe508b4d5b9fb01f02bdee6dba792
+Signed-off-by: Paweł Phan <szop.hektar_1w@icloud.com>
+---
+ networking/udhcp/d6_dhcpc.c | 14 +++++++++-----
+ networking/udhcp/dhcpc.c    | 18 +++++++++---------
+ 2 files changed, 18 insertions(+), 14 deletions(-)
+
+diff --git a/networking/udhcp/d6_dhcpc.c b/networking/udhcp/d6_dhcpc.c
+index 1851cee..76d0924 100644
+--- a/networking/udhcp/d6_dhcpc.c
++++ b/networking/udhcp/d6_dhcpc.c
+@@ -919,11 +919,6 @@ static NOINLINE int d6_recv_raw_packet(struct in6_addr *peer_ipv6, struct d6_pac
+ 		return bytes; /* returns -1 */
+ 	}
+ 
+-	if (bytes < (int) (sizeof(packet.ip6) + sizeof(packet.udp))) {
+-		log1s("packet is too short, ignoring");
+-		return -2;
+-	}
+-
+ 	if (bytes < sizeof(packet.ip6) + ntohs(packet.ip6.ip6_plen)) {
+ 		/* packet is bigger than sizeof(packet), we did partial read */
+ 		log1s("oversized packet, ignoring");
+@@ -933,6 +928,15 @@ static NOINLINE int d6_recv_raw_packet(struct in6_addr *peer_ipv6, struct d6_pac
+ 	/* ignore any extra garbage bytes */
+ 	bytes = sizeof(packet.ip6) + ntohs(packet.ip6.ip6_plen);
+ 
++	if (bytes < (int) (
++			sizeof(packet.ip6) + sizeof(packet.udp)
++			+ offsetof(struct d6_packet, d6_options)
++			/* + 4 - does DHCPv6 require that at least one option is present? */
++	)) {
++		log1s("packet is too short, ignoring");
++		return -2;
++	}
++
+ 	/* make sure its the right packet for us, and that it passes sanity checks */
+ 	if (packet.ip6.ip6_nxt != IPPROTO_UDP
+ 	 || (packet.ip6.ip6_vfc >> 4) != 6
+diff --git a/networking/udhcp/dhcpc.c b/networking/udhcp/dhcpc.c
+index 936687e..f0d352f 100644
+--- a/networking/udhcp/dhcpc.c
++++ b/networking/udhcp/dhcpc.c
+@@ -900,6 +900,15 @@ static NOINLINE int d4_recv_raw_packet(struct dhcp_packet *dhcp_pkt, int fd)
+ 		break;
+ 	}
+ 
++	if (bytes < ntohs(packet.ip.tot_len)) {
++		/* packet is bigger than sizeof(packet), we did partial read */
++		log1s("oversized packet, ignoring");
++		return -2;
++	}
++
++	/* ignore any extra garbage bytes */
++	bytes = ntohs(packet.ip.tot_len);
++
+ 	if (bytes < (int) (
+ 			sizeof(packet.ip) + sizeof(packet.udp)
+ 			+ offsetof(struct dhcp_packet, options)
+@@ -910,15 +919,6 @@ static NOINLINE int d4_recv_raw_packet(struct dhcp_packet *dhcp_pkt, int fd)
+ 		return -2;
+ 	}
+ 
+-	if (bytes < ntohs(packet.ip.tot_len)) {
+-		/* packet is bigger than sizeof(packet), we did partial read */
+-		log1s("oversized packet, ignoring");
+-		return -2;
+-	}
+-
+-	/* ignore any extra garbage bytes */
+-	bytes = ntohs(packet.ip.tot_len);
+-
+ 	/* make sure its the right packet for us, and that it passes sanity checks */
+ 	if (packet.ip.protocol != IPPROTO_UDP
+ 	 || packet.ip.version != IPVERSION
