// SPDX-License-Identifier: GPL-2.0-only
/*
 * ODI DFP-34X-2C3: a GPON ONU in an SFP module, built on the Realtek
 * RTL9602C with 32 MiB of DRAM and 8 MiB of SPI NOR flash. Its only
 * electrical data interface is the SFP edge connector, wired to the switch's
 * SerDes lane (port 0). The GPON MAC drives a separate laser driver IC,
 * which the SoC also reaches over I2C.
 */

/dts-v1/;

#include "rtl9602c.dtsi"

/ {
	model = "ODI DFP-34X-2C3";
	compatible = "odi,dfp-34x-2c3", "realtek,rtl9602c";

	/* The platform code adds the same range to memblock itself. */
	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x02000000>;
	};

	/*
	 * The PON MAC's packet-buffer areas in DRAM, one per direction. The
	 * PON MAC reads and writes them by DMA and the CPU never touches them,
	 * so no-map keeps them out of the kernel's memory. Each is 1 MiB and
	 * 4 KiB, of which the driver programs the first 1 MiB; whether the PON
	 * MAC touches the 4 KiB beyond is not verified, so they are kept
	 * reserved too. The upstream area ends at the top of DRAM and the
	 * downstream area 8 MiB lower, in another quarter of DRAM; whether
	 * that placement matters is not verified either.
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		pbo_ds: pbo@16ff000 {
			reg = <0x016ff000 0x101000>;
			no-map;
		};

		pbo_us: pbo@1eff000 {
			reg = <0x01eff000 0x101000>;
			no-map;
		};
	};

	chosen {
		/*
		 * Taken to have no effect, which is not verified: no driver
		 * binds uart0, no earlycon argument is passed, and the boot
		 * loader's console= argument selects the console.
		 */
		stdout-path = &uart0;

		/*
		 * rtl9602c_defconfig sets MIPS_CMDLINE_DTB_EXTEND: the kernel
		 * command line is these arguments, then the boot loader's.
		 * panic=10 reboots the board 10 s after a panic.
		 */
		bootargs = "panic=10";
	};
};

/*
 * The 8 MiB SPI NOR flash, through the SoC's SPI controller, which can
 * erase and program it. The SoC's read-only window onto the same chip at
 * 0x14000000 is left unused: the two must not drive the chip at once.
 */
&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;

		/*
		 * The boot loader's own layout, which covers the whole chip,
		 * except that both banks are split as this system needs: a
		 * kernel takes 1856 KiB and a root filesystem 1984 KiB, where
		 * the shipped firmware split the same 3840 KiB as 1328 KiB and
		 * 2512 KiB. The boot loader keeps naming the shipped split in
		 * its environment, which it rebuilds at every start, and needs
		 * nothing of this one: it starts the kernel at the start of k0
		 * or k1, the same in both, and root=31:5 or root=31:7 names
		 * r0 or r1 by number.
		 *
		 * The partitions register in this order as mtd0 to mtd7,
		 * block devices 31:0 to 31:7, and the boot loader names the
		 * root filesystem by number (root=31:5 for bank 0, root=31:7
		 * for bank 1): the order is part of the boot contract.
		 *
		 * The boot loader is read-only. Its environment, where this
		 * system says which bank to start, the configuration store and
		 * both banks are writable: an update goes into the bank the
		 * system did not start from, which the updater, onu-update,
		 * tells by root= and never writes. The chip erases in 4 KiB
		 * sectors, and every partition starts and ends on one.
		 */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* The boot loader, run from the reset vector */
			partition@0 {
				label = "boot";
				reg = <0x000000 0x040000>;
				read-only;
			};

			/* The boot loader's environment and its copy */
			partition@40000 {
				label = "env";
				reg = <0x040000 0x002000>;
			};

			partition@42000 {
				label = "env2";
				reg = <0x042000 0x002000>;
			};

			/*
			 * The configuration store: what the board keeps across
			 * updates of its system.
			 */
			partition@44000 {
				label = "config";
				reg = <0x044000 0x03c000>;
			};

			/* Bank 0: a kernel and its root filesystem */
			partition@80000 {
				label = "k0";
				reg = <0x080000 0x1d0000>;
			};

			partition@250000 {
				label = "r0";
				reg = <0x250000 0x1f0000>;
			};

			/* Bank 1: the same, the other system */
			partition@440000 {
				label = "k1";
				reg = <0x440000 0x1d0000>;
			};

			partition@610000 {
				label = "r1";
				reg = <0x610000 0x1f0000>;
			};
		};
	};
};

/*
 * The switch finds the packet-buffer areas by name and needs each to be at
 * least 1 MiB. Without both of them, or without realtek,sysctl, it is meant
 * to work as a switch with the PON MAC off; not verified.
 */
&switch {
	memory-region = <&pbo_us>, <&pbo_ds>;
	memory-region-names = "pbo-us", "pbo-ds";

	/* The GPON MAC drives the optics' laser driver. */
	realtek,pon-optics = <&laser>;
};

/*
 * The optics' laser driver, which serves the SFF-8472 management interface,
 * A0h at 0x50 and A2h at 0x51. Its hard transmit-disable input is GPIO 13,
 * high turning the light off (measured); its driver requests it asserted and
 * the GPON MAC releases it only while the PON link needs the laser.
 */
&switch_i2c {
	laser: laser-driver@50 {
		compatible = "semtech,gn25l95";
		reg = <0x50>;
		tx-disable-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
	};
};
