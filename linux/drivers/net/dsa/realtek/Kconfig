menuconfig NET_DSA_REALTEK
	tristate "Realtek Ethernet switch family support"
	depends on NET_DSA
	select FIXED_PHY
	select IRQ_DOMAIN
	select REALTEK_PHY
	select REGMAP
	help
	  Select to enable support for Realtek Ethernet switch chips.

	  Note that at least one interface driver must be enabled for the
	  subdrivers to be loaded. Moreover, an interface driver cannot achieve
	  anything without at least one subdriver enabled.

if NET_DSA_REALTEK

config NET_DSA_REALTEK_MDIO
	bool "Realtek MDIO interface support"
	depends on OF
	help
	  Select to enable support for registering switches configured
	  through MDIO.

config NET_DSA_REALTEK_SMI
	bool "Realtek SMI interface support"
	depends on OF
	help
	  Select to enable support for registering switches connected
	  through SMI.

config NET_DSA_REALTEK_RTL8365MB
	tristate "Realtek RTL8365MB switch driver"
	depends on NET_DSA_REALTEK_SMI || NET_DSA_REALTEK_MDIO
	select NET_DSA_TAG_RTL8_4
	help
	  Select to enable support for Realtek RTL8365MB-VC and RTL8367S.

config NET_DSA_REALTEK_RTL8366RB
	tristate "Realtek RTL8366RB switch driver"
	depends on NET_DSA_REALTEK_SMI || NET_DSA_REALTEK_MDIO
	select NET_DSA_TAG_RTL4_A
	help
	  Select to enable support for Realtek RTL8366RB.

config NET_DSA_REALTEK_RTL8366RB_LEDS
	bool
	depends on (LEDS_CLASS=y || LEDS_CLASS=NET_DSA_REALTEK_RTL8366RB)
	depends on NET_DSA_REALTEK_RTL8366RB
	default NET_DSA_REALTEK_RTL8366RB

endif

config RTL9602C_OPTICS_RO
	bool "RTL9602C: never write to the optics part"
	depends on NET_DSA_RTL9602C
	help
	  At every bring-up of the PON, the driver of the optics' laser
	  driver (PON_GN25L95) puts back the configuration the module loads
	  at power-up: its automatic extinction-ratio loop on, and the power
	  set point it found at its first bring-up. When the OLT asks for a
	  lower transmit power level, it lowers that set point, and it puts
	  the module's own level back at an orderly restart. These changes
	  are made so that the module does not store them: they last until
	  the module loses power.
	  To make them the driver shows the laser driver's configuration
	  table through A2h byte 127, the page select, which the module keeps
	  across a power cycle: it writes the byte only when it holds another
	  page, and writes it back as it was found. The adapter of the optics'
	  I2C master, which I2C_RTL9602C registers, passes those writes on
	  only for a module the switch driver has identified as one the laser
	  driver's code was measured on.

	  With this option the adapter refuses every write, from the laser
	  driver and from userspace through i2c-dev alike, so that nothing on
	  the board can change the module: no transmit power level, and the
	  "tables" debugfs view, which writes the page select, shows only the
	  table selected. The diagnostics read through hwmon and the debugfs
	  views that only read stay as they are.

	  Say Y for an image that must leave the module as it was found. A
	  loop turned off, or a lower set point left, by an earlier kernel
	  then stays so until the module loses power. If unsure, say N.

config NET_DSA_RTL9602C
	tristate "Realtek RTL9602C switch"
	depends on NET_DSA
	depends on HAS_IOMEM
	depends on I2C
	depends on PTP_1588_CLOCK_OPTIONAL
	depends on RTL9602C_ETH || !RTL9602C_ETH
	select AUXILIARY_BUS
	select MFD_SYSCON
	select NET_DSA_TAG_RTL9602C
	imply I2C_RTL9602C
	imply PON_RTL9602C
	help
	  DSA driver for the Ethernet switch of Realtek RTL9602C SoCs, the
	  chip of GPON ONUs such as SFP sticks. The switch has a SerDes port
	  to the host, the PON port and the CPU port, whose conduit is the
	  RTL9602C_ETH driver. Besides the switch itself (bridging, VLANs, the
	  address table, ACL and classifier rules, QoS, storm control and
	  L3/NAT offload). It also registers the switch's IEEE 1588 clock,
	  and decides whether the optics may be written, whose I2C master
	  has a driver of its own, I2C_RTL9602C, and their laser driver
	  another, such as PON_GN25L95. The chip's GPON MAC, with the PON
	  class's ONU, its OMCI channel and a network interface per GEM port,
	  has a driver of its own too, PON_RTL9602C, which this driver makes a
	  device for.

	  Say Y or M on an RTL9602C board. To compile this driver as a module,
	  choose M here: the module will be called rtl9602c.

config NET_DSA_RTL9602C_KUNIT_TEST
	bool "KUnit tests of the Realtek RTL9602C switch driver" if !KUNIT_ALL_TESTS
	depends on NET_DSA_RTL9602C && KUNIT=y
	default KUNIT_ALL_TESTS
	help
	  Build the KUnit tests of the driver's pure functions, the NAPT
	  hashes and the fields of the L3/NAT engine's table entries, into
	  the driver. They run when the driver is loaded.

	  If unsure, say N.
