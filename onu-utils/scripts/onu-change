#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Paweł Phan <szop.hektar_1w@icloud.com>
#
# onu-change: the changes on trial (ADR 0014), whichever program made them:
# the settings (onu-apply try), the setting of the SFP lane (onu-lane try)
# and the management pair (onu-mgmt add). Each is a file of /run/onu-trial.d
# named for it, with the moment it goes back, UNTIL, in seconds of
# /proc/uptime. The program that made a change keeps it or takes it back,
# and the keeper of the deadlines (watch), one for all of them, takes it back
# when no one kept it in time.
#
#   onu-change status        a line for each change on trial: its name, when
#                            it goes back and, for the management pair, the
#                            new address, which alone may confirm it
#   onu-change confirm [IP]  keep every change on trial; the management
#                            pair's only when IP, the address the
#                            confirmation came to, is its new one; exit 3
#                            when none was on trial, as when it came after
#                            the changes went back
#   onu-change revert        take every change on trial back now
#   onu-change expire        take back every change on trial whose time has
#                            come, once
#   onu-change watch         the keeper of the deadlines: expire, then wait
#                            for the nearest deadline, for ever; a service of
#                            procd, which starts it again if it ends
#
# The status daemon confirms them for the panel, which does so as soon as it
# reaches the stick again. ONU_ROOT, when set, is put in front of /run, for
# the tests.

set -u
ROOT=${ONU_ROOT:-}
DIR=$ROOT/run/onu-trial.d
# The longest the keeper waits when no deadline is nearer: a change that
# starts meanwhile is seen then, and its deadline is minutes away.
IDLE=${KEEPER_IDLE:-5}
# onu-lane and onu-mgmt are helpers out of a person's way (ADR 0015).
PATH=$PATH:$ROOT/usr/lib/onu

log() {
	echo "onu-change: $*" >&2
	logger -t onu-change "$*" 2>/dev/null
	return 0
}

field() {
	sed -n "s/^$1=//p" "$2" 2>/dev/null | head -n 1
}

# The program of the change $1 and its verbs to keep it and to take it back.
verbs() {
	case $1 in
	settings) echo "onu-apply confirm revert" ;;
	lane) echo "onu-lane keep revert" ;;
	mgmt) echo "onu-mgmt commit cancel" ;;
	*) return 1 ;;
	esac
}

status() {
	for f in "$DIR"/*; do
		[ -f "$f" ] || continue
		name=${f##*/}
		verbs "$name" >/dev/null || continue
		line="$name $(field UNTIL "$f")"
		[ "$name" = mgmt ] && line="$line $(field ADDRESS "$f")"
		echo "$line"
	done
}

# Each change on trial kept ($1 keep) or taken back ($1 back); the management
# pair kept only when the confirmation came to its new address, $2.
each() {
	act=$1
	from=${2:-}
	rc=0
	any=
	for f in "$DIR"/*; do
		[ -f "$f" ] || continue
		name=${f##*/}
		v=$(verbs "$name") || continue
		any=1
		prog=${v%% *}
		v=${v#* }
		if [ "$act" = keep ]; then
			if [ "$name" = mgmt ] &&
				[ "$from" != "$(field ADDRESS "$f" | cut -d/ -f1)" ]; then
				log "the management pair waits for a confirmation from its new address"
				continue
			fi
			"$prog" "${v%% *}" || rc=1
		else
			"$prog" "${v#* }" || rc=1
		fi
	done
	if [ "$act" = keep ] && [ -z "$any" ]; then
		log "nothing is on trial: a change not kept in time went back"
		return 3
	fi
	return $rc
}

# The changes whose time has come taken back, each by the program that made
# it, with its token, so that a change started again since is left alone. WAIT
# is left as the seconds to the nearest deadline ahead, at most IDLE.
due() {
	read -r up _ <"$ROOT/proc/uptime" 2>/dev/null || up=0
	now=${up%%.*}
	WAIT=$IDLE
	for f in "$DIR"/*; do
		[ -f "$f" ] || continue
		name=${f##*/}
		v=$(verbs "$name") || continue
		end=$(field UNTIL "$f")
		case $end in "" | *[!0-9]*) continue ;; esac
		left=$((end - now))
		if [ "$left" -gt 0 ]; then
			[ "$left" -lt "$WAIT" ] && WAIT=$left
			continue
		fi
		log "the change $name was not kept in time"
		"${v%% *}" expire "$(field TOKEN "$f")" ||
			log "the change $name was not taken back: tried again"
	done
}

watch() {
	while :; do
		due
		sleep "$WAIT"
	done
}

case ${1:-} in
status) status ;;
confirm) each keep "${2:-}" ;;
revert) each back ;;
expire) due ;;
watch) watch ;;
*)
	echo "usage: onu-change status|confirm [IP]|revert|expire|watch" >&2
	exit 2
	;;
esac
