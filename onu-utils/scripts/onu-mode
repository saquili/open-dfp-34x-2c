#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Paweł Phan <szop.hektar_1w@icloud.com>
#
# onu-mode: put the stick's data path in the shape its settings give: the
# OLT's bridge, or the stick's own PPPoE sessions with their addresses handed
# on, or, on a bench, a router.
#
#   onu-mode start    at boot: take the settings from /etc/onu.conf and apply
#   onu-mode apply    apply the settings of /run/onu.conf again, after a change,
#                     and keep them in the configuration store (onu-store)
#   onu-mode stop     stop omcid and take the router down
#   onu-mode identity give the PON driver the serial number and PLOAM
#                     password of /run/onu-identity and bring the PON up
#   onu-mode reidentify  take the PON down, give it the identity of
#                     /run/onu-identity, and register with the OLT again
#   onu-mode status   the shape in force, the WAN or the sessions, and the
#                     address handed on
#
# The settings are KEY=value lines in /run/onu.conf, which the status daemon
# rewrites; /etc/onu.conf has the defaults and says what each key means. The
# account of PPPoE session N, 1 to 7, is in /run/onu-pppoeN, as "user
# secret", readable by root only; /etc/onu-pppoe, if a bench's files carry
# one, seeds the first. At boot, onu-store has put the saved ones in these
# files before onu-mode starts.
#
# There is no mode to choose. Without a PPPoE account, omcid connects the host
# link to the PON as the OLT provisions it (bridge). With one or more, the
# stick holds the sessions itself (passthrough), and each session runs on a
# GEM port that the OLT provisioned, or on a VLAN on it, with the settings
# SESSIONn_GEM, SESSIONn_VLAN, SESSIONn_MAC and SESSIONn_FAMILY (ipv4, ipv6
# or both), and hands its address down to the host or keeps it on the stick,
# SESSIONn_PASS (on or off), in the VLAN of the host link SESSIONn_HOST_VLAN
# names (nothing for the session's own VLAN, untagged for none). Beside sessions in VLANs omcid still bridges the rest of what the
# OLT provisions, such as television and telephone, and leaves out the
# sessions' VLANs, which it reads from /run/onu-held-vlans. A session's VLAN
# may be the subscriber's VID of a translation the OLT provisions, the VID a
# router behind the stick would use: the session then runs in the VID it
# leads into, as omcid publishes it (/run/omcid-xlate), and a session whose
# GEM port is auto runs on the GEM port that the OLT lets that VID through
# (/run/omcid-gem-vlans): the session follows its service when the OLT
# moves it to another VID or another GEM port. Beside a session
# untagged on its GEM port, which holds the whole port, omcid leaves the OLT's
# bridge out (omcid -r).
# Sessions in one VLAN share its interface, wanVID, and the MAC of the first.
# In each VLAN towards the host, the first session told to hand down that
# carries IPv4 hands its address and its name servers down, and the first
# that carries IPv6 its delegated prefix, through dhcp6d, once its IPv6 is
# up; the others keep theirs on the stick. What a session has is in the
# directory /run/session/N: gem, dev and family, hands, the families it hands
# down ("ipv4 ipv6", one of them or nothing), lan where it hands down, and
# once it is up ppp, ipv4, ipv6 and dns, and pass and gateway once its
# address went down. MODE=router, kept for the bench, is the one setting of a
# shape.
#
# In bridge mode omcid connects the host link to the PON as the OLT
# provisions it. In router mode omcid leaves the OLT's bridge out (omcid -r)
# and the stick routes: the LAN is the host link, sfp, with an address and a
# DHCP server; the WAN is a GEM port that the OLT provisioned, or a VLAN on
# it, with an address by PPPoE, DHCP or by hand. The stick translates no
# address: a host on the LAN reaches beyond the WAN with an address that the
# network behind the WAN routes back to the stick. A watcher (onu-mode watch)
# brings the WAN up when the OLT provisions its GEM port and restarts the PPPoE
# or DHCP client when it ends.
#
# In passthrough, the address handed down goes on no interface of the
# stick's, and the one host on its link, the router behind the stick, takes
# it by DHCP, as a /32 with the concentrator's address as its gateway. Each
# VLAN the sessions hand down in is a link of its own, lanVID on the host
# link, or the host link itself for none.
#
# ONU_ROOT names another root for the files it reads and writes, which the
# tests use.

set -u

ROOT=${ONU_ROOT:-}
RUN=$ROOT/run
CONF=$RUN/onu.conf
IDENTITY=$RUN/onu-identity
SESSIONS=$RUN/session
MAX_SESSIONS=7
NET=$ROOT/sys/class/net
FORWARD=$ROOT/proc/sys/net/ipv4/ip_forward
FORWARD6=$ROOT/proc/sys/net/ipv6/conf/all/forwarding
IPV6_CONF=$ROOT/proc/sys/net/ipv6/conf
IPV4_CONF=$ROOT/proc/sys/net/ipv4/conf
IPV4_NEIGH=$ROOT/proc/sys/net/ipv4/neigh
SHARE=$ROOT/usr/share/onu
# The stick's own address on a link to the host, from which its DHCP server
# answers; the host is given the concentrator's address as its gateway.
LINK_ADDRESS=169.254.0.1

log() {
	echo "onu-mode: $*" >&2
	logger -t onu-mode "$*" 2>/dev/null
	return 0
}

# The settings: the defaults, then /run/onu.conf. A key that is not one of
# these and a value with characters no setting has are left out.
load() {
	MODE=bridge
	WAN_GEM=auto
	WAN_VLAN=
	WAN_PROTO=dhcp
	WAN_ADDRESS=
	WAN_GATEWAY=
	LAN_ADDRESS=192.168.1.1/24
	LAN_DHCP=on
	LAN_DHCP_START=192.168.1.100
	LAN_DHCP_END=192.168.1.199
	LAN_VLAN=
	LEGACY_LAN=
	WAN_MAC=
	n=1
	while [ $n -le $MAX_SESSIONS ]; do
		eval "SESSION${n}_GEM= SESSION${n}_VLAN= SESSION${n}_MAC= SESSION${n}_FAMILY="
		eval "SESSION${n}_PASS=on SESSION${n}_HOST_VLAN="
		n=$((n + 1))
	done
	if [ -r "$CONF" ]; then
		load_file
	fi
	# The single session of before: its settings were the WAN's.
	[ -n "$SESSION1_GEM" ] || SESSION1_GEM=$WAN_GEM
	[ -n "$SESSION1_VLAN" ] || SESSION1_VLAN=$WAN_VLAN
	[ -n "$SESSION1_MAC" ] || SESSION1_MAC=$WAN_MAC
	# The one link of before, LAN_VLAN or the host link itself, is the link
	# of each session that names none of its own.
	if [ -n "$LEGACY_LAN" ]; then
		n=1
		while [ $n -le $MAX_SESSIONS ]; do
			[ -n "$(setting $n HOST_VLAN)" ] ||
				eval "SESSION${n}_HOST_VLAN=\${LAN_VLAN:-untagged}"
			n=$((n + 1))
		done
	fi
	return 0
}

load_file() {
	while IFS='=' read -r key value; do
		case $key in
		MODE | WAN_GEM | WAN_VLAN | WAN_PROTO | WAN_ADDRESS | WAN_GATEWAY | \
			LAN_ADDRESS | LAN_DHCP | LAN_DHCP_START | LAN_DHCP_END | \
			WAN_MAC) ;;
		LAN_VLAN) LEGACY_LAN=1 ;;
		SESSION[1-7]_GEM | SESSION[1-7]_VLAN | SESSION[1-7]_MAC | \
			SESSION[1-7]_FAMILY | SESSION[1-7]_PASS | SESSION[1-7]_HOST_VLAN) ;;
		*) continue ;;
		esac
		case $value in
		*[!A-Za-z0-9./:_-]*)
			log "$key: not a value; the default stays"
			continue
			;;
		esac
		eval "$key=\$value"
	done <"$CONF"
}

# Setting $2 of session $1.
setting() {
	eval "echo \"\${SESSION$1_$2}\""
}

# The VLAN session $1 runs in on the PON side: its VLAN, or, where the OLT
# translates that VLAN of the subscriber's side, the VLAN the translation
# leads into, as omcid publishes them in /run/omcid-xlate ("SUB NET" lines).
# A session can so be given the VLAN a router behind the stick would use.
session_vlan() {
	v=$(setting "$1" VLAN)
	[ -n "$v" ] || return 0
	net=$(awk -v v="$v" '$1 == v { print $2; exit }' "$RUN/omcid-xlate" 2>/dev/null)
	echo "${net:-$v}"
}

# The sessions that have an account, by number.
sessions() {
	n=1
	while [ $n -le $MAX_SESSIONS ]; do
		[ -s "$RUN/onu-pppoe$n" ] && echo $n
		n=$((n + 1))
	done
}

# The family of session $1: ipv4, ipv6 or both.
family() {
	f=$(setting "$1" FAMILY)
	case $f in
	ipv4 | ipv6 | both) echo "$f" ;;
	*) echo both ;;
	esac
}

# The VLAN of the host link session $1 hands its address down in: the one
# its HOST_VLAN names, else its own, the VID the operator names its service
# with; nothing for none (untagged).
down_vlan() {
	hv=$(setting "$1" HOST_VLAN)
	case $hv in
	untagged) ;;
	'') setting "$1" VLAN ;;
	*) echo "$hv" ;;
	esac
}

# The address the PON side sends from where a session or the WAN names
# none: the host link's, made locally administered (or, already so, with its
# last bit turned). On the PON side the switch looks a frame up by the PON
# port's PVID, where the host link's own address has its entry, with the
# router bit the L3 engine needs from the host's side: with one address on
# both sides, the frames the engine routed down from the PON went nowhere
# once the PON port dropped the unicast no entry knows (measured), while an
# address of the PON side's own gets an entry of its own.
pon_mac() {
	base=$(cat "$NET/sfp/address" 2>/dev/null)
	[ -n "$base" ] || return 0
	mac=$(printf '%02x:%s' $((0x${base%%:*} | 2)) "${base#*:}")
	[ "$mac" != "$base" ] ||
		mac=$(printf '%s:%02x' "${base%:*}" $((0x${base##*:} ^ 1)))
	echo "$mac"
}

# The link to the host for the VLAN $1: lanVID, or the host link itself.
link_of() {
	if [ -n "$1" ]; then
		echo "lan$1"
	else
		echo sfp
	fi
}

# Whether session $1 hands its $2, ipv4 or ipv6, down: it is told to, it
# carries that family, and it is the first in its VLAN towards the host that
# is both. In one VLAN one session at most hands its IPv4 address down, and
# one its IPv6 prefix.
hands() {
	hv=$(down_vlan "$1")
	for hm in $(sessions); do
		[ "$(setting "$hm" PASS)" = off ] && continue
		[ "$(down_vlan "$hm")" = "$hv" ] || continue
		case $(family "$hm") in
		both | "$2")
			[ "$hm" = "$1" ]
			return
			;;
		esac
	done
	return 1
}

# The session the stick's own default route goes by, of those that hand an
# IPv4 address down: the first. Each other has a routing table of its own,
# by which what comes from its address goes by its link.
main_pass() {
	for mp in $(sessions); do
		if hands "$mp" ipv4; then
			echo "$mp"
			return 0
		fi
	done
}

# The session the stick's own IPv6 default route goes by, of those that hand
# a prefix down: the first. Each other has its table, as main_pass().
main_pd() {
	for mp in $(sessions); do
		if hands "$mp" ipv6; then
			echo "$mp"
			return 0
		fi
	done
}

# The routing table of session $1, for what comes from the address or the
# prefix it hands down.
table_of() {
	echo $((100 + $1))
}

# The links to the host the sessions hand down by, one a line.
pass_links() {
	for pl in $(sessions); do
		[ "$(setting "$pl" PASS)" = off ] && continue
		link_of "$(down_vlan "$pl")"
	done | sort -u
}

# The dotted mask of a prefix length.
netmask() {
	bits=$1
	mask=
	for octet in 1 2 3 4; do
		if [ "$bits" -ge 8 ]; then
			n=255
			bits=$((bits - 8))
		else
			n=$((256 - (1 << (8 - bits))))
			[ "$bits" -eq 0 ] && n=0
			bits=0
		fi
		mask=$mask${mask:+.}$n
	done
	echo "$mask"
}

pid_of() {
	[ -r "$RUN/$1.pid" ] && cat "$RUN/$1.pid"
}

# The program $3... as procd's service $1 (onu-svc start NAME [OPTION...] --
# PROGRAM...), which procd starts, and again 2 s after it ends.
svc_start() {
	onu-svc start "$@" || log "$1 is no service of procd: not started"
}

# procd's service $1 ended, and forgotten; none is no error.
svc_stop() {
	onu-svc stop "$1" 2>/dev/null
	return 0
}

stop_pid() {
	pid=$(pid_of "$1")
	[ -n "$pid" ] && kill "$pid" 2>/dev/null
	rm -f "$RUN/$1.pid"
}

# omcid in the mode $1. A running omcid is told by a signal, SIGUSR2 for
# bridge mode and SIGUSR1 for the others, where the stick routes: it keeps its
# MIB, so what the OLT provisioned stays, and programs the data path again
# from it. One that does not run is started as procd's service "omcid"
# (onu-run omcid), with -r where the stick routes; its log goes on in
# /run/omcid.log. The mode is kept in /run/omcid.mode, so that an omcid that
# procd starts again after a crash comes up in the mode the stick is in.
omcid_run() {
	echo "$1" >"$RUN/omcid.mode"
	if pidof omcid >/dev/null 2>&1; then
		if [ "$1" = bridge ]; then
			killall -USR2 omcid
		else
			killall -USR1 omcid
		fi
		sleep 1
	else
		svc_start omcid -- onu-run omcid
	fi
}

# The VLANs the sessions hold, by their VID on the PON side, one a line; none,
# with status 1, when a session runs untagged on its GEM port.
held_vlans() {
	out=
	for n in $(sessions); do
		v=$(session_vlan "$n")
		[ -n "$v" ] || return 1
		out="$out $v"
	done
	echo $out | tr ' ' '\n' | sort -un
}

# What omcid is to do in the mode $MODE: "bridge", the OLT's bridge whole;
# "held VID...", the OLT's bridge without the VLANs the sessions hold;
# "router", without the OLT's bridge, in the bench's router mode and beside a
# session that holds a whole GEM port.
omcid_want() {
	case $MODE in
	bridge) echo bridge ;;
	router) echo router ;;
	*) held_want ;;
	esac
}

# What omcid is to do beside the sessions (see omcid_want()).
held_want() {
	if held=$(held_vlans); then
		echo held $held
	else
		echo router
	fi
}

# Bring omcid to $1, as omcid_want() gives it, from what it was told last.
# omcid reads the held VLANs from /run/onu-held-vlans; for them its bridge is
# taken down first, so that it builds it again without what it leaves out
# now. Back to the whole bridge it adds what it left out.
omcid_sync() {
	[ "$1" = "$(cat "$RUN/onu-omcid" 2>/dev/null)" ] && return 0
	case $1 in
	held\ *)
		echo "${1#held }" | tr ' ' '\n' >"$RUN/onu-held-vlans"
		bridge_down
		omcid_run bridge
		;;
	bridge)
		rm -f "$RUN/onu-held-vlans"
		omcid_run bridge
		;;
	*)
		rm -f "$RUN/onu-held-vlans"
		omcid_run router
		bridge_down
		;;
	esac
	echo "$1" >"$RUN/onu-omcid"
}

# What omcid built in bridge mode: the bridge and its VLAN rules, the filters
# from priority 1000 up on the ingress of sfp and pon. The filters of the
# management VLAN, which the boot put at priority 1 of the same qdiscs, stay:
# they keep that VLAN off the PON in every mode.
bridge_down() {
	ip link del omcibr0 2>/dev/null
	for dev in sfp pon; do
		for pref in $(tc filter show dev "$dev" ingress 2>/dev/null |
			awk '{ for (i = 1; i < NF; i++)
				if ($i == "pref" && $(i + 1) >= 1000) print $(i + 1) }' |
			sort -u); do
			tc filter del dev "$dev" ingress pref "$pref" 2>/dev/null
		done
	done
	return 0
}

# The GEM interface for the setting $1: gemN for N, or for auto (or nothing)
# the one of the lowest Port-ID but 4095, which OLTs give to multicast.
gem_of() {
	if [ -n "$1" ] && [ "$1" != auto ]; then
		[ -e "$NET/gem$1" ] && echo "gem$1"
		return 0
	fi
	for id in $(ls "$NET" 2>/dev/null | sed -n 's/^gem\([0-9][0-9]*\)$/\1/p' | sort -n); do
		[ "$id" = 4095 ] && continue
		echo "gem$id"
		return 0
	done
}

wan_gem() {
	gem_of "$WAN_GEM"
}

# The GEM interface of session $1: the one its GEM setting names; for auto
# (or nothing), where the session has a VLAN, the GEM port that the OLT lets
# that VLAN on the fibre through, as omcid publishes them in
# /run/omcid-gem-vlans ("VID PORT-ID" lines), the lowest Port-ID of them;
# else the one gem_of() gives. A session given the VID by which the operator
# names its service so follows the service to another VID on the fibre and
# to another GEM port.
session_gem() {
	g=$(setting "$1" GEM)
	v=$(session_vlan "$1")
	if { [ -z "$g" ] || [ "$g" = auto ]; } && [ -n "$v" ]; then
		for id in $(awk -v v="$v" '$1 == v { print $2 }' \
			"$RUN/omcid-gem-vlans" 2>/dev/null | sort -n); do
			if [ -e "$NET/gem$id" ]; then
				echo "gem$id"
				return 0
			fi
		done
	fi
	gem_of "$g"
}

# The DHCP server of the LAN, with the WAN's name servers when they are known.
lan_dhcp() {
	svc_stop udhcpd
	[ "$LAN_DHCP" = on ] || return 0
	{
		echo "interface sfp"
		echo "start $LAN_DHCP_START"
		echo "end $LAN_DHCP_END"
		echo "lease_file $RUN/udhcpd.leases"
		echo "pidfile $RUN/udhcpd.pid"
		echo "opt router ${LAN_ADDRESS%/*}"
		echo "opt subnet $(netmask "${LAN_ADDRESS#*/}")"
		[ -s "$RUN/onu-dns" ] && echo "opt dns $(cat "$RUN/onu-dns")"
		echo "opt lease 3600"
	} >"$RUN/udhcpd.conf"
	[ -e "$RUN/udhcpd.leases" ] || : >"$RUN/udhcpd.leases"
	cp "$RUN/onu-dns" "$RUN/udhcpd.dns" 2>/dev/null || rm -f "$RUN/udhcpd.dns"
	svc_start udhcpd -- udhcpd -f "$RUN/udhcpd.conf"
}

# One run of pppoed for session $1 on $2, with the options $3; its process id
# goes to /run/pppoedN.pid, for session_down().
pppoe_client() {
	# $3 is a list of options, split on purpose. -M: a concentrator that
	# agreed to 1500-byte packets in the discovery is taken at its word
	# when its LCP asks for 1492, as an operator's does while it carries
	# 1500 each way (measured; pppoed/README.rst).
	sh -c 'echo $$ >"$0"; exec "$@"' "$RUN/pppoed$1.pid" \
		pppoed up -i "$2" -f "$RUN/onu-pppoe$1" $3 -M
}

# What session $1 has: the fact $2 with the value $3, or none without one.
note() {
	[ -d "$SESSIONS/$1" ] || return 0
	if [ -n "${3:-}" ]; then
		echo "$3" >"$SESSIONS/$1/$2"
	else
		rm -f "$SESSIONS/$1/$2"
	fi
}

# The delegated IPv6 prefix of session $1, whose link $2 came up on its
# interface $3, handed on to the host by dhcp6d: the link to the host gets
# IPv6, and the stick forwards it. A session other than main_pd() has dhcp6d
# route what comes from its prefix by the session's own table. dhcp6d keeps
# the host's binding in /run/onu-pdN, which pd_keep() keeps in the store. It
# is procd's service dhcp6dN.
pd_up() {
	lan=$(cat "$SESSIONS/$1/lan" 2>/dev/null)
	[ -n "$lan" ] || return 0
	svc_stop "dhcp6d$1"
	echo 0 >"$IPV6_CONF/$lan/disable_ipv6" 2>/dev/null
	echo 1 >"$FORWARD6" 2>/dev/null
	table=
	[ "$1" = "$(main_pd)" ] || table="-t $(table_of "$1")"
	# $table is an option and its value, split on purpose.
	svc_start "dhcp6d$1" -o "$RUN/dhcp6d.log" -- \
		dhcp6d -w "$2" -l "$lan" -m "$3" -o "$SESSIONS/$1" -b "$RUN/onu-pd$1" $table
	log "session $1: its IPv6 prefix goes to the router on $lan"
}

# The PPPoE client of session $1 on $2, with the options $3, started again
# whenever the link ends. In the role $4, "pass" or "routed", its "up" line
# gives the address the host takes, until the link ends, by the stick's
# default route or by the session's own table; "pass" and "primary" give the
# stick's name servers. With $5, "pd", its "up6" line starts dhcp6d, which
# hands the session's delegated IPv6 prefix on.
pppoe_loop() {
	while :; do
		pppoe_client "$1" "$2" "$3" 2>>"$RUN/pppoed.log" |
			while read -r word dev _ addr _ peer _ _ _ dns1 dns2; do
				case $word in
				up6)
					note "$1" ppp "$dev"
					note "$1" ipv6 "$addr"
					log "session $1: IPv6 up on $dev"
					[ "$5" = pd ] && pd_up "$1" "$dev" "$2"
					continue
					;;
				up) ;;
				*) continue ;;
				esac
				note "$1" ppp "$dev"
				note "$1" ipv4 "$addr"
				dns=$(echo "$dns1 $dns2" | sed 's/ *- *//g')
				note "$1" dns "$dns"
				if [ "$4" = pass ] || [ "$4" = primary ]; then
					if [ -n "$dns" ]; then
						echo "$dns" >"$RUN/onu-dns"
					else
						rm -f "$RUN/onu-dns"
					fi
				fi
				case $4 in
				pass | routed) pass_lease "$1" "$addr" "$dev" "$peer" ;;
				esac
				log "session $1: IPv4 up on $dev"
			done
		note "$1" ppp
		note "$1" ipv4
		note "$1" ipv6
		note "$1" dns
		[ "$5" = pd ] && svc_stop "dhcp6d$1"
		case $4 in
		pass | routed) pass_lease_down "$1" ;;
		esac
		# Sessions that ended together start again apart (see
		# sessions_tick()): 5 s for the first, 3 s more for each next.
		sleep $((2 + 3 * $1))
	done
}

# The address $2 of session $1, whose link is $3, handed down: a host route
# to it on the session's link to the host, and a DHCP server there that
# leases it alone, as a /32 with the stick as the gateway, the session's name
# servers and its MTU. A lease runs for a minute: the router asks again
# before it ends, so it finds a new address of a new session that soon. The
# gateway is the concentrator's address $4, as a router that made the
# session itself would have it, and the stick answers ARP for it on the link
# without taking it: a packet to it goes on into the session, so that the
# concentrator answers it. Without the peer's address it is the stick's own
# address on the link, LINK_ADDRESS, which the DHCP server answers from
# either way. A session other than main_pass() routes what comes from its
# address by a table of its own, through its link.
pass_lease() {
	lan=$(cat "$SESSIONS/$1/lan" 2>/dev/null)
	[ -n "$lan" ] || return 0
	svc_stop "udhcpd-$lan"
	[ "$(cat "$SESSIONS/$1/pass" 2>/dev/null)" = "$2" ] ||
		rm -f "$RUN/udhcpd-$lan.leases"
	ip route replace "$2" dev "$lan"
	gw=$LINK_ADDRESS
	case $4 in
	'' | *[!0-9.]* | 0.0.0.0) ;;
	*) gw=$4 ;;
	esac
	if [ "$gw" != "$LINK_ADDRESS" ]; then
		echo 0 >"$IPV4_NEIGH/$lan/proxy_delay" 2>/dev/null
		ip neigh add proxy "$gw" dev "$lan" 2>/dev/null
	fi
	if [ "$1" != "$(main_pass)" ]; then
		ip rule del from "$2" lookup "$(table_of "$1")" 2>/dev/null
		ip rule add from "$2" lookup "$(table_of "$1")"
		ip route replace default dev "$3" table "$(table_of "$1")"
	fi
	mtu=$(cat "$NET/$3/mtu" 2>/dev/null)
	dns=$(cat "$SESSIONS/$1/dns" 2>/dev/null)
	{
		echo "interface $lan"
		echo "start $2"
		echo "end $2"
		echo "max_leases 1"
		echo "lease_file $RUN/udhcpd-$lan.leases"
		echo "pidfile $RUN/udhcpd-$lan.pid"
		echo "opt subnet 255.255.255.255"
		echo "opt router $gw"
		echo "opt staticroutes $gw/32 0.0.0.0, 0.0.0.0/0 $gw"
		[ -n "$dns" ] && echo "opt dns $dns"
		[ -n "$mtu" ] && echo "opt mtu $mtu"
		echo "opt lease 60"
	} >"$RUN/udhcpd-$lan.conf"
	[ -e "$RUN/udhcpd-$lan.leases" ] || : >"$RUN/udhcpd-$lan.leases"
	note "$1" pass "$2"
	note "$1" gateway "$gw"
	# The stick's own way out: what the status daemon shows as the
	# address handed on.
	if [ "$1" = "$(main_pass)" ]; then
		echo "$2" >"$RUN/onu-pass"
		echo "$lan" >"$RUN/onu-lan"
		if [ "$gw" != "$LINK_ADDRESS" ]; then
			echo "$gw" >"$RUN/onu-pass-proxy"
		else
			rm -f "$RUN/onu-pass-proxy"
		fi
	fi
	svc_start "udhcpd-$lan" -- udhcpd -f "$RUN/udhcpd-$lan.conf"
	log "session $1: its address goes to the router on $lan, with the gateway $gw"
}

# The address session $1 handed down taken back, when the session ends.
pass_lease_down() {
	addr=$(cat "$SESSIONS/$1/pass" 2>/dev/null)
	lan=$(cat "$SESSIONS/$1/lan" 2>/dev/null)
	gw=$(cat "$SESSIONS/$1/gateway" 2>/dev/null)
	[ -n "$lan" ] && svc_stop "udhcpd-$lan"
	if [ -n "$addr" ] && [ -n "$lan" ]; then
		ip route del "$addr" dev "$lan" 2>/dev/null
		if ip rule del from "$addr" lookup "$(table_of "$1")" 2>/dev/null; then
			ip route flush table "$(table_of "$1")" 2>/dev/null
		fi
	fi
	if [ -n "$gw" ] && [ "$gw" != "$LINK_ADDRESS" ] && [ -n "$lan" ]; then
		ip neigh del proxy "$gw" dev "$lan" 2>/dev/null
	fi
	if [ -n "$addr" ] && [ "$addr" = "$(cat "$RUN/onu-pass" 2>/dev/null)" ]; then
		rm -f "$RUN/onu-pass" "$RUN/onu-pass-proxy" "$RUN/onu-lan"
	fi
	note "$1" pass
	note "$1" gateway
	return 0
}

# Room for PPPoE's 8 bytes of headers around a 1500-byte packet (RFC 4638) on
# the PON port, the GEM interface $1 and the WAN interface $2, as far as each
# takes it: pppoed asks the concentrator for 1500 bytes, and keeps to 1492
# when the interface has no room or the concentrator does not agree.
pppoe_mtu() {
	for mtu_dev in pon "$1" "$2"; do
		ip link set "$mtu_dev" mtu 1508 2>/dev/null || return 0
	done
}

# Bring the WAN up on the GEM interface $1.
wan_up() {
	gem=$1
	wan=$gem
	ip link set "$gem" up
	if [ -n "$WAN_VLAN" ]; then
		ip link add link "$gem" name wan type vlan id "$WAN_VLAN"
		wan=wan
	fi
	mac=${WAN_MAC:-$(pon_mac)}
	if [ -n "$mac" ]; then
		ip link set "$wan" address "$mac" ||
			log "the WAN did not take its MAC address"
	fi
	[ "$wan" = wan ] && ip link set wan up
	out=$wan
	case $WAN_PROTO in
	pppoe)
		pppoe_mtu "$gem" "$wan"
		pppoe_loop 1 "$wan" -D primary none &
		echo $! >"$RUN/pppoe-loop1.pid"
		out=ppp0
		;;
	static)
		ip address add "$WAN_ADDRESS" dev "$wan"
		ip route replace default via "$WAN_GATEWAY" dev "$wan"
		;;
	*)
		udhcpc -i "$wan" -b -p "$RUN/udhcpc.pid" -s "$SHARE/dhcp-wan"
		;;
	esac
	echo "$gem $wan $out" >"$RUN/onu-wan"
	feeds_sync "$gem" ${WAN_VLAN:+"$WAN_VLAN:$gem"}
	log "WAN on $wan ($WAN_PROTO), GEM port ${gem#gem}"
}

# The GEM ports other than the WAN's $1. In bridge mode omcid bridges them with
# the host link; where the stick routes, what they carry in the WAN's VLAN is
# the WAN's. The OLT sends the network side's broadcasts, an ARP request for
# the WAN's address among them, by the multicast GEM port, and an answer by
# that port, which cannot send, is lost. And where the GEM ports of an IEEE
# 802.1p mapper divide a VLAN's priorities, the OLT sends the WAN's frames down
# by more than one of them: an operator's sent the PPPoE discovery and control
# frames by the GEM port of priorities 6 and 7 while the session sent by that
# of priority 0, and the session never came up (measured). So the frames of
# every other GEM port are handed to the WAN's GEM interface as they come in:
# feeds_sync TO [VID:GEM...] hands every frame to the GEM interface TO, or,
# with pairs, only the frames of each VID to its GEM interface, and leaves the
# rest to the OLT's bridge, or to nobody: the same operator sent a television
# channel by the multicast GEM port, 7 Mb/s that no one had asked for
# (measured), which the WAN has no use for. The frames the switch routes in
# hardware never reach these rules.
feeds_sync() {
	to=$1
	shift
	ports=$(pon gem 2>/dev/null | awk -v wan="$to" '$1 != wan { print $1 }' | sort)
	key=$(echo "$to" $ports "$@")
	[ "$key" = "$(cat "$RUN/onu-feeds.key" 2>/dev/null)" ] && return 0
	feeds_down
	for port in $ports; do
		if [ $# -eq 0 ]; then
			rules=":$to"
		else
			rules=
			for pair; do
				# A session's own GEM port keeps its frames.
				[ "${pair#*:}" = "$port" ] || rules="$rules $pair"
			done
			[ -n "$rules" ] || continue
		fi
		tc qdisc add dev "$port" clsact 2>/dev/null
		echo "$port" >>"$RUN/onu-feeds"
		for rule in $rules; do
			if [ -z "${rule%%:*}" ]; then
				tc filter add dev "$port" ingress matchall action mirred \
					ingress redirect dev "${rule#*:}"
			else
				tc filter add dev "$port" ingress protocol 802.1Q flower \
					vlan_id "${rule%%:*}" action mirred ingress redirect \
					dev "${rule#*:}"
			fi
		done
	done
	echo "$key" >"$RUN/onu-feeds.key"
}

feeds_down() {
	for port in $(cat "$RUN/onu-feeds" 2>/dev/null); do
		tc qdisc del dev "$port" clsact 2>/dev/null
	done
	rm -f "$RUN/onu-feeds" "$RUN/onu-feeds.key"
	return 0
}

wan_down() {
	gem= wan=
	[ -r "$RUN/onu-wan" ] && read -r gem wan _ <"$RUN/onu-wan"
	stop_pid pppoe-loop1
	stop_pid pppoed1
	stop_pid udhcpc
	feeds_down
	# What a static or DHCP WAN put on the interface goes with it.
	if [ -n "$wan" ]; then
		ip -4 route flush dev "$wan" 2>/dev/null
		ip -4 address flush dev "$wan" 2>/dev/null
	fi
	ip link del wan 2>/dev/null
	# What pppoe_mtu() raised goes back to Ethernet's MTU, the PON port last.
	if [ -n "$gem" ]; then
		ip link set "$gem" mtu 1500 2>/dev/null
		ip link set pon mtu 1500 2>/dev/null
	fi
	rm -f "$RUN/onu-wan" "$RUN/onu-dns"
	return 0
}

# The interface of session $1 on the GEM interface $2: the GEM interface
# itself, or wanVID for a VLAN.
session_dev() {
	vlan=$(session_vlan "$1")
	if [ -n "$vlan" ]; then
		echo "wan$vlan"
	else
		echo "$2"
	fi
}

# Whether a running session other than $1 is on the interface $2.
dev_shared() {
	for d in "$SESSIONS"/*/dev; do
		[ -r "$d" ] || continue
		[ "$d" = "$SESSIONS/$1/dev" ] && continue
		[ "$(cat "$d")" = "$2" ] && return 0
	done
	return 1
}

# Session $1 up on the GEM interface $2: its interface, made for the first
# session on it, or again when it is gone (the kernel takes a VLAN interface
# away with the GEM interface under it, which an OLT's new provisioning
# replaces, before the other sessions on it have moved), room for PPPoE's
# headers, and its client.
session_up() {
	n=$1 gem=$2
	dev=$(session_dev "$n" "$gem")
	fam=$(family "$n")
	if ! dev_shared "$n" "$dev" || [ ! -e "$NET/$dev" ]; then
		ip link set "$gem" up
		if [ "$dev" != "$gem" ]; then
			ip link add link "$gem" name "$dev" type vlan id "$(session_vlan "$n")"
		fi
		mac=$(setting "$n" MAC)
		[ -n "$mac" ] || mac=$(pon_mac)
		if [ -n "$mac" ]; then
			ip link set "$dev" address "$mac" ||
				log "session $n: the interface did not take its MAC address"
		fi
		[ "$dev" != "$gem" ] && ip link set "$dev" up
		pppoe_mtu "$gem" "$dev"
	fi
	mkdir -p "$SESSIONS/$n"
	echo "$gem" >"$SESSIONS/$n/gem"
	echo "$dev" >"$SESSIONS/$n/dev"
	echo "$fam" >"$SESSIONS/$n/family"
	opts= role=none
	case $fam in
	ipv4) opts=-4 ;;
	ipv6) opts=-6 ;;
	esac
	if hands "$n" ipv4; then
		if [ "$n" = "$(main_pass)" ]; then
			opts="-D $opts -P"
			role=pass
		else
			opts="$opts -P"
			role=routed
		fi
	fi
	role6=none
	hands "$n" ipv6 && role6=pd
	if [ "$role" != none ] || [ "$role6" != none ]; then
		link_of "$(down_vlan "$n")" >"$SESSIONS/$n/lan"
	fi
	# What it hands down, for the status daemon, which shows what the stick
	# does rather than work it out again.
	hands=
	[ "$role" != none ] && hands=ipv4
	[ "$role6" != none ] && hands="${hands:+$hands }ipv6"
	if [ -n "$hands" ]; then
		echo "$hands"
	fi >"$SESSIONS/$n/hands"
	pppoe_loop "$n" "$dev" "$opts" "$role" "$role6" &
	echo $! >"$RUN/pppoe-loop$n.pid"
	log "session $n on $dev ($fam), GEM port ${gem#gem}"
}

# Whether a running session other than $1 is on the GEM interface $2.
gem_shared() {
	for g in "$SESSIONS"/*/gem; do
		[ -r "$g" ] || continue
		[ "$g" = "$SESSIONS/$1/gem" ] && continue
		[ "$(cat "$g")" = "$2" ] && return 0
	done
	return 1
}

# Session $1 down: its client, which ends the session with the concentrator,
# and its interface when no other session is on it. Its names are its own:
# the watcher's round holds the GEM port it goes up on next.
session_down() {
	[ -r "$SESSIONS/$1/dev" ] || return 0
	read -r down_dev <"$SESSIONS/$1/dev"
	read -r down_gem <"$SESSIONS/$1/gem"
	stop_pid "pppoe-loop$1"
	stop_pid "pppoed$1"
	svc_stop "dhcp6d$1"
	pass_lease_down "$1"
	if ! dev_shared "$1" "$down_dev"; then
		[ "$down_dev" != "$down_gem" ] && ip link del "$down_dev" 2>/dev/null
		# What pppoe_mtu() raised goes back to Ethernet's MTU, the PON port
		# last, once no session is on the GEM port.
		gem_shared "$1" "$down_gem" || ip link set "$down_gem" mtu 1500 2>/dev/null
	fi
	rm -rf "${SESSIONS:?}/$1"
	[ -n "$(ls "$SESSIONS" 2>/dev/null)" ] || ip link set pon mtu 1500 2>/dev/null
	log "session $1 down"
	return 0
}

sessions_down() {
	for d in "$SESSIONS"/*; do
		[ -d "$d" ] && session_down "${d##*/}"
	done
	feeds_down
	rm -f "$RUN/onu-dns"
	return 0
}

# The host each session delegates its prefix to, which dhcp6d keeps in
# /run/onu-pdN, goes into the store when it changes, and so does its going:
# after a restart of the stick, dhcp6d routes the prefix to that host at once,
# since a router that holds its delegation asks for none (measured:
# NetworkManager kept its /56 for a day and asked for the name servers only).
# What went into the store is in /run/onu-pdN.kept.
pd_keep() {
	command -v onu-store >/dev/null || return 0
	n=1
	while [ $n -le $MAX_SESSIONS ]; do
		pd=$RUN/onu-pd$n
		if { [ -e "$pd" ] || [ -e "$pd.kept" ]; } &&
			[ "$(cat "$pd" 2>/dev/null)" != "$(cat "$pd.kept" 2>/dev/null)" ] &&
			onu-store pd $n; then
			if [ -e "$pd" ]; then
				cp "$pd" "$pd.kept"
			else
				rm -f "$pd.kept"
			fi
		fi
		n=$((n + 1))
	done
}

# One round of the watcher in passthrough: each session follows its GEM port,
# and a session without its account any more goes. One session starts in a
# round, the next a round later: an operator's concentrator refused one of two
# sessions that authenticated at once, without saying why, and took each alone
# (measured).
sessions_tick() {
	want=" $(sessions | tr '\n' ' ')"
	started=
	# The OLT's translations may have come since: omcid leaves the
	# sessions' VLANs out as they now are, before the sessions move.
	omcid_sync "$(held_want)"
	n=1
	while [ $n -le $MAX_SESSIONS ]; do
		cur= dev=
		[ -r "$SESSIONS/$n/gem" ] && read -r cur <"$SESSIONS/$n/gem"
		[ -r "$SESSIONS/$n/dev" ] && read -r dev <"$SESSIONS/$n/dev"
		case $want in
		*" $n "*)
			gem=$(session_gem "$n")
			if [ -n "$gem" ] && { [ "$gem" != "$cur" ] ||
				[ "$(session_dev "$n" "$gem")" != "$dev" ]; }; then
				if [ -z "$started" ]; then
					[ -n "$cur" ] && session_down "$n"
					session_up "$n" "$gem"
					started=$n
				fi
			elif [ -z "$gem" ] && [ -n "$cur" ]; then
				log "session $n: its GEM port is gone"
				session_down "$n"
			fi
			;;
		*)
			[ -n "$cur" ] && session_down "$n"
			;;
		esac
		n=$((n + 1))
	done
	first=$(cat "$SESSIONS"/*/gem 2>/dev/null | head -n 1)
	if [ -z "$first" ]; then
		feeds_down
	elif held_vlans >/dev/null; then
		pairs=
		for d in "$SESSIONS"/*; do
			[ -r "$d/gem" ] || continue
			read -r g <"$d/gem"
			pairs="$pairs $(session_vlan "${d##*/}"):$g"
		done
		feeds_sync "$first" $(echo $pairs | tr ' ' '\n' | sort -u)
	else
		feeds_sync "$first"
	fi
	pd_keep
}

# One round of the watcher: in router mode the WAN follows its GEM port, and
# the DHCP server follows the name servers; in passthrough the sessions.
tick() {
	load
	if [ "$(cat "$RUN/onu-mode" 2>/dev/null)" = passthrough ]; then
		sessions_tick
		return 0
	fi
	gem=$(wan_gem)
	cur=
	[ -r "$RUN/onu-wan" ] && read -r cur _ <"$RUN/onu-wan"
	if [ -n "$gem" ] && [ "$gem" != "$cur" ]; then
		[ -n "$cur" ] && wan_down
		wan_up "$gem"
	elif [ -z "$gem" ] && [ -n "$cur" ]; then
		log "GEM port of the WAN gone"
		wan_down
	elif [ -n "$cur" ]; then
		feeds_sync "$cur" ${WAN_VLAN:+"$WAN_VLAN:$cur"}
	fi
	if [ "$MODE" = router ] && [ -s "$RUN/onu-dns" ] &&
		[ "$(cat "$RUN/onu-dns")" != "$(cat "$RUN/udhcpd.dns" 2>/dev/null)" ]; then
		lan_dhcp
	fi
}

# The watcher is procd's service onu-watch: it outlives the shell that started
# it, an "onu-mode apply" from a login that ends, and procd starts it again
# if it ends.
watch() {
	while :; do
		tick
		sleep 5
	done
}

router_up() {
	echo 1 >"$FORWARD"
	ip address add "$LAN_ADDRESS" dev sfp 2>/dev/null
	lan_dhcp
	# The tests run the watcher's rounds themselves.
	[ -n "${ONU_MODE_NO_WATCH:-}" ] || svc_start onu-watch -- "$0" watch
}

router_down() {
	svc_stop onu-watch
	wan_down
	svc_stop udhcpd
	[ -n "$LAN_ADDRESS" ] && ip address del "$LAN_ADDRESS" dev sfp 2>/dev/null
	echo 0 >"$FORWARD"
	return 0
}

# Whether the switch's L3 engine decrements the TTL or hop limit of what it
# routes, true or false.
ttl_decrement() {
	dev=$(devlink dev show 2>/dev/null | head -n 1)
	[ -n "$dev" ] || return 0
	devlink dev param set "$dev" name l3_ttl_decrement cmode runtime value "$1" ||
		log "the switch did not take l3_ttl_decrement $1"
}

# Passthrough mode: the links to the host, one for each VLAN the sessions
# hand their addresses down in, a VLAN on the host link or the host link
# itself, with the stick's address on each; the sessions' addresses come
# later. The stick stands in for the operator's ONT between the router and
# the concentrator, which is no hop: the switch routes the sessions' packets
# with their TTL unchanged, as it does the gateway the router is given.
# A link forwards only what comes from the address it hands on (BCP 38): a
# strict reverse-path check drops a packet whose source the stick would not
# route back by the link. Without it, packets of any source that reached the
# stick's MAC on the link went out into the session (measured: about half of
# 1000, the rest cut by the limit on the frames to the CPU). The switch routes
# only the handed address's own packets in hardware.
pass_up() {
	echo 1 >"$FORWARD"
	ttl_decrement false
	: >"$RUN/onu-lans"
	for lan in $(pass_links); do
		if [ "$lan" != sfp ]; then
			ip link add link sfp name "$lan" type vlan id "${lan#lan}"
			ip link set "$lan" up
		fi
		echo 1 >"$IPV4_CONF/$lan/rp_filter"
		ip address add "$LINK_ADDRESS/32" dev "$lan"
		echo "$lan" >>"$RUN/onu-lans"
	done
	[ -n "${ONU_MODE_NO_WATCH:-}" ] || svc_start onu-watch -- "$0" watch
}

pass_down() {
	svc_stop onu-watch
	sessions_down
	for lan in $(cat "$RUN/onu-lans" 2>/dev/null); do
		ip address del "$LINK_ADDRESS/32" dev "$lan" 2>/dev/null
		if [ "$lan" = sfp ]; then
			echo 0 >"$IPV4_CONF/sfp/rp_filter"
		else
			ip link del "$lan" 2>/dev/null
		fi
	done
	rm -f "$RUN/onu-lans" "$RUN/onu-lan" "$RUN/onu-pass" "$RUN/onu-pass-proxy"
	ttl_decrement true
	echo 0 >"$FORWARD"
	echo 0 >"$FORWARD6" 2>/dev/null
	return 0
}

# The identity to the PON driver, which takes it while the PON is down, then
# the PON up. Twenty hex digits of PLOAM password are its ten octets.
identity() {
	serial=$(grep '^serial=' "$IDENTITY" 2>/dev/null | cut -d= -f2)
	ploam=$(grep '^ploam_password=' "$IDENTITY" 2>/dev/null | cut -d= -f2-)
	dev=$(devlink dev show 2>/dev/null | head -n 1)
	if [ -z "$serial" ] || [ -z "$dev" ]; then
		log "no serial number: the PON stays down"
		return 1
	fi
	devlink dev param set "$dev" name gpon_serial cmode runtime value "$serial" ||
		log "the PON driver did not take the serial number"
	if [ -n "$ploam" ]; then
		case $ploam in
		*[!0-9A-Fa-f]*) ;;
		*) [ ${#ploam} -eq 20 ] && ploam=0x$ploam ;;
		esac
		devlink dev param set "$dev" name gpon_password cmode runtime value "$ploam" ||
			log "the PON driver did not take the PLOAM password"
	fi
	ip link set pon up || log "the PON does not come up"
}

# A new identity: the OLT sees the stick leave and a new one arrive, and
# omcid starts over with the MIB the OLT builds for it.
reidentify() {
	ip link set pon down
	identity || return 1
	want=
	[ -r "$RUN/onu-omcid" ] && read -r want _ <"$RUN/onu-omcid"
	svc_stop omcid
	case $want in
	router) omcid_run router ;;
	*) omcid_run bridge ;;
	esac
	log "registering again"
}

apply() {
	old=
	[ -r "$RUN/onu-mode" ] && read -r old <"$RUN/onu-mode"
	if [ "$old" = router ] || [ "$old" = passthrough ]; then
		# Down with the settings it came up with.
		[ -r "$RUN/onu-mode.conf" ] && CONF=$RUN/onu-mode.conf
		load
		if [ "$old" = router ]; then
			router_down
		else
			pass_down
		fi
		CONF=$RUN/onu.conf
	fi
	load
	# Only the bench's router is chosen; otherwise an account makes the
	# stick hold its sessions, and none leaves the OLT's bridge.
	if [ "$MODE" != router ]; then
		if [ -n "$(sessions)" ]; then
			MODE=passthrough
		else
			MODE=bridge
		fi
	fi
	omcid_sync "$(omcid_want)"
	echo "$MODE" >"$RUN/onu-mode"
	case $MODE in
	router) router_up ;;
	passthrough) pass_up ;;
	esac
	cp "$CONF" "$RUN/onu-mode.conf" 2>/dev/null
	log "$MODE mode"
}

case ${1:-} in
start)
	[ -e "$CONF" ] || cp "$ROOT/etc/onu.conf" "$CONF" 2>/dev/null || : >"$CONF"
	if [ -z "$(sessions)" ] && [ -r "$ROOT/etc/onu-pppoe" ]; then
		(umask 077 && cp "$ROOT/etc/onu-pppoe" "$RUN/onu-pppoe1")
	fi
	apply
	;;
apply)
	if command -v onu-store >/dev/null; then
		onu-store save || log "the settings are applied but not saved"
	fi
	apply
	;;
stop)
	load
	mode=
	[ -r "$RUN/onu-mode" ] && read -r mode <"$RUN/onu-mode"
	if [ "$mode" = passthrough ]; then
		pass_down
	else
		router_down
	fi
	svc_stop omcid
	rm -f "$RUN/onu-mode" "$RUN/onu-omcid" "$RUN/onu-held-vlans" "$RUN/omcid.mode"
	;;
identity)
	identity
	;;
reidentify)
	reidentify
	;;
status)
	mode=
	[ -r "$RUN/onu-mode" ] && read -r mode <"$RUN/onu-mode"
	echo "mode ${mode:-none}"
	[ -r "$RUN/onu-wan" ] && read -r gem wan out <"$RUN/onu-wan" &&
		echo "wan $wan on $gem, out by $out"
	for d in "$SESSIONS"/*; do
		[ -r "$d/dev" ] || continue
		line="session ${d##*/} on $(cat "$d/dev") ($(cat "$d/family"))"
		[ -r "$d/ppp" ] && line="$line, up on $(cat "$d/ppp")"
		[ -r "$d/ipv4" ] && line="$line, $(cat "$d/ipv4")"
		echo "$line"
	done
	[ -s "$RUN/onu-dns" ] && echo "dns $(cat "$RUN/onu-dns")"
	for d in "$SESSIONS"/*; do
		[ -r "$d/pass" ] &&
			echo "pass $(cat "$d/pass") on $(cat "$d/lan") from session ${d##*/}"
	done
	exit 0
	;;
watch)
	watch
	;;
tick)
	tick
	;;
netmask)
	netmask "${2:-0}"
	;;
*)
	echo "usage: onu-mode start|apply|stop|identity|reidentify|status" >&2
	exit 2
	;;
esac
