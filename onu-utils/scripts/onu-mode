#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Paweł Phan <szop.hektar_1w@icloud.com>
#
# onu-mode: put the stick's data path in the shape its settings give: the
# OLT's bridge, or the stick's own PPPoE sessions with their addresses handed
# on, or, on a bench, a router.
#
#   onu-mode start    at boot: take the settings from /etc/onu.conf and apply
#   onu-mode apply    apply the settings of /run/onu.conf again, after a change,
#                     and keep them in the configuration store (onu-store)
#   onu-mode stop     stop omcid and take the router down
#   onu-mode identity give the PON driver the serial number and PLOAM
#                     password of /run/onu-identity and bring the PON up
#   onu-mode reidentify  take the PON down, give it the identity of
#                     /run/onu-identity, and register with the OLT again
#   onu-mode status   the shape in force, the WAN or the sessions, and the
#                     address handed on
#
# The settings are KEY=value lines in /run/onu.conf, which the status daemon
# rewrites; /etc/onu.conf has the defaults and says what each key means. The
# account of PPPoE session N, 1 to 7, is in /run/onu-pppoeN, as "user
# secret", readable by root only; /etc/onu-pppoe, if a bench's files carry
# one, seeds the first. At boot, onu-store has put the saved ones in these
# files before onu-mode starts.
#
# There is no mode to choose. Without a PPPoE account, omcid connects the host
# link to the PON as the OLT provisions it (bridge). With one or more, the
# stick holds the sessions itself (passthrough), and each session runs on a
# GEM port that the OLT provisioned, or on a VLAN on it, with the settings
# SESSIONn_GEM, SESSIONn_VLAN, SESSIONn_MAC and SESSIONn_FAMILY (ipv4, ipv6
# or both). Beside sessions in VLANs omcid still bridges the rest of what the
# OLT provisions, such as television and telephone, and leaves out the
# sessions' VLANs, which it reads from /run/onu-held-vlans; beside a session
# untagged on its GEM port, which holds the whole port, omcid leaves the OLT's
# bridge out (omcid -r).
# Sessions in one VLAN share its interface, wanVID, and the MAC of the first.
# The first session that carries IPv4 hands its address on, and its name
# servers; the others keep theirs on the stick. The first that carries IPv6
# hands its delegated prefix on, through dhcp6d, once its IPv6 is up. What a session has is in the
# directory /run/session/N: gem, dev and family, and once it is up ppp, ipv4
# and ipv6. MODE=router, kept for the bench, is the one setting of a shape.
#
# In bridge mode omcid connects the host link to the PON as the OLT
# provisions it. In router mode omcid leaves the OLT's bridge out (omcid -r)
# and the stick routes: the LAN is the host link, sfp, with an address and a
# DHCP server; the WAN is a GEM port that the OLT provisioned, or a VLAN on
# it, with an address by PPPoE, DHCP or by hand. The stick translates no
# address: a host on the LAN reaches beyond the WAN with an address that the
# network behind the WAN routes back to the stick. A watcher (onu-mode watch)
# brings the WAN up when the OLT provisions its GEM port and restarts the PPPoE
# or DHCP client when it ends.
#
# In passthrough, the address handed on goes on no interface of the stick's,
# and the one host on the LAN link, the router behind the stick, takes it by
# DHCP, as a /32 with PASS_GATEWAY, the stick's address on that link, as its
# gateway. The LAN link is a VLAN on the host link (LAN_VLAN), or the host
# link itself.
#
# ONU_ROOT names another root for the files it reads and writes, which the
# tests use.

set -u

ROOT=${ONU_ROOT:-}
RUN=$ROOT/run
CONF=$RUN/onu.conf
IDENTITY=$RUN/onu-identity
SESSIONS=$RUN/session
MAX_SESSIONS=7
NET=$ROOT/sys/class/net
FORWARD=$ROOT/proc/sys/net/ipv4/ip_forward
FORWARD6=$ROOT/proc/sys/net/ipv6/conf/all/forwarding
IPV6_CONF=$ROOT/proc/sys/net/ipv6/conf
SHARE=$ROOT/usr/share/onu

log() {
	echo "onu-mode: $*" >&2
	logger -t onu-mode "$*" 2>/dev/null
	return 0
}

# The settings: the defaults, then /run/onu.conf. A key that is not one of
# these and a value with characters no setting has are left out.
load() {
	MODE=bridge
	WAN_GEM=auto
	WAN_VLAN=
	WAN_PROTO=dhcp
	WAN_ADDRESS=
	WAN_GATEWAY=
	LAN_ADDRESS=192.168.1.1/24
	LAN_DHCP=on
	LAN_DHCP_START=192.168.1.100
	LAN_DHCP_END=192.168.1.199
	LAN_VLAN=
	PASS_GATEWAY=169.254.0.1
	WAN_MAC=
	n=1
	while [ $n -le $MAX_SESSIONS ]; do
		eval "SESSION${n}_GEM= SESSION${n}_VLAN= SESSION${n}_MAC= SESSION${n}_FAMILY="
		n=$((n + 1))
	done
	if [ -r "$CONF" ]; then
		load_file
	fi
	# The single session of before: its settings were the WAN's.
	[ -n "$SESSION1_GEM" ] || SESSION1_GEM=$WAN_GEM
	[ -n "$SESSION1_VLAN" ] || SESSION1_VLAN=$WAN_VLAN
	[ -n "$SESSION1_MAC" ] || SESSION1_MAC=$WAN_MAC
	return 0
}

load_file() {
	while IFS='=' read -r key value; do
		case $key in
		MODE | WAN_GEM | WAN_VLAN | WAN_PROTO | WAN_ADDRESS | WAN_GATEWAY | \
			LAN_ADDRESS | LAN_DHCP | LAN_DHCP_START | LAN_DHCP_END | \
			LAN_VLAN | PASS_GATEWAY | WAN_MAC) ;;
		SESSION[1-7]_GEM | SESSION[1-7]_VLAN | SESSION[1-7]_MAC | \
			SESSION[1-7]_FAMILY) ;;
		*) continue ;;
		esac
		case $value in
		*[!A-Za-z0-9./:_-]*)
			log "$key: not a value; the default stays"
			continue
			;;
		esac
		eval "$key=\$value"
	done <"$CONF"
}

# Setting $2 of session $1.
setting() {
	eval "echo \"\${SESSION$1_$2}\""
}

# The sessions that have an account, by number.
sessions() {
	n=1
	while [ $n -le $MAX_SESSIONS ]; do
		[ -s "$RUN/onu-pppoe$n" ] && echo $n
		n=$((n + 1))
	done
}

# The family of session $1: ipv4, ipv6 or both.
family() {
	f=$(setting "$1" FAMILY)
	case $f in
	ipv4 | ipv6 | both) echo "$f" ;;
	*) echo both ;;
	esac
}

# The session that hands its delegated IPv6 prefix on: the first that
# carries IPv6.
pd_session() {
	for n in $(sessions); do
		case $(family "$n") in
		ipv6 | both)
			echo "$n"
			return 0
			;;
		esac
	done
}

# The session that hands its IPv4 address on: the first that carries IPv4.
pass_session() {
	for n in $(sessions); do
		case $(family "$n") in
		ipv4 | both)
			echo "$n"
			return 0
			;;
		esac
	done
}

# The dotted mask of a prefix length.
netmask() {
	bits=$1
	mask=
	for octet in 1 2 3 4; do
		if [ "$bits" -ge 8 ]; then
			n=255
			bits=$((bits - 8))
		else
			n=$((256 - (1 << (8 - bits))))
			[ "$bits" -eq 0 ] && n=0
			bits=0
		fi
		mask=$mask${mask:+.}$n
	done
	echo "$mask"
}

pid_of() {
	[ -r "$RUN/$1.pid" ] && cat "$RUN/$1.pid"
}

stop_pid() {
	pid=$(pid_of "$1")
	[ -n "$pid" ] && kill "$pid" 2>/dev/null
	rm -f "$RUN/$1.pid"
}

# omcid in the mode $1. A running omcid is told by a signal, SIGUSR2 for
# bridge mode and SIGUSR1 for the others, where the stick routes: it keeps its
# MIB, so what the OLT provisioned stays, and programs the data path again
# from it. One that does not run is started, with -r where the stick routes;
# its log goes on in /run/omcid.log.
omcid_run() {
	if pidof omcid >/dev/null 2>&1; then
		if [ "$1" = bridge ]; then
			killall -USR2 omcid
		else
			killall -USR1 omcid
		fi
		sleep 1
	elif [ "$1" = bridge ]; then
		omcid >>"$RUN/omcid.log" 2>&1 &
	else
		omcid -r >>"$RUN/omcid.log" 2>&1 &
	fi
}

# The VLANs the sessions hold, by their VID on the PON side, one a line; none,
# with status 1, when a session runs untagged on its GEM port.
held_vlans() {
	out=
	for n in $(sessions); do
		v=$(setting "$n" VLAN)
		[ -n "$v" ] || return 1
		out="$out $v"
	done
	echo $out | tr ' ' '\n' | sort -un
}

# What omcid is to do in the mode $MODE: "bridge", the OLT's bridge whole;
# "held VID...", the OLT's bridge without the VLANs the sessions hold;
# "router", without the OLT's bridge, in the bench's router mode and beside a
# session that holds a whole GEM port.
omcid_want() {
	case $MODE in
	bridge) echo bridge ;;
	router) echo router ;;
	*)
		if held=$(held_vlans); then
			echo held $held
		else
			echo router
		fi
		;;
	esac
}

# Bring omcid to $1, as omcid_want() gives it, from what it was told last.
# omcid reads the held VLANs from /run/onu-held-vlans; for them its bridge is
# taken down first, so that it builds it again without what it leaves out
# now. Back to the whole bridge it adds what it left out.
omcid_sync() {
	[ "$1" = "$(cat "$RUN/onu-omcid" 2>/dev/null)" ] && return 0
	case $1 in
	held\ *)
		echo "${1#held }" | tr ' ' '\n' >"$RUN/onu-held-vlans"
		bridge_down
		omcid_run bridge
		;;
	bridge)
		rm -f "$RUN/onu-held-vlans"
		omcid_run bridge
		;;
	*)
		rm -f "$RUN/onu-held-vlans"
		omcid_run router
		bridge_down
		;;
	esac
	echo "$1" >"$RUN/onu-omcid"
}

# What omcid built in bridge mode: the bridge and its VLAN rules, the filters
# from priority 1000 up on the ingress of sfp and pon. The filters of the
# management VLAN, which the boot put at priority 1 of the same qdiscs, stay:
# they keep that VLAN off the PON in every mode.
bridge_down() {
	ip link del omcibr0 2>/dev/null
	for dev in sfp pon; do
		for pref in $(tc filter show dev "$dev" ingress 2>/dev/null |
			awk '{ for (i = 1; i < NF; i++)
				if ($i == "pref" && $(i + 1) >= 1000) print $(i + 1) }' |
			sort -u); do
			tc filter del dev "$dev" ingress pref "$pref" 2>/dev/null
		done
	done
	return 0
}

# The GEM interface for the setting $1: gemN for N, or for auto (or nothing)
# the one of the lowest Port-ID but 4095, which OLTs give to multicast.
gem_of() {
	if [ -n "$1" ] && [ "$1" != auto ]; then
		[ -e "$NET/gem$1" ] && echo "gem$1"
		return 0
	fi
	for id in $(ls "$NET" 2>/dev/null | sed -n 's/^gem\([0-9][0-9]*\)$/\1/p' | sort -n); do
		[ "$id" = 4095 ] && continue
		echo "gem$id"
		return 0
	done
}

wan_gem() {
	gem_of "$WAN_GEM"
}

# The DHCP server of the LAN, with the WAN's name servers when they are known.
lan_dhcp() {
	stop_pid udhcpd
	[ "$LAN_DHCP" = on ] || return 0
	{
		echo "interface sfp"
		echo "start $LAN_DHCP_START"
		echo "end $LAN_DHCP_END"
		echo "lease_file $RUN/udhcpd.leases"
		echo "pidfile $RUN/udhcpd.pid"
		echo "opt router ${LAN_ADDRESS%/*}"
		echo "opt subnet $(netmask "${LAN_ADDRESS#*/}")"
		[ -s "$RUN/onu-dns" ] && echo "opt dns $(cat "$RUN/onu-dns")"
		echo "opt lease 3600"
	} >"$RUN/udhcpd.conf"
	[ -e "$RUN/udhcpd.leases" ] || : >"$RUN/udhcpd.leases"
	cp "$RUN/onu-dns" "$RUN/udhcpd.dns" 2>/dev/null || rm -f "$RUN/udhcpd.dns"
	udhcpd "$RUN/udhcpd.conf"
}

# One run of pppoed for session $1 on $2, with the options $3; its process id
# goes to /run/pppoedN.pid, for session_down().
pppoe_client() {
	# $3 is a list of options, split on purpose.
	sh -c 'echo $$ >"$0"; exec "$@"' "$RUN/pppoed$1.pid" \
		pppoed up -i "$2" -f "$RUN/onu-pppoe$1" $3
}

# What session $1 has: the fact $2 with the value $3, or none without one.
note() {
	[ -d "$SESSIONS/$1" ] || return 0
	if [ -n "${3:-}" ]; then
		echo "$3" >"$SESSIONS/$1/$2"
	else
		rm -f "$SESSIONS/$1/$2"
	fi
}

# The delegated IPv6 prefix of session $1, whose link $2 came up on its
# interface $3, handed on to the host by dhcp6d: the link to the host gets
# IPv6, and the stick forwards it.
pd_up() {
	lan=$(cat "$RUN/onu-lan" 2>/dev/null)
	[ -n "$lan" ] || return 0
	stop_pid "dhcp6d$1"
	echo 0 >"$IPV6_CONF/$lan/disable_ipv6" 2>/dev/null
	echo 1 >"$FORWARD6" 2>/dev/null
	dhcp6d -w "$2" -l "$lan" -m "$3" -o "$SESSIONS/$1" 2>>"$RUN/dhcp6d.log" &
	echo $! >"$RUN/dhcp6d$1.pid"
	log "session $1: its IPv6 prefix goes to the router on $lan"
}

# The PPPoE client of session $1 on $2, with the options $3, started again
# whenever the link ends. In the role $4, "pass", its "up" line gives the
# name servers and the address the router takes, until the link ends; in
# "primary" the name servers alone. With $5, "pd", its "up6" line starts
# dhcp6d, which hands the session's delegated IPv6 prefix on.
pppoe_loop() {
	while :; do
		pppoe_client "$1" "$2" "$3" 2>>"$RUN/pppoed.log" |
			while read -r word dev _ addr _ _ _ _ _ dns1 dns2; do
				case $word in
				up6)
					note "$1" ppp "$dev"
					note "$1" ipv6 "$addr"
					log "session $1: IPv6 up on $dev"
					[ "$5" = pd ] && pd_up "$1" "$dev" "$2"
					continue
					;;
				up) ;;
				*) continue ;;
				esac
				note "$1" ppp "$dev"
				note "$1" ipv4 "$addr"
				if [ "$4" != none ]; then
					dns=$(echo "$dns1 $dns2" | sed 's/ *- *//g')
					if [ -n "$dns" ]; then
						echo "$dns" >"$RUN/onu-dns"
					else
						rm -f "$RUN/onu-dns"
					fi
				fi
				[ "$4" = pass ] && pass_lease "$addr" "$dev"
				log "session $1: IPv4 up on $dev"
			done
		note "$1" ppp
		note "$1" ipv4
		note "$1" ipv6
		[ "$5" = pd ] && stop_pid "dhcp6d$1"
		[ "$4" = pass ] && pass_lease_down
		sleep 5
	done
}

# The address $1 of the PPPoE session on $2 handed on: a host route to it on
# the LAN link, and a DHCP server that leases it alone, as a /32 with the
# stick as the gateway, the session's name servers and its MTU. A lease runs
# for a minute: the router asks again before it ends, so it finds a new
# address of a new session that soon.
pass_lease() {
	lan=$(cat "$RUN/onu-lan" 2>/dev/null)
	[ -n "$lan" ] || return 0
	stop_pid udhcpd
	[ "$(cat "$RUN/onu-pass" 2>/dev/null)" = "$1" ] || rm -f "$RUN/udhcpd.leases"
	ip route replace "$1" dev "$lan"
	mtu=$(cat "$NET/$2/mtu" 2>/dev/null)
	{
		echo "interface $lan"
		echo "start $1"
		echo "end $1"
		echo "max_leases 1"
		echo "lease_file $RUN/udhcpd.leases"
		echo "pidfile $RUN/udhcpd.pid"
		echo "opt subnet 255.255.255.255"
		echo "opt router $PASS_GATEWAY"
		echo "opt staticroutes $PASS_GATEWAY/32 0.0.0.0, 0.0.0.0/0 $PASS_GATEWAY"
		[ -s "$RUN/onu-dns" ] && echo "opt dns $(cat "$RUN/onu-dns")"
		[ -n "$mtu" ] && echo "opt mtu $mtu"
		echo "opt lease 60"
	} >"$RUN/udhcpd.conf"
	[ -e "$RUN/udhcpd.leases" ] || : >"$RUN/udhcpd.leases"
	echo "$1" >"$RUN/onu-pass"
	udhcpd "$RUN/udhcpd.conf"
	log "the session's address goes to the router on $lan"
}

# The handed address taken back, when its session ends.
pass_lease_down() {
	addr=$(cat "$RUN/onu-pass" 2>/dev/null)
	lan=$(cat "$RUN/onu-lan" 2>/dev/null)
	stop_pid udhcpd
	if [ -n "$addr" ] && [ -n "$lan" ]; then
		ip route del "$addr" dev "$lan" 2>/dev/null
	fi
	rm -f "$RUN/onu-pass"
	return 0
}

# Room for PPPoE's 8 bytes of headers around a 1500-byte packet (RFC 4638) on
# the PON port, the GEM interface $1 and the WAN interface $2, as far as each
# takes it: pppoed asks the concentrator for 1500 bytes, and keeps to 1492
# when the interface has no room or the concentrator does not agree.
pppoe_mtu() {
	for mtu_dev in pon "$1" "$2"; do
		ip link set "$mtu_dev" mtu 1508 2>/dev/null || return 0
	done
}

# Bring the WAN up on the GEM interface $1.
wan_up() {
	gem=$1
	wan=$gem
	ip link set "$gem" up
	if [ -n "$WAN_VLAN" ]; then
		ip link add link "$gem" name wan type vlan id "$WAN_VLAN"
		wan=wan
	fi
	if [ -n "$WAN_MAC" ]; then
		ip link set "$wan" address "$WAN_MAC" ||
			log "the WAN did not take its MAC address"
	fi
	[ "$wan" = wan ] && ip link set wan up
	out=$wan
	case $WAN_PROTO in
	pppoe)
		pppoe_mtu "$gem" "$wan"
		pppoe_loop 1 "$wan" -D primary none &
		echo $! >"$RUN/pppoe-loop1.pid"
		out=ppp0
		;;
	static)
		ip address add "$WAN_ADDRESS" dev "$wan"
		ip route replace default via "$WAN_GATEWAY" dev "$wan"
		;;
	*)
		udhcpc -i "$wan" -b -p "$RUN/udhcpc.pid" -s "$SHARE/dhcp-wan"
		;;
	esac
	echo "$gem $wan $out" >"$RUN/onu-wan"
	feeds_sync "$gem"
	log "WAN on $wan ($WAN_PROTO), GEM port ${gem#gem}"
}

# The GEM ports that only carry downstream, the multicast one among them,
# other than the WAN's $1. In bridge mode omcid bridges them with the host
# link; in router mode what they carry is the WAN's: the OLT sends the network
# side's broadcasts, an ARP request for the WAN's address among them, by the
# multicast GEM port, and an answer by that port, which cannot send, is lost.
# So their frames are handed to the WAN's GEM interface as they come in. Beside
# the OLT's bridge, which carries those ports' other VLANs, only the frames of
# the sessions' VLANs are: feeds_sync TO [VID:GEM...] hands every frame to the
# GEM interface TO, or, with pairs, the frames of each VID to its GEM
# interface.
feeds_sync() {
	to=$1
	shift
	ports=$(pon gem 2>/dev/null | awk -v wan="$to" '$1 != wan && $4 == "down" { print $1 }' |
		sort)
	key=$(echo "$to" $ports "$@")
	[ "$key" = "$(cat "$RUN/onu-feeds.key" 2>/dev/null)" ] && return 0
	feeds_down
	for port in $ports; do
		tc qdisc add dev "$port" clsact 2>/dev/null
		if [ $# -eq 0 ]; then
			tc filter add dev "$port" ingress matchall action mirred ingress \
				redirect dev "$to"
		else
			for pair; do
				tc filter add dev "$port" ingress protocol 802.1Q flower \
					vlan_id "${pair%%:*}" action mirred ingress redirect \
					dev "${pair#*:}"
			done
		fi && echo "$port" >>"$RUN/onu-feeds"
	done
	echo "$key" >"$RUN/onu-feeds.key"
}

feeds_down() {
	for port in $(cat "$RUN/onu-feeds" 2>/dev/null); do
		tc qdisc del dev "$port" clsact 2>/dev/null
	done
	rm -f "$RUN/onu-feeds" "$RUN/onu-feeds.key"
	return 0
}

wan_down() {
	gem= wan=
	[ -r "$RUN/onu-wan" ] && read -r gem wan _ <"$RUN/onu-wan"
	stop_pid pppoe-loop1
	stop_pid pppoed1
	stop_pid udhcpc
	feeds_down
	# What a static or DHCP WAN put on the interface goes with it.
	if [ -n "$wan" ]; then
		ip -4 route flush dev "$wan" 2>/dev/null
		ip -4 address flush dev "$wan" 2>/dev/null
	fi
	ip link del wan 2>/dev/null
	# What pppoe_mtu() raised goes back to Ethernet's MTU, the PON port last.
	if [ -n "$gem" ]; then
		ip link set "$gem" mtu 1500 2>/dev/null
		ip link set pon mtu 1500 2>/dev/null
	fi
	rm -f "$RUN/onu-wan" "$RUN/onu-dns"
	return 0
}

# The interface of session $1 on the GEM interface $2: the GEM interface
# itself, or wanVID for a VLAN.
session_dev() {
	vlan=$(setting "$1" VLAN)
	if [ -n "$vlan" ]; then
		echo "wan$vlan"
	else
		echo "$2"
	fi
}

# Whether a running session other than $1 is on the interface $2.
dev_shared() {
	for d in "$SESSIONS"/*/dev; do
		[ -r "$d" ] || continue
		[ "$d" = "$SESSIONS/$1/dev" ] && continue
		[ "$(cat "$d")" = "$2" ] && return 0
	done
	return 1
}

# Session $1 up on the GEM interface $2: its interface, made for the first
# session on it, room for PPPoE's headers, and its client.
session_up() {
	n=$1 gem=$2
	dev=$(session_dev "$n" "$gem")
	fam=$(family "$n")
	if ! dev_shared "$n" "$dev"; then
		ip link set "$gem" up
		if [ "$dev" != "$gem" ]; then
			ip link add link "$gem" name "$dev" type vlan id "$(setting "$n" VLAN)"
		fi
		mac=$(setting "$n" MAC)
		if [ -n "$mac" ]; then
			ip link set "$dev" address "$mac" ||
				log "session $n: the interface did not take its MAC address"
		fi
		[ "$dev" != "$gem" ] && ip link set "$dev" up
		pppoe_mtu "$gem" "$dev"
	fi
	mkdir -p "$SESSIONS/$n"
	echo "$gem" >"$SESSIONS/$n/gem"
	echo "$dev" >"$SESSIONS/$n/dev"
	echo "$fam" >"$SESSIONS/$n/family"
	opts= role=none
	case $fam in
	ipv4) opts=-4 ;;
	ipv6) opts=-6 ;;
	esac
	if [ "$n" = "$(pass_session)" ]; then
		opts="-D $opts -P"
		role=pass
		echo "$n" >"$RUN/onu-pass-session"
	fi
	role6=none
	[ "$n" = "$(pd_session)" ] && role6=pd
	pppoe_loop "$n" "$dev" "$opts" "$role" "$role6" &
	echo $! >"$RUN/pppoe-loop$n.pid"
	log "session $n on $dev ($fam), GEM port ${gem#gem}"
}

# Whether a running session other than $1 is on the GEM interface $2.
gem_shared() {
	for g in "$SESSIONS"/*/gem; do
		[ -r "$g" ] || continue
		[ "$g" = "$SESSIONS/$1/gem" ] && continue
		[ "$(cat "$g")" = "$2" ] && return 0
	done
	return 1
}

# Session $1 down: its client, which ends the session with the concentrator,
# and its interface when no other session is on it. Its names are its own:
# the watcher's round holds the GEM port it goes up on next.
session_down() {
	[ -r "$SESSIONS/$1/dev" ] || return 0
	read -r down_dev <"$SESSIONS/$1/dev"
	read -r down_gem <"$SESSIONS/$1/gem"
	stop_pid "pppoe-loop$1"
	stop_pid "pppoed$1"
	stop_pid "dhcp6d$1"
	if [ "$1" = "$(cat "$RUN/onu-pass-session" 2>/dev/null)" ]; then
		pass_lease_down
		rm -f "$RUN/onu-pass-session"
	fi
	if ! dev_shared "$1" "$down_dev"; then
		[ "$down_dev" != "$down_gem" ] && ip link del "$down_dev" 2>/dev/null
		# What pppoe_mtu() raised goes back to Ethernet's MTU, the PON port
		# last, once no session is on the GEM port.
		gem_shared "$1" "$down_gem" || ip link set "$down_gem" mtu 1500 2>/dev/null
	fi
	rm -rf "${SESSIONS:?}/$1"
	[ -n "$(ls "$SESSIONS" 2>/dev/null)" ] || ip link set pon mtu 1500 2>/dev/null
	log "session $1 down"
	return 0
}

sessions_down() {
	for d in "$SESSIONS"/*; do
		[ -d "$d" ] && session_down "${d##*/}"
	done
	feeds_down
	rm -f "$RUN/onu-dns"
	return 0
}

# One round of the watcher in passthrough: each session follows its GEM port,
# and a session without its account any more goes.
sessions_tick() {
	want=" $(sessions | tr '\n' ' ')"
	n=1
	while [ $n -le $MAX_SESSIONS ]; do
		cur=
		[ -r "$SESSIONS/$n/gem" ] && read -r cur <"$SESSIONS/$n/gem"
		case $want in
		*" $n "*)
			gem=$(gem_of "$(setting "$n" GEM)")
			if [ -n "$gem" ] && [ "$gem" != "$cur" ]; then
				[ -n "$cur" ] && session_down "$n"
				session_up "$n" "$gem"
			elif [ -z "$gem" ] && [ -n "$cur" ]; then
				log "session $n: its GEM port is gone"
				session_down "$n"
			fi
			;;
		*)
			[ -n "$cur" ] && session_down "$n"
			;;
		esac
		n=$((n + 1))
	done
	first=$(cat "$SESSIONS"/*/gem 2>/dev/null | head -n 1)
	if [ -z "$first" ]; then
		feeds_down
	elif held_vlans >/dev/null; then
		pairs=
		for d in "$SESSIONS"/*; do
			[ -r "$d/gem" ] || continue
			read -r g <"$d/gem"
			pairs="$pairs $(setting "${d##*/}" VLAN):$g"
		done
		feeds_sync "$first" $(echo $pairs | tr ' ' '\n' | sort -u)
	else
		feeds_sync "$first"
	fi
}

# One round of the watcher: in router mode the WAN follows its GEM port, and
# the DHCP server follows the name servers; in passthrough the sessions.
tick() {
	load
	if [ "$(cat "$RUN/onu-mode" 2>/dev/null)" = passthrough ]; then
		sessions_tick
		return 0
	fi
	gem=$(wan_gem)
	cur=
	[ -r "$RUN/onu-wan" ] && read -r cur _ <"$RUN/onu-wan"
	if [ -n "$gem" ] && [ "$gem" != "$cur" ]; then
		[ -n "$cur" ] && wan_down
		wan_up "$gem"
	elif [ -z "$gem" ] && [ -n "$cur" ]; then
		log "GEM port of the WAN gone"
		wan_down
	elif [ -n "$cur" ]; then
		feeds_sync "$cur"
	fi
	if [ "$MODE" = router ] && [ -s "$RUN/onu-dns" ] &&
		[ "$(cat "$RUN/onu-dns")" != "$(cat "$RUN/udhcpd.dns" 2>/dev/null)" ]; then
		lan_dhcp
	fi
}

# The watcher outlives the shell that started it: an "onu-mode apply" from a
# login ends with the login, and its hangup must not take the sessions'
# watcher along.
watch() {
	trap '' HUP
	echo $$ >"$RUN/onu-watch.pid"
	while :; do
		tick
		sleep 5
	done
}

router_up() {
	echo 1 >"$FORWARD"
	ip address add "$LAN_ADDRESS" dev sfp 2>/dev/null
	lan_dhcp
	# The tests run the watcher's rounds themselves.
	[ -n "${ONU_MODE_NO_WATCH:-}" ] || "$0" watch &
}

router_down() {
	stop_pid onu-watch
	wan_down
	stop_pid udhcpd
	[ -n "$LAN_ADDRESS" ] && ip address del "$LAN_ADDRESS" dev sfp 2>/dev/null
	echo 0 >"$FORWARD"
	return 0
}

# Passthrough mode: the LAN link, a VLAN on the host link or the host link
# itself, with the stick's address on it; the session's address comes later.
pass_up() {
	echo 1 >"$FORWARD"
	lan=sfp
	if [ -n "$LAN_VLAN" ]; then
		ip link add link sfp name lan type vlan id "$LAN_VLAN"
		ip link set lan up
		lan=lan
	fi
	ip address add "$PASS_GATEWAY/32" dev "$lan"
	echo "$lan" >"$RUN/onu-lan"
	[ -n "${ONU_MODE_NO_WATCH:-}" ] || "$0" watch &
}

pass_down() {
	stop_pid onu-watch
	sessions_down
	pass_lease_down
	rm -f "$RUN/onu-pass-session"
	lan=$(cat "$RUN/onu-lan" 2>/dev/null)
	[ -n "$lan" ] && ip address del "$PASS_GATEWAY/32" dev "$lan" 2>/dev/null
	ip link del lan 2>/dev/null
	rm -f "$RUN/onu-lan"
	echo 0 >"$FORWARD"
	echo 0 >"$FORWARD6" 2>/dev/null
	return 0
}

# The identity to the PON driver, which takes it while the PON is down, then
# the PON up. Twenty hex digits of PLOAM password are its ten octets.
identity() {
	serial=$(grep '^serial=' "$IDENTITY" 2>/dev/null | cut -d= -f2)
	ploam=$(grep '^ploam_password=' "$IDENTITY" 2>/dev/null | cut -d= -f2-)
	dev=$(devlink dev show 2>/dev/null | head -n 1)
	if [ -z "$serial" ] || [ -z "$dev" ]; then
		log "no serial number: the PON stays down"
		return 1
	fi
	devlink dev param set "$dev" name gpon_serial cmode runtime value "$serial" ||
		log "the PON driver did not take the serial number"
	if [ -n "$ploam" ]; then
		case $ploam in
		*[!0-9A-Fa-f]*) ;;
		*) [ ${#ploam} -eq 20 ] && ploam=0x$ploam ;;
		esac
		devlink dev param set "$dev" name gpon_password cmode runtime value "$ploam" ||
			log "the PON driver did not take the PLOAM password"
	fi
	ip link set pon up || log "the PON does not come up"
}

# A new identity: the OLT sees the stick leave and a new one arrive, and
# omcid starts over with the MIB the OLT builds for it.
reidentify() {
	ip link set pon down
	identity || return 1
	want=
	[ -r "$RUN/onu-omcid" ] && read -r want _ <"$RUN/onu-omcid"
	killall omcid 2>/dev/null
	case $want in
	router) omcid_run router ;;
	*) omcid_run bridge ;;
	esac
	log "registering again"
}

apply() {
	old=
	[ -r "$RUN/onu-mode" ] && read -r old <"$RUN/onu-mode"
	if [ "$old" = router ] || [ "$old" = passthrough ]; then
		# Down with the settings it came up with.
		[ -r "$RUN/onu-mode.conf" ] && CONF=$RUN/onu-mode.conf
		load
		if [ "$old" = router ]; then
			router_down
		else
			pass_down
		fi
		CONF=$RUN/onu.conf
	fi
	load
	# Only the bench's router is chosen; otherwise an account makes the
	# stick hold its sessions, and none leaves the OLT's bridge.
	if [ "$MODE" != router ]; then
		if [ -n "$(sessions)" ]; then
			MODE=passthrough
		else
			MODE=bridge
		fi
	fi
	omcid_sync "$(omcid_want)"
	echo "$MODE" >"$RUN/onu-mode"
	case $MODE in
	router) router_up ;;
	passthrough) pass_up ;;
	esac
	cp "$CONF" "$RUN/onu-mode.conf" 2>/dev/null
	log "$MODE mode"
}

case ${1:-} in
start)
	[ -e "$CONF" ] || cp "$ROOT/etc/onu.conf" "$CONF" 2>/dev/null || : >"$CONF"
	if [ -z "$(sessions)" ] && [ -r "$ROOT/etc/onu-pppoe" ]; then
		(umask 077 && cp "$ROOT/etc/onu-pppoe" "$RUN/onu-pppoe1")
	fi
	apply
	;;
apply)
	if command -v onu-store >/dev/null; then
		onu-store save || log "the settings are applied but not saved"
	fi
	apply
	;;
stop)
	load
	mode=
	[ -r "$RUN/onu-mode" ] && read -r mode <"$RUN/onu-mode"
	if [ "$mode" = passthrough ]; then
		pass_down
	else
		router_down
	fi
	killall omcid 2>/dev/null
	rm -f "$RUN/onu-mode" "$RUN/onu-omcid" "$RUN/onu-held-vlans"
	;;
identity)
	identity
	;;
reidentify)
	reidentify
	;;
status)
	mode=
	[ -r "$RUN/onu-mode" ] && read -r mode <"$RUN/onu-mode"
	echo "mode ${mode:-none}"
	[ -r "$RUN/onu-wan" ] && read -r gem wan out <"$RUN/onu-wan" &&
		echo "wan $wan on $gem, out by $out"
	for d in "$SESSIONS"/*; do
		[ -r "$d/dev" ] || continue
		line="session ${d##*/} on $(cat "$d/dev") ($(cat "$d/family"))"
		[ -r "$d/ppp" ] && line="$line, up on $(cat "$d/ppp")"
		[ -r "$d/ipv4" ] && line="$line, $(cat "$d/ipv4")"
		echo "$line"
	done
	[ -s "$RUN/onu-dns" ] && echo "dns $(cat "$RUN/onu-dns")"
	[ -s "$RUN/onu-pass" ] &&
		echo "pass $(cat "$RUN/onu-pass") on $(cat "$RUN/onu-lan" 2>/dev/null)"
	exit 0
	;;
watch)
	watch
	;;
tick)
	tick
	;;
netmask)
	netmask "${2:-0}"
	;;
*)
	echo "usage: onu-mode start|apply|stop|identity|reidentify|status" >&2
	exit 2
	;;
esac
