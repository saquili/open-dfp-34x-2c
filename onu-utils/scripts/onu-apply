#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Paweł Phan <szop.hektar_1w@icloud.com>
#
# onu-apply: put the stick's data path in the shape its settings give: the
# OLT's bridge, and the stick's own PPPoE sessions with their addresses handed
# on.
#
#   onu-apply start    at boot: take the settings of /run/onu.conf and apply
#   onu-apply reload   apply the settings of /run/onu.conf again, after a change,
#                      and keep them in the configuration store (onu-config)
#   onu-apply try      apply them on trial: unconfirmed in 90 s (TRIAL_LIMIT),
#                      the stick goes back to the settings it had
#   onu-apply confirm  keep the change on trial, in the store as well
#   onu-apply revert   end the trial now, back to the settings it had
#   onu-apply stop     take the sessions down and stop omcid
#   onu-apply identity give the PON driver the serial number and PLOAM
#                      password of /run/onu-identity and bring the PON up
#   onu-apply reidentify  take the PON down, give it the identity of
#                      /run/onu-identity, and register with the OLT again
#   onu-apply status   the shape in force, the sessions, and the address
#                      handed on
#   onu-apply iface    what netifd runs for an event of an interface (netifd
#                      -h), with ACTION, INTERFACE and DEVICE: a session's
#                      interface that comes up hands on what it brought
#   onu-apply guard    the filters that keep the sessions' packets off the
#                      host side again, after the management pair changed
#   onu-apply state    the state last brought up, as lines name=value for the
#                      status daemon (state() below)
#   onu-apply sync     follow what changed outside the settings: the GEM
#                      ports and VLANs the OLT provisions, the host's IPv6
#                      binding; omcid (-x) and dhcp6d (-x) run it as
#                      "onu-apply omcid" and "onu-apply dhcp6d"
#
# One onu-apply at a time changes the stick; the others wait for it.
#
# The settings are KEY=value lines in /run/onu.conf, which onu-config writes
# from the store at boot and at a change; /etc/onu.conf says what each key
# means, and the default of a key is the table of onu-config (onu-config
# defaults). The account of PPPoE session N, 1 to 7, is in /run/onu-pppoeN,
# as "user secret", readable by root and pppoed only; /etc/onu-pppoe, if a bench's files carry
# one, seeds the first. At boot, onu-config has put the saved ones in these
# files before onu-apply starts.
#
# There is no mode to choose. Without a PPPoE account, omcid connects the host
# link to the PON as the OLT provisions it (bridge). With one or more, the
# stick holds the sessions itself (passthrough), and each session runs on a
# GEM port that the OLT provisioned, or on a VLAN on it, with the settings
# SESSIONn_GEM, SESSIONn_VLAN, SESSIONn_MAC and SESSIONn_FAMILY (ipv4, ipv6
# or both), and hands its address down to the host or keeps it on the stick,
# SESSIONn_PASS (on or off), in the VLAN of the host link SESSIONn_HOST_VLAN
# names (nothing for the session's own VLAN, untagged for none). Beside sessions in VLANs omcid still bridges the rest of what the
# OLT provisions, such as television and telephone, and leaves out the
# sessions' VLANs, which it reads from /run/onu-held-vlans. A session's VLAN
# may be the subscriber's VID of a translation the OLT provisions, the VID a
# router behind the stick would use: the session then runs in the VID it
# leads into, as omcid publishes it (/run/omcid/xlate), and a session whose
# GEM port is auto runs on the GEM port that the OLT lets that VID through
# (/run/omcid/gem-vlans): the session follows its service when the OLT
# moves it to another VID or another GEM port. Beside a session
# untagged on its GEM port, which holds the whole port, omcid leaves the OLT's
# bridge out (omcid -r).
# Sessions in one VLAN share its interface, wanVID, and the MAC of the first.
# In each VLAN towards the host, the first session told to hand down that
# carries IPv4 hands its address and its name servers down, and the first
# that carries IPv6 its delegated prefix, through dhcp6d, once its IPv6 is
# up; the others keep theirs on the stick. What a session has is in the
# directory /run/session/N: gem, dev and family, hands, the families it hands
# down ("ipv4 ipv6", one of them or nothing), role, lan where it hands down,
# and once it is up ppp, ipv4, peer, ipv6 and dns, which pppoed writes, and
# pass and gateway once its address went down. Each session is an interface
# of netifd, sesN, of the protocol "pppoed": netifd keeps pppoed and starts it
# again when it ends, puts what the session brought in place, and runs
# "onu-apply iface" when the interface comes up or goes down (ADR 0014).
# In passthrough, the address handed down goes on no interface of the
# stick's, and the one host on its link, the router behind the stick, takes
# it by DHCP, as a /32 with the concentrator's address as its gateway. Each
# VLAN the sessions hand down in is a link of its own, lanVID on the host
# link, or the host link itself for none. netifd holds the links with their
# addresses and checks, the part "links" of its configuration, and what each
# session hands down, its route, proxy ARP entry and table, the part
# "pass-N" (onu-net).
#
# A local network, N from 1 to 8, routes the devices of the host side out by
# a session that keeps its address on the stick, LANn_CONN=pppoe:S: a VLAN of
# the host link, netN, or the host link itself, with the stick's address in
# the network, LANn_ADDRESS; a rule sends what comes from the network to the
# session's table, which holds the session's default route and the routes to
# all of the networks, so that the networks reach each other without the
# session; and a DHCP server, udhcpd-netN, leases its addresses, LANn_POOL_FROM
# to LANn_POOL_TO, for LANn_LEASE seconds, with the stick as the router, the
# session's name servers, and the fixed address of each device FIXEDk gives
# ("N/MAC/IP"), its leases in /run/udhcpd-netN.leases. netifd holds the
# networks, their rules and routes, the part "nets"; the NAT through which the
# networks go out, and the protection that keeps the internet's new
# connections from them, is onu-fw's table of nf_tables (lans_fw()).
#
# ONU_ROOT names another root for the files it reads and writes, which the
# tests use.

set -u

ROOT=${ONU_ROOT:-}
RUN=$ROOT/run
CONF=$RUN/onu.conf
IDENTITY=$RUN/onu-identity
SESSIONS=$RUN/session
MAX_SESSIONS=7
MAX_LANS=8
# The priorities of the filters on sfp and pon are the registry's
# (omcid/target/tcprio.h): omcid's VLAN rules take those from VLAN_PREF up,
# and the management VLAN's, below, are onu-mgmt's alone. The drops on a
# session's own interface take 1 to GUARD_PREFS of it, and no other writer
# has that interface.
VLAN_PREF=1000
GUARD_PREFS=9
NET=$ROOT/sys/class/net
FORWARD=$ROOT/proc/sys/net/ipv4/ip_forward
FORWARD6=$ROOT/proc/sys/net/ipv6/conf/all/forwarding
# The helpers of this tree that only other programs run, out of a person's
# way (ADR 0015).
LIB=$ROOT/usr/lib/onu
PATH=$PATH:$LIB
# Starts a program as an account of its own with the powers it needs, and the
# program that tells this one of a change (onu-call), which a program that is
# not root's runs.
DROP=$LIB/onu-drop
CALL=$LIB/onu-call
SVC_DIR=$RUN/onu-svc.d
# The stick's own address on a link to the host, from which its DHCP server
# answers; the host is given the concentrator's address as its gateway.
LINK_ADDRESS=169.254.0.1
# Itself, which omcid and dhcp6d run when something changes.
case $0 in
/*) SELF=$0 ;;
*) SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0") ;;
esac
LOCK=$RUN/onu-apply.lock
AGAIN=$RUN/onu-apply.again
# The settings last applied, the data path's and the sessions' accounts; while
# a change is on trial (TRIAL), the ones it goes back to (KEPT).
APPLIED=$RUN/onu-applied
KEPT=$RUN/onu-kept
# A change onu-config change wrote, which try puts in force under the lock.
PENDING=$RUN/onu-pending
TRIAL=$RUN/onu-trial.d/settings
TRIAL_LIMIT=${TRIAL_LIMIT:-90}
# Tenths of a second to wait for omcid to say that it changed its mode.
APPLIED_TENTHS=${APPLIED_TENTHS:-50}

log() {
	echo "onu-apply: $*" >&2
	logger -t onu-apply "$*" 2>/dev/null
	return 0
}

# The settings: the defaults, which are the table of onu-config and nowhere
# else (onu-config defaults), then /run/onu.conf. A key that is not one of
# these and a value with characters no setting has are left out. WAN_GEM,
# WAN_VLAN, WAN_MAC and LAN_VLAN are keys of before, which the first session
# and the sessions' links take over; the bench's router of before, MODE and
# its WAN_ and LAN_ settings, is gone, and its keys are left out.
load() {
	MODE=bridge
	LAN_VLAN=
	LEGACY_LAN=
	# No value here: the keys exist, so that a table that cannot be read
	# leaves them empty and not unset.
	WAN_GEM= WAN_VLAN= WAN_MAC=
	n=1
	while [ $n -le $MAX_SESSIONS ]; do
		eval "SESSION${n}_GEM= SESSION${n}_VLAN= SESSION${n}_MAC= SESSION${n}_FAMILY="
		eval "SESSION${n}_PASS= SESSION${n}_HOST_VLAN="
		n=$((n + 1))
	done
	n=1
	while [ $n -le $MAX_LANS ]; do
		eval "LAN${n}_CONN= LAN${n}_VLAN= LAN${n}_ADDRESS= LAN${n}_DHCP="
		eval "LAN${n}_POOL_FROM= LAN${n}_POOL_TO= LAN${n}_LEASE="
		eval "LAN${n}_IPV6= LAN${n}_IPV6_SUBNET="
		n=$((n + 1))
	done
	defaults=$(onu-config defaults) || {
		log "the defaults of the settings are not known: onu-config does not say them"
		defaults=
	}
	while IFS='=' read -r key value; do
		[ -n "$key" ] && eval "$key=\$value"
	done <<EOF
$defaults
EOF
	DEFAULT_FAMILY=$SESSION1_FAMILY
	if [ -r "$CONF" ]; then
		load_file
	fi
	# The single session of before: its settings were the WAN's.
	[ "$SESSION1_GEM" != auto ] || SESSION1_GEM=$WAN_GEM
	[ -n "$SESSION1_VLAN" ] || SESSION1_VLAN=$WAN_VLAN
	[ -n "$SESSION1_MAC" ] || SESSION1_MAC=$WAN_MAC
	# The one link of before, LAN_VLAN or the host link itself, is the link
	# of each session that names none of its own.
	if [ -n "$LEGACY_LAN" ]; then
		n=1
		while [ $n -le $MAX_SESSIONS ]; do
			[ -n "$(setting $n HOST_VLAN)" ] ||
				eval "SESSION${n}_HOST_VLAN=\${LAN_VLAN:-untagged}"
			n=$((n + 1))
		done
	fi
	return 0
}

load_file() {
	while IFS='=' read -r key value; do
		case $key in
		WAN_GEM | WAN_VLAN | WAN_MAC) ;;
		LAN_VLAN) LEGACY_LAN=1 ;;
		SESSION[1-7]_GEM | SESSION[1-7]_VLAN | SESSION[1-7]_MAC | \
			SESSION[1-7]_FAMILY | SESSION[1-7]_PASS | SESSION[1-7]_HOST_VLAN) ;;
		# A network's name is for people; its fixed addresses are read
		# where they are needed (lan_dhcp()).
		LAN[1-8]_CONN | LAN[1-8]_VLAN | LAN[1-8]_ADDRESS | LAN[1-8]_DHCP | \
			LAN[1-8]_POOL_FROM | LAN[1-8]_POOL_TO | LAN[1-8]_LEASE | \
			LAN[1-8]_IPV6 | LAN[1-8]_IPV6_SUBNET) ;;
		*) continue ;;
		esac
		case $value in
		*[!A-Za-z0-9./:_-]*)
			log "$key: not a value; the default stays"
			continue
			;;
		esac
		eval "$key=\$value"
	done <"$CONF"
}

# Setting $2 of session $1.
setting() {
	eval "echo \"\${SESSION$1_$2}\""
}

# The VLAN session $1 runs in on the PON side: its VLAN, or, where the OLT
# translates that VLAN of the subscriber's side, the VLAN the translation
# leads into, as omcid publishes them in /run/omcid/xlate ("SUB NET" lines).
# A session can so be given the VLAN a router behind the stick would use.
session_vlan() {
	v=$(setting "$1" VLAN)
	[ -n "$v" ] || return 0
	net=$(awk -v v="$v" '$1 == v { print $2; exit }' "$RUN/omcid/xlate" 2>/dev/null)
	echo "${net:-$v}"
}

# The sessions that have an account, by number.
sessions() {
	n=1
	while [ $n -le $MAX_SESSIONS ]; do
		[ -s "$RUN/onu-pppoe$n" ] && echo $n
		n=$((n + 1))
	done
}

# The family of session $1: ipv4, ipv6 or both.
family() {
	f=$(setting "$1" FAMILY)
	case $f in
	ipv4 | ipv6 | both) echo "$f" ;;
	*) echo "$DEFAULT_FAMILY" ;;
	esac
}

# The VLAN of the host link session $1 hands its address down in: the one
# its HOST_VLAN names, else its own, the VID the operator names its service
# with; nothing for none (untagged).
down_vlan() {
	hv=$(setting "$1" HOST_VLAN)
	case $hv in
	untagged) ;;
	'') setting "$1" VLAN ;;
	*) echo "$hv" ;;
	esac
}

# The address the PON side sends from where a session or the WAN names
# none: the host link's, made locally administered (or, already so, with its
# last bit turned). On the PON side the switch looks a frame up by the PON
# port's PVID, where the host link's own address has its entry, with the
# router bit the L3 engine needs from the host's side: with one address on
# both sides, the frames the engine routed down from the PON went nowhere
# once the PON port dropped the unicast no entry knows (measured), while an
# address of the PON side's own gets an entry of its own.
pon_mac() {
	base=$(cat "$NET/sfp/address" 2>/dev/null)
	[ -n "$base" ] || return 0
	mac=$(printf '%02x:%s' $((0x${base%%:*} | 2)) "${base#*:}")
	[ "$mac" != "$base" ] ||
		mac=$(printf '%s:%02x' "${base%:*}" $((0x${base##*:} ^ 1)))
	echo "$mac"
}

# The link to the host for the VLAN $1: lanVID, or the host link itself.
link_of() {
	if [ -n "$1" ]; then
		echo "lan$1"
	else
		echo sfp
	fi
}

# Whether session $1 hands its $2, ipv4 or ipv6, down: it is told to, it
# carries that family, and it is the first in its VLAN towards the host that
# is both. In one VLAN one session at most hands its IPv4 address down, and
# one its IPv6 prefix.
hands() {
	hv=$(down_vlan "$1")
	for hm in $(sessions); do
		[ "$(setting "$hm" PASS)" = off ] && continue
		[ "$(down_vlan "$hm")" = "$hv" ] || continue
		case $(family "$hm") in
		both | "$2")
			[ "$hm" = "$1" ]
			return
			;;
		esac
	done
	return 1
}

# The session the stick's own default route goes by, of those that hand an
# IPv4 address down: the first. Each other has a routing table of its own,
# by which what comes from its address goes by its link.
main_pass() {
	for mp in $(sessions); do
		if hands "$mp" ipv4; then
			echo "$mp"
			return 0
		fi
	done
}

# The session the stick's own IPv6 default route goes by, of those that hand
# a prefix down: the first. Each other has its table, as main_pass().
main_pd() {
	for mp in $(sessions); do
		if hands "$mp" ipv6; then
			echo "$mp"
			return 0
		fi
	done
}

# The routing table of session $1, for what comes from the address or the
# prefix it hands down.
table_of() {
	echo $((100 + $1))
}

# The links to the host the sessions hand down by, one a line.
pass_links() {
	for pl in $(sessions); do
		[ "$(setting "$pl" PASS)" = off ] && continue
		link_of "$(down_vlan "$pl")"
	done | sort -u
}

svc_sync() {
	onu-svc sync onu "$SVC_DIR" || log "procd was not given the programs of $SVC_DIR"
}

# The program $2... as the instance $1, written under a name of a dot and
# renamed into place, so that a sync never reads half of it.
svc_start() {
	sn=$1
	shift
	mkdir -p "$SVC_DIR" &&
		printf '%s\n' "$*" >"$SVC_DIR/.$sn" &&
		mv "$SVC_DIR/.$sn" "$SVC_DIR/$sn" ||
		{ log "$sn is no program of procd: not started"; return 0; }
	svc_sync
}

# The instance $1 ended and forgotten; none is no error.
svc_stop() {
	rm -f "$SVC_DIR/$1"
	[ -d "$SVC_DIR" ] && svc_sync
	return 0
}

# Wait until omcid says that it programmed the data path for the mode $1:
# 5 s at most (APPLIED_TENTHS). What omcid said of another mode, an earlier
# signal's, is not it.
omcid_applied() {
	oa_want=router
	[ "$1" = bridge ] && oa_want=bridge
	oa_i=0
	while [ $oa_i -lt "$APPLIED_TENTHS" ]; do
		oa_got=
		read -r oa_got 2>/dev/null <"$RUN/omcid/applied"
		[ "$oa_got" = "$oa_want" ] && return 0
		sleep 0.1
		oa_i=$((oa_i + 1))
	done
	log "omcid did not say that it is in $1 mode: it may not have changed it"
	return 0
}

# The identity omcid reads, a copy of the unit's without the PLOAM password,
# which root alone and the PON driver need: omcid is an account of its own.
omcid_identity() {
	[ -r "$IDENTITY" ] || return 0
	grep -v '^ploam_password=' "$IDENTITY" >"$RUN/omcid/identity.new" &&
		chown :omcid "$RUN/omcid/identity.new" && chmod 640 "$RUN/omcid/identity.new" &&
		mv "$RUN/omcid/identity.new" "$RUN/omcid/identity" ||
		log "omcid cannot read the identity"
}

# omcid in the mode $1. A running omcid is told by a signal, SIGUSR2 for
# bridge mode and SIGUSR1 for "router", without the OLT's bridge: it keeps its
# MIB, so what the OLT provisioned stays, and programs the data path again
# from it, and says so in /run/omcid/applied, which is taken away before the
# signal and waited for after it, for 5 s. One that does not run is started as the instance "omcid" of
# procd's service "onu" (onu-run omcid), with -r without the bridge; its
# log goes on in /run/omcid.log. The mode is kept in /run/omcid.mode, so that
# an omcid that procd starts again after a crash comes up in the mode the
# stick is in.
omcid_run() {
	echo "$1" >"$RUN/omcid.mode"
	if pidof omcid >/dev/null 2>&1; then
		rm -f "$RUN/omcid/applied"
		if [ "$1" = bridge ]; then
			killall -USR2 omcid
		else
			killall -USR1 omcid
		fi
		omcid_applied "$1"
	else
		omcid_identity
		# procd runs it, and finds no program on a path of its own.
		svc_start omcid -- "$(command -v onu-run || echo "$LIB/onu-run")" omcid
	fi
}

# The VLANs the sessions hold, by their VID on the PON side, one a line; none,
# with status 1, when a session runs untagged on its GEM port.
held_vlans() {
	out=
	for n in $(sessions); do
		v=$(session_vlan "$n")
		[ -n "$v" ] || return 1
		out="$out $v"
	done
	echo $out | tr ' ' '\n' | sort -un
}

# What omcid is to do in the mode $MODE: "bridge", the OLT's bridge whole;
# "held VID...", the OLT's bridge without the VLANs the sessions hold;
# "router", without the OLT's bridge, beside a session that holds a whole
# GEM port.
omcid_want() {
	case $MODE in
	bridge) echo bridge ;;
	*) held_want ;;
	esac
}

# What omcid is to do beside the sessions (see omcid_want()).
held_want() {
	if held=$(held_vlans); then
		echo held $held
	else
		echo router
	fi
}

# Bring omcid to $1, as omcid_want() gives it, from what it was told last.
# omcid reads the held VLANs from /run/onu-held-vlans; for them its bridge is
# taken down first, so that it builds it again without what it leaves out
# now. Back to the whole bridge it adds what it left out.
omcid_sync() {
	[ "$1" = "$(cat "$RUN/onu-omcid" 2>/dev/null)" ] && return 0
	case $1 in
	held\ *)
		echo "${1#held }" | tr ' ' '\n' >"$RUN/onu-held-vlans"
		bridge_down
		omcid_run bridge
		;;
	bridge)
		rm -f "$RUN/onu-held-vlans"
		omcid_run bridge
		;;
	*)
		rm -f "$RUN/onu-held-vlans"
		omcid_run router
		bridge_down
		;;
	esac
	echo "$1" >"$RUN/onu-omcid"
}

# What omcid built in bridge mode: the bridge and its VLAN rules, the filters
# from priority VLAN_PREF up on the ingress of sfp and pon. The filters of the
# management VLAN, which onu-mgmt put at its priorities of the same qdiscs,
# stay: they keep that VLAN off the PON in every mode.
bridge_down() {
	onu-nl link del omcibr0 2>/dev/null
	for dev in sfp pon; do
		for pref in $(onu-nl filter prefs "$dev" 2>/dev/null); do
			[ "$pref" -lt "$VLAN_PREF" ] || onu-nl filter del "$dev" pref "$pref" 2>/dev/null
		done
	done
	return 0
}

# The GEM interface for the setting $1: gemN for N, or for auto (or nothing)
# the one of the lowest Port-ID of the GEM ports that carry both ways and are
# not multicast, as the driver says (pon gem): a session sends and receives,
# and the multicast port, which OLTs usually give 4095, is neither. The
# driver's list is asked up to three times, 0.2 s apart: while the OLT
# provisions the ports, or omcid programs them again, there may be none for a
# moment, and a session that finds none goes down and stays down until the
# next change tells onu-apply to look again.
gem_of() {
	if [ -n "$1" ] && [ "$1" != auto ]; then
		[ -e "$NET/gem$1" ] && echo "gem$1"
		return 0
	fi
	gem_try=0
	while [ $gem_try -lt 3 ]; do
		for gem_id in $(pon gem 2>/dev/null |
			awk '$4 == "both" && !/ multicast/ { print $3 }' | sort -n); do
			if [ -e "$NET/gem$gem_id" ]; then
				echo "gem$gem_id"
				return 0
			fi
		done
		gem_try=$((gem_try + 1))
		[ $gem_try -ge 3 ] || sleep 0.2
	done
}

# The GEM interface of session $1: the one its GEM setting names; for auto
# (or nothing), where the session has a VLAN, the GEM port that the OLT lets
# that VLAN on the fibre through, as omcid publishes them in
# /run/omcid/gem-vlans ("VID PORT-ID" lines), the lowest Port-ID of them;
# else the one gem_of() gives. A session given the VID by which the operator
# names its service so follows the service to another VID on the fibre and
# to another GEM port.
session_gem() {
	g=$(setting "$1" GEM)
	v=$(session_vlan "$1")
	if { [ -z "$g" ] || [ "$g" = auto ]; } && [ -n "$v" ]; then
		for id in $(awk -v v="$v" '$1 == v { print $2 }' \
			"$RUN/omcid/gem-vlans" 2>/dev/null | sort -n); do
			if [ -e "$NET/gem$id" ]; then
				echo "gem$id"
				return 0
			fi
		done
	fi
	gem_of "$g"
}

# What session $1 has: the fact $2 with the value $3, or none without one.
note() {
	[ -d "$SESSIONS/$1" ] || return 0
	if [ -n "${3:-}" ]; then
		echo "$3" >"$SESSIONS/$1/$2"
	else
		rm -f "$SESSIONS/$1/$2"
	fi
}

# The delegated IPv6 prefix of session $1, whose link $2 came up on its
# interface $3, handed on to the host by dhcp6d: the link to the host gets
# IPv6, and the stick forwards it. A session other than main_pd() has dhcp6d
# route what comes from its prefix by the session's own table. dhcp6d keeps
# the host's binding in /run/dhcp6d/pdN, which pd_keep() keeps in the store. It
# is procd's service dhcp6dN, and runs as the account dhcp6d with the three
# powers it uses: ports 546 and 547, the raw socket of its Router
# Advertisements, and the route of the prefix.
pd_up() {
	lan=$(cat "$SESSIONS/$1/lan" 2>/dev/null)
	[ -n "$lan" ] || return 0
	svc_stop "dhcp6d$1"
	echo 1 >"$FORWARD6" 2>/dev/null
	table=
	[ "$1" = "$(main_pd)" ] || table="-t $(table_of "$1")"
	# $table is an option and its value, split on purpose.
	svc_start "dhcp6d$1" -o "$RUN/dhcp6d.log" -- \
		"$DROP" -c net_bind_service,net_admin,net_raw dhcp6d \
		dhcp6d -w "$2" -l "$lan" -m "$3" -o "$SESSIONS/$1" -b "$RUN/dhcp6d/pd$1" -x "$CALL" \
		-n "ses$1" $table
	log "session $1: its IPv6 prefix goes to the router on $lan"
}

# Session $1 as an interface of netifd, "sesN", of the protocol "pppoed"
# (pppoed/README.rst): netifd runs pppoed on the device $2, with the account of
# /run/onu-pppoeN, for the family $3, the address handed on ($4, 1 or 0) and
# the default route through it ($5), keeps it and starts it again when it
# ends, and puts what the session brings in place; pppoed writes it to
# /run/session/N. -M is pppoed's under netifd: a concentrator that agreed to
# 1500-byte packets in the discovery is taken at its word when its LCP asks
# for 1492, as an operator's does while it carries 1500 each way (measured).
session_net() {
	{
		printf "config interface 'ses%s'\n\toption device '%s'\n" "$1" "$2"
		printf "\toption proto 'pppoed'\n\toption session '%s'\n" "$1"
		printf "\toption family '%s'\n\toption pass '%s'\n" "$3" "$4"
		printf "\toption defaultroute '%s'\n\n" "$5"
	} | onu-net set "ses$1" || log "session $1: netifd was not given it"
}

# What session $1 brought, which pppoed wrote in /run/session/N, handed on as
# its role, in /run/session/N/role, says: in the role "pass" or "routed" the
# address goes to the host, by the stick's default route or by the session's
# own table; "pass" gives the stick's name servers. With "pd"
# the delegated IPv6 prefix goes to the host by dhcp6d. netifd runs it for
# each event of the session's interface, once a time; what is handed on
# already stays as it is.
# The stick's networks of the host side: the management pair, one that waits,
# the address on the SFP port, and the links that hand a session's address on.
host_nets() {
	sed -n -e 's/^ADDRESS=\(.\)/\1/p' -e 's/^DATA_ADDRESS=\(.\)/\1/p' \
		"$RUN/onu-mgmt" 2>/dev/null
	sed -n 's/^ADDRESS=\(.\)/\1/p' "$RUN/onu-trial.d/mgmt" 2>/dev/null
	echo 169.254.0.0/16
}

# A packet that comes in on session interface $1 to a network of the host
# side is dropped before the stick takes it as its own or passes it on to the
# host, whoever sends it: the operator's end of a session can address one.
# The filters take priorities 1 to GUARD_PREFS of the interface's ingress.
guard() {
	onu-nl clsact add "$1" 2>/dev/null || {
		log "$1: the host side is not kept from the session"
		return 0
	}
	for pref in $(onu-nl filter prefs "$1" 2>/dev/null); do
		[ "$pref" -gt "$GUARD_PREFS" ] || onu-nl filter del "$1" pref "$pref" 2>/dev/null
	done
	pref=1
	for net in $(host_nets); do
		[ "$pref" -le "$GUARD_PREFS" ] || {
			log "$1: more networks than priorities: $net is not kept from the session"
			break
		}
		onu-nl filter add "$1" pref $pref dst "$net" drop 2>/dev/null ||
			log "$1: packets to $net are not kept from the session"
		pref=$((pref + 1))
	done
}

session_brought() {
	d=$SESSIONS/$1
	role= role6=
	[ -r "$d/role" ] && read -r role role6 <"$d/role"
	dev=$(cat "$d/ppp" 2>/dev/null)
	[ -n "$dev" ] || return 0
	guard "$dev"
	addr=$(cat "$d/ipv4" 2>/dev/null)
	if [ -n "$addr" ] && [ "$(cat "$d/pass" 2>/dev/null)" != "$addr" ] &&
		[ "$(cat "$d/up" 2>/dev/null)" != "$addr" ]; then
		echo "$addr" >"$d/up"
		dns=$(cat "$d/dns" 2>/dev/null)
		if [ "$role" = pass ]; then
			if [ -n "$dns" ]; then
				echo "$dns" >"$RUN/onu-dns"
			else
				rm -f "$RUN/onu-dns"
			fi
		fi
		case $role in
		pass | routed) pass_lease "$1" "$addr" "$dev" "$(cat "$d/peer" 2>/dev/null)" ;;
		esac
		# Its networks' devices get its name servers.
		for bn in $(lans); do
			[ "$(lan_session "$bn")" = "$1" ] && lan_dhcp "$bn"
		done
		log "session $1: IPv4 up on $dev"
	fi
	if [ -s "$d/ipv6" ] && [ "$role6" = pd ] && [ ! -e "$SVC_DIR/dhcp6d$1" ]; then
		log "session $1: IPv6 up on $dev"
		pd_up "$1" "$dev" "$(cat "$d/dev" 2>/dev/null)"
	fi
	return 0
}

# What session $1 handed on, taken back when it ends. What the session brought
# is pppoed's to take away: by the time netifd tells of the end, the next
# pppoed may have written its own.
session_lost() {
	d=$SESSIONS/$1
	role= role6=
	[ -r "$d/role" ] && read -r role role6 <"$d/role"
	[ "$role6" = pd ] && svc_stop "dhcp6d$1"
	case $role in
	pass | routed) pass_lease_down "$1" ;;
	esac
	rm -f "$d/up"
	return 0
}

# An event of an interface of netifd, which netifd runs onu-apply for (netifd
# -h), with ACTION, INTERFACE and DEVICE: a session's interface, sesN, that
# comes up or changes hands on what it brought; one that goes down takes it
# back. The others are no business of onu-apply.
iface_event() {
	case ${INTERFACE:-} in
	ses[1-7]) n=${INTERFACE#ses} ;;
	*) return 0 ;;
	esac
	[ -d "$SESSIONS/$n" ] || return 0
	case ${ACTION:-} in
	ifup | ifupdate) session_brought "$n" ;;
	ifdown) session_lost "$n" ;;
	esac
	return 0
}

# The address $2 of session $1, whose link is $3, handed down: a host route
# to it on the session's link to the host, and a DHCP server there that
# leases it alone, as a /32 with the stick as the gateway, the session's name
# servers and its MTU. A lease runs for a minute: the router asks again
# before it ends, so it finds a new address of a new session that soon. The
# gateway is the concentrator's address $4, as a router that made the
# session itself would have it, and the stick answers ARP for it on the link
# without taking it: a packet to it goes on into the session, so that the
# concentrator answers it. Without the peer's address it is the stick's own
# address on the link, LINK_ADDRESS, which the DHCP server answers from
# either way. A session other than main_pass() routes what comes from its
# address by a table of its own, through its link.
pass_lease() {
	lan=$(cat "$SESSIONS/$1/lan" 2>/dev/null)
	[ -n "$lan" ] || return 0
	svc_stop "udhcpd-$lan"
	[ "$(cat "$SESSIONS/$1/pass" 2>/dev/null)" = "$2" ] ||
		rm -f "$RUN/udhcpd-$lan.leases"
	gw=$LINK_ADDRESS
	case $4 in
	'' | *[!0-9.]* | 0.0.0.0) ;;
	*) gw=$4 ;;
	esac
	pass_net "$1" "$2" "$lan" "$gw"
	mtu=$(cat "$NET/$3/mtu" 2>/dev/null)
	dns=$(cat "$SESSIONS/$1/dns" 2>/dev/null)
	{
		echo "interface $lan"
		echo "start $2"
		echo "end $2"
		echo "max_leases 1"
		echo "lease_file $RUN/udhcpd-$lan.leases"
		echo "pidfile $RUN/udhcpd-$lan.pid"
		echo "opt subnet 255.255.255.255"
		echo "opt router $gw"
		echo "opt staticroutes $gw/32 0.0.0.0, 0.0.0.0/0 $gw"
		[ -n "$dns" ] && echo "opt dns $dns"
		[ -n "$mtu" ] && echo "opt mtu $mtu"
		echo "opt lease 60"
	} >"$RUN/udhcpd-$lan.conf"
	[ -e "$RUN/udhcpd-$lan.leases" ] || : >"$RUN/udhcpd-$lan.leases"
	note "$1" pass "$2"
	note "$1" gateway "$gw"
	# The stick's own way out: what the status daemon shows as the
	# address handed on.
	if [ "$1" = "$(main_pass)" ]; then
		echo "$2" >"$RUN/onu-pass"
		echo "$lan" >"$RUN/onu-lan"
		if [ "$gw" != "$LINK_ADDRESS" ]; then
			echo "$gw" >"$RUN/onu-pass-proxy"
		else
			rm -f "$RUN/onu-pass-proxy"
		fi
	fi
	svc_start "udhcpd-$lan" -- udhcpd -f "$RUN/udhcpd-$lan.conf"
	log "session $1: its address goes to the router on $lan, with the gateway $gw"
}

# What session $1 hands down as netifd's part "pass-N": the route to its
# address $2 on its link $3, the gateway $4 answered for on the link without
# being taken (proxy ARP) when it is not the stick's own address there, and,
# for a session other than main_pass(), its table: a rule sends what comes
# from $2 to it, and its default route goes by the session's interface.
# netifd puts them in place, and takes them away with the part or with the
# interface they belong to.
pass_net() {
	{
		printf "config route\n\toption interface '%s'\n" "$3"
		printf "\toption target '%s/32'\n\n" "$2"
		if [ "$4" != "$LINK_ADDRESS" ]; then
			printf "config neighbor\n\toption interface '%s'\n" "$3"
			printf "\toption ipaddr '%s'\n\toption proxy '1'\n\n" "$4"
		fi
		if [ "$1" != "$(main_pass)" ]; then
			printf "config rule\n\toption src '%s/32'\n" "$2"
			printf "\toption lookup '%s'\n\n" "$(table_of "$1")"
			printf "config route\n\toption interface 'ses%s'\n" "$1"
			printf "\toption target '0.0.0.0/0'\n\toption table '%s'\n\n" \
				"$(table_of "$1")"
		fi
	} | onu-net set "pass-$1" || log "session $1: netifd was not given its address"
}

# The address session $1 handed down taken back, when the session ends.
pass_lease_down() {
	addr=$(cat "$SESSIONS/$1/pass" 2>/dev/null)
	lan=$(cat "$SESSIONS/$1/lan" 2>/dev/null)
	[ -n "$lan" ] && svc_stop "udhcpd-$lan"
	onu-net del "pass-$1"
	if [ -n "$addr" ] && [ "$addr" = "$(cat "$RUN/onu-pass" 2>/dev/null)" ]; then
		rm -f "$RUN/onu-pass" "$RUN/onu-pass-proxy" "$RUN/onu-lan"
	fi
	note "$1" pass
	note "$1" gateway
	return 0
}

# Room for PPPoE's 8 bytes of headers around a 1500-byte packet (RFC 4638) on
# the PON port, the GEM interface $1 and the WAN interface $2, as far as each
# takes it: pppoed asks the concentrator for 1500 bytes, and keeps to 1492
# when the interface has no room or the concentrator does not agree.
pppoe_mtu() {
	for mtu_dev in pon "$1" "$2"; do
		onu-nl link set "$mtu_dev" mtu 1508 2>/dev/null || return 0
	done
}

# The GEM ports other than the sessions' $1. Without sessions omcid bridges
# them with the host link; what they carry in a session's VLAN is the
# session's. The OLT sends the network side's broadcasts by the multicast GEM
# port, and an answer by that port, which cannot send, is lost. And where the
# GEM ports of an IEEE 802.1p mapper divide a VLAN's priorities, the OLT sends
# a session's frames down by more than one of them: an operator's sent the
# PPPoE discovery and control frames by the GEM port of priorities 6 and 7
# while the session sent by that of priority 0, and the session never came up
# (measured). So the frames of every other GEM port are handed to the
# session's GEM interface as they come in:
# feeds_sync TO [VID:GEM...] hands every frame to the GEM interface TO, or,
# with pairs, only the frames of each VID to its GEM interface, and leaves the
# rest to the OLT's bridge, or to nobody: the same operator sent a television
# channel by the multicast GEM port, 7 Mb/s that no one had asked for
# (measured), which a session has no use for. The frames the switch routes in
# hardware never reach these rules.
feeds_sync() {
	to=$1
	shift
	ports=$(pon gem 2>/dev/null | awk -v wan="$to" '$1 != wan { print $1 }' | sort)
	# The interfaces by name and index. When the OLT provisions its GEM ports
	# again, their interfaces come back under the same names without the
	# filters the old ones had, and only the index tells them apart; by name
	# alone the filters stayed away and the session's discovery frames with
	# them, until the stick restarted (measured on the operator's fibre).
	key=$(for dev in "$to" $ports; do
		printf '%s:%s ' "$dev" "$(cat "$NET/$dev/ifindex" 2>/dev/null)"
	done
	echo "$@")
	[ "$key" = "$(cat "$RUN/onu-feeds.key" 2>/dev/null)" ] && return 0
	feeds_down
	for port in $ports; do
		if [ $# -eq 0 ]; then
			rules=":$to"
		else
			rules=
			for pair; do
				# A session's own GEM port keeps its frames.
				[ "${pair#*:}" = "$port" ] || rules="$rules $pair"
			done
			[ -n "$rules" ] || continue
		fi
		onu-nl clsact add "$port" 2>/dev/null
		echo "$port" >>"$RUN/onu-feeds"
		for rule in $rules; do
			if [ -z "${rule%%:*}" ]; then
				onu-nl filter add "$port" redirect "${rule#*:}"
			else
				onu-nl filter add "$port" vlan "${rule%%:*}" redirect "${rule#*:}"
			fi
		done
	done
	echo "$key" >"$RUN/onu-feeds.key"
}

feeds_down() {
	for port in $(cat "$RUN/onu-feeds" 2>/dev/null); do
		onu-nl clsact del "$port" 2>/dev/null
	done
	rm -f "$RUN/onu-feeds" "$RUN/onu-feeds.key"
	return 0
}

# The interface of session $1 on the GEM interface $2: the GEM interface
# itself, or wanVID for a VLAN.
session_dev() {
	vlan=$(session_vlan "$1")
	if [ -n "$vlan" ]; then
		echo "wan$vlan"
	else
		echo "$2"
	fi
}

# What session $1 on the GEM interface $2 is made of, one line: its
# interface, its family and MAC address, its account (a digest), and what it
# hands down by which link, the default routes among it. sessions_sync()
# takes a session down and up again when this changes, and leaves the others
# up: a change of one session leaves the other sessions as they are (ADR
# 0014). It is in /run/session/N/makings, for root only.
session_makings() {
	mk_dev=$(session_dev "$1" "$2")
	mk_role=- mk_role6=-
	if hands "$1" ipv4; then
		mk_role=routed
		[ "$1" = "$(main_pass)" ] && mk_role=pass
	fi
	if hands "$1" ipv6; then
		mk_role6=pd
		[ "$1" = "$(main_pd)" ] && mk_role6=pd-main
	fi
	mk_account=$(md5sum <"$RUN/onu-pppoe$1" 2>/dev/null)
	echo "$2 $mk_dev $(family "$1") mac=$(setting "$1" MAC) $mk_role $mk_role6" \
		"lan=$(down_vlan "$1") ${mk_account%% *}"
}

# Whether a running session other than $1 is on the interface $2.
dev_shared() {
	for d in "$SESSIONS"/*/dev; do
		[ -r "$d" ] || continue
		[ "$d" = "$SESSIONS/$1/dev" ] && continue
		[ "$(cat "$d")" = "$2" ] && return 0
	done
	return 1
}

# pppoed, an account of its own, reads the sessions' accounts: the group
# pppoed's and no one else's but root's. An account put in place anew, by a
# change taken or a trial that goes back, is root's alone until this runs, so
# it runs after each such put. $1 is one session; without it, all of them.
accounts_to_pppoed() {
	for ap_f in "$RUN"/onu-pppoe${1:-[1-7]}; do
		[ -e "$ap_f" ] || continue
		chown :pppoed "$ap_f" && chmod 640 "$ap_f" ||
			log "${ap_f##*/}: pppoed cannot read it"
	done
}

# Session $1 up on the GEM interface $2: its interface, made for the first
# session on it, or again when it is gone (the kernel takes a VLAN interface
# away with the GEM interface under it, which an OLT's new provisioning
# replaces, before the other sessions on it have moved), room for PPPoE's
# headers, and its client.
session_up() {
	n=$1 gem=$2
	dev=$(session_dev "$n" "$gem")
	fam=$(family "$n")
	if ! dev_shared "$n" "$dev" || [ ! -e "$NET/$dev" ]; then
		onu-nl link set "$gem" up
		if [ "$dev" != "$gem" ]; then
			onu-nl link add vlan "$gem" "$dev" "$(session_vlan "$n")"
		fi
		mac=$(setting "$n" MAC)
		[ -n "$mac" ] || mac=$(pon_mac)
		if [ -n "$mac" ]; then
			onu-nl link set "$dev" address "$mac" ||
				log "session $n: the interface did not take its MAC address"
		fi
		[ "$dev" != "$gem" ] && onu-nl link set "$dev" up
		pppoe_mtu "$gem" "$dev"
	fi
	mkdir -p "$SESSIONS/$n"
	# The programs of the session write what they bring into its directory,
	# as the accounts of the group onu (the boot script's, post-build.sh).
	chown :onu "$SESSIONS/$n" && chmod 2770 "$SESSIONS/$n" ||
		log "session $n: its directory is not the group onu's"
	accounts_to_pppoed "$n"
	echo "$gem" >"$SESSIONS/$n/gem"
	echo "$dev" >"$SESSIONS/$n/dev"
	echo "$fam" >"$SESSIONS/$n/family"
	pass=0 route=0 role=none
	if hands "$n" ipv4; then
		pass=1
		if [ "$n" = "$(main_pass)" ]; then
			route=1
			role=pass
		else
			role=routed
		fi
	fi
	role6=none
	hands "$n" ipv6 && role6=pd
	if [ "$role" != none ] || [ "$role6" != none ]; then
		link_of "$(down_vlan "$n")" >"$SESSIONS/$n/lan"
	fi
	# What it hands down, for the status daemon, which shows what the stick
	# does rather than work it out again.
	hands=
	[ "$role" != none ] && hands=ipv4
	[ "$role6" != none ] && hands="${hands:+$hands }ipv6"
	if [ -n "$hands" ]; then
		echo "$hands"
	fi >"$SESSIONS/$n/hands"
	echo "$role $role6" >"$SESSIONS/$n/role"
	(umask 077 && session_makings "$n" "$gem" >"$SESSIONS/$n/makings")
	session_net "$n" "$dev" "$fam" "$pass" "$route"
	log "session $n on $dev ($fam), GEM port ${gem#gem}"
}

# Whether a running session other than $1 is on the GEM interface $2.
gem_shared() {
	for g in "$SESSIONS"/*/gem; do
		[ -r "$g" ] || continue
		[ "$g" = "$SESSIONS/$1/gem" ] && continue
		[ "$(cat "$g")" = "$2" ] && return 0
	done
	return 1
}

# Session $1 down: its client, which ends the session with the concentrator,
# and its interface when no other session is on it. Its names are its own:
# sessions_sync() holds the GEM port it goes up on next.
session_down() {
	[ -r "$SESSIONS/$1/dev" ] || return 0
	read -r down_dev <"$SESSIONS/$1/dev"
	read -r down_gem <"$SESSIONS/$1/gem"
	onu-net del "ses$1" || log "session $1: netifd still has it"
	svc_stop "dhcp6d$1"
	pass_lease_down "$1"
	if ! dev_shared "$1" "$down_dev"; then
		[ "$down_dev" != "$down_gem" ] && onu-nl link del "$down_dev" 2>/dev/null
		# What pppoe_mtu() raised goes back to Ethernet's MTU, the PON port
		# last, once no session is on the GEM port.
		gem_shared "$1" "$down_gem" || onu-nl link set "$down_gem" mtu 1500 2>/dev/null
	fi
	rm -rf "${SESSIONS:?}/$1"
	[ -n "$(ls "$SESSIONS" 2>/dev/null)" ] || onu-nl link set pon mtu 1500 2>/dev/null
	log "session $1 down"
	return 0
}

sessions_down() {
	for d in "$SESSIONS"/*; do
		[ -d "$d" ] && session_down "${d##*/}"
	done
	feeds_down
	rm -f "$RUN/onu-dns"
	return 0
}

# The host each session delegates its prefix to, which dhcp6d keeps in
# /run/dhcp6d/pdN, goes into the store when it changes, and so does its going:
# after a restart of the stick, dhcp6d routes the prefix to that host at once,
# since a router that holds its delegation asks for none (measured:
# NetworkManager kept its /56 for a day and asked for the name servers only).
# What went into the store is in /run/onu-pdN.kept, which is root's alone.
pd_keep() {
	command -v onu-config >/dev/null || return 0
	n=1
	while [ $n -le $MAX_SESSIONS ]; do
		pd=$RUN/dhcp6d/pd$n kept=$RUN/onu-pd$n.kept
		if { [ -e "$pd" ] || [ -e "$kept" ]; } &&
			[ "$(cat "$pd" 2>/dev/null)" != "$(cat "$kept" 2>/dev/null)" ] &&
			onu-config pd $n; then
			if [ -e "$pd" ]; then
				cp "$pd" "$kept"
			else
				rm -f "$kept"
			fi
		fi
		n=$((n + 1))
	done
}

# Passthrough: each session follows its GEM port, a session whose makings
# changed, or whose interface is gone, goes down and up again, and a session
# without its account any more goes; the others stay up. The kernel takes a
# VLAN interface away with the GEM interface it is on, which omcid makes anew
# when the OLT provisions anew: the names are then the same, and only the
# interface's absence says that the session is not there. Sessions that start together authenticate apart, as
# pppoed under netifd waits 3 s for each session before it (-w): an
# operator's concentrator refused one of two sessions that authenticated at
# once, without saying why, and took each alone (measured).
sessions_sync() {
	want=" $(sessions | tr '\n' ' ')"
	# The OLT's translations may have come since: omcid leaves the
	# sessions' VLANs out as they now are, before the sessions move.
	omcid_sync "$(held_want)"
	n=1
	while [ $n -le $MAX_SESSIONS ]; do
		cur= dev=
		[ -r "$SESSIONS/$n/gem" ] && read -r cur <"$SESSIONS/$n/gem"
		[ -r "$SESSIONS/$n/dev" ] && read -r dev <"$SESSIONS/$n/dev"
		case $want in
		*" $n "*)
			gem=$(session_gem "$n")
			if [ -n "$gem" ] && { [ "$gem" != "$cur" ] ||
				[ "$(session_dev "$n" "$gem")" != "$dev" ] ||
				{ [ -n "$cur" ] && [ ! -e "$NET/$dev" ]; } ||
				[ "$(session_makings "$n" "$gem")" != \
					"$(cat "$SESSIONS/$n/makings" 2>/dev/null)" ]; }; then
				[ -n "$cur" ] && session_down "$n"
				session_up "$n" "$gem"
			elif [ -z "$gem" ] && [ -n "$cur" ]; then
				log "session $n: its GEM port is gone"
				session_down "$n"
			fi
			;;
		*)
			[ -n "$cur" ] && session_down "$n"
			;;
		esac
		n=$((n + 1))
	done
	first=$(cat "$SESSIONS"/*/gem 2>/dev/null | head -n 1)
	if [ -z "$first" ]; then
		feeds_down
	elif held_vlans >/dev/null; then
		pairs=
		for d in "$SESSIONS"/*; do
			[ -r "$d/gem" ] || continue
			read -r g <"$d/gem"
			pairs="$pairs $(session_vlan "${d##*/}"):$g"
		done
		feeds_sync "$first" $(echo $pairs | tr ' ' '\n' | sort -u)
	else
		feeds_sync "$first"
	fi
	pd_keep
}

# What changed outside the settings, followed: with accounts the sessions,
# without them omcid alone. Run twice on the same facts, it changes nothing.
sync_all() {
	[ "$(cat "$RUN/onu-mode" 2>/dev/null)" = passthrough ] || return 0
	sessions_sync
	# The sessions' GEM ports, which the OLT may have moved, carry the
	# networks' flows.
	lans_fw
}

# Take $1 for this process: a symbolic link to its PID, which ln makes, or
# fails to make, in one step. One whose process is gone is taken over. Fails
# while a live process holds it.
take() {
	ln -s "$$" "$1" 2>/dev/null && return 0
	holder=$(readlink "$1" 2>/dev/null)
	[ -n "$holder" ] && kill -0 "$holder" 2>/dev/null && return 1
	rm -f "$1"
	ln -s "$$" "$1" 2>/dev/null
}

# One onu-apply at a time: the panel's reload, netifd's events, omcid's and
# dhcp6d's changes each run one. The stick's kernel has no flock
# (FILE_LOCKING); the lock is LOCK, held until this process ends. Without
# /run there is nothing to lock, nor to change.
lock() {
	until take "$LOCK"; do
		[ -d "$RUN" ] || exit 1
		sleep 0.1
	done
	trap 'rm -f "$LOCK"' EXIT
	trap 'exit 1' HUP INT TERM
}

# Whether the switch's L3 engine decrements the TTL or hop limit of what it
# routes, true or false.
# The local networks set up, by number, one a line: those with a connection.
lans() {
	for ln in 1 2 3 4 5 6 7 8; do
		[ -n "$(lan_setting "$ln" CONN)" ] && echo "$ln"
	done
	return 0
}

# Setting $2 of network $1.
lan_setting() {
	eval "echo \"\${LAN$1_$2:-}\""
}

# Network $1's interface: netN, a VLAN on the host link, or the host link
# itself.
lan_if() {
	if [ -n "$(lan_setting "$1" VLAN)" ]; then
		echo "net$1"
	else
		echo sfp
	fi
}

# The session network $1 goes out by.
lan_session() {
	ls_c=$(lan_setting "$1" CONN)
	echo "${ls_c#pppoe:}"
}

# The address a.b.c.d $1 as a number, and the number $1 as an address.
ip_num() {
	echo "$1" | {
		IFS=. read -r a b c d
		echo $(((a << 24) | (b << 16) | (c << 8) | d))
	}
}

num_ip() {
	echo "$((($1 >> 24) & 255)).$((($1 >> 16) & 255)).$((($1 >> 8) & 255)).$(($1 & 255))"
}

# The mask of a prefix length $1, as a number.
len_mask() {
	echo $(((0xffffffff << (32 - $1)) & 0xffffffff))
}

# Network $1 as address/length: its first address and its prefix length.
lan_net() {
	la=$(lan_setting "$1" ADDRESS)
	lm=$(len_mask "${la#*/}")
	echo "$(num_ip $(($(ip_num "${la%/*}") & lm)))/${la#*/}"
}

# The local networks as netifd's part "nets": each one's interface, a VLAN on
# the host link or the host link itself, with the stick's address in it and
# a strict reverse-path check, and a rule that sends what comes from the
# network to its session's table; in the table of each session that networks
# go out by, its default route and the routes to all the networks. Without
# networks the part goes.
lans_net() {
	ln_all=$(lans)
	if [ -z "$ln_all" ]; then
		onu-net del nets
		return
	fi
	{
		for ln in $ln_all; do
			ln_if=$(lan_if "$ln")
			printf "config device\n"
			[ "$ln_if" = sfp ] ||
				printf "\toption type '8021q'\n\toption ifname 'sfp'\n\toption vid '%s'\n" \
					"$(lan_setting "$ln" VLAN)"
			printf "\toption name '%s'\n\toption rpfilter 'strict'\n\toption ipv6 '0'\n\n" "$ln_if"
			printf "config interface 'net%s'\n\toption device '%s'\n\toption proto 'static'\n" \
				"$ln" "$ln_if"
			printf "\toption ipaddr '%s'\n\n" "$(lan_setting "$ln" ADDRESS)"
			printf "config rule\n\toption src '%s'\n\toption lookup '%s'\n\n" \
				"$(lan_net "$ln")" "$(table_of "$(lan_session "$ln")")"
		done
		for ls in $(for ln in $ln_all; do lan_session "$ln"; done | sort -u); do
			printf "config route\n\toption interface 'ses%s'\n" "$ls"
			printf "\toption target '0.0.0.0/0'\n\toption table '%s'\n\n" "$(table_of "$ls")"
			for ln in $ln_all; do
				printf "config route\n\toption interface 'net%s'\n" "$ln"
				printf "\toption target '%s'\n\toption table '%s'\n\n" \
					"$(lan_net "$ln")" "$(table_of "$ls")"
			done
		done
	} | onu-net set nets || log "netifd was not given the local networks"
}

# Network $1's DHCP server, when its DHCP is on: the addresses of its pool,
# all of the network's but its first and last when none is given (the server
# never leases its own), the stick as the router, the session's name servers
# once the session brought them, the lease's time, and the fixed address of
# each of its devices. It writes its leases every ten seconds, so that the
# status daemon shows a device soon.
lan_dhcp() {
	svc_stop "udhcpd-net$1"
	if [ "$(lan_setting "$1" DHCP)" != on ] || [ -z "$(lan_setting "$1" CONN)" ]; then
		rm -f "$RUN/udhcpd-net$1.conf"
		return 0
	fi
	ld_addr=$(lan_setting "$1" ADDRESS)
	ld_mask=$(len_mask "${ld_addr#*/}")
	ld_net=$(($(ip_num "${ld_addr%/*}") & ld_mask))
	ld_from=$(lan_setting "$1" POOL_FROM)
	ld_to=$(lan_setting "$1" POOL_TO)
	[ -n "$ld_from" ] || ld_from=$(num_ip $((ld_net + 1)))
	[ -n "$ld_to" ] || ld_to=$(num_ip $((ld_net + (~ld_mask & 0xffffffff) - 1)))
	ld_count=$(($(ip_num "$ld_to") - $(ip_num "$ld_from") + 1))
	[ "$ld_count" -le 512 ] || ld_count=512
	ld_dns=$(cat "$SESSIONS/$(lan_session "$1")/dns" 2>/dev/null)
	{
		echo "interface $(lan_if "$1")"
		echo "start $ld_from"
		echo "end $ld_to"
		echo "max_leases $ld_count"
		echo "lease_file $RUN/udhcpd-net$1.leases"
		echo "pidfile $RUN/udhcpd-net$1.pid"
		echo "auto_time 10"
		echo "opt subnet $(num_ip "$ld_mask")"
		echo "opt router ${ld_addr%/*}"
		[ -n "$ld_dns" ] && echo "opt dns $ld_dns"
		echo "opt lease $(lan_setting "$1" LEASE)"
		grep "^FIXED[0-9]*=$1/" "$CONF" 2>/dev/null |
			while IFS='=/' read -r _ _ ld_mac ld_ip; do
				echo "static_lease $ld_mac $ld_ip"
			done
	} >"$RUN/udhcpd-net$1.conf"
	[ -e "$RUN/udhcpd-net$1.leases" ] || : >"$RUN/udhcpd-net$1.leases"
	svc_start "udhcpd-net$1" -- udhcpd -f "$RUN/udhcpd-net$1.conf"
}

# The local networks up: netifd's part, each network's DHCP server, and the
# NAT they go out through; a network that went takes its server with it.
lans_up() {
	lans_net
	for lu in 1 2 3 4 5 6 7 8; do
		lan_dhcp "$lu"
	done
	lans_fw
}

lans_down() {
	for lu in 1 2 3 4 5 6 7 8; do
		svc_stop "udhcpd-net$lu"
		rm -f "$RUN/udhcpd-net$lu.conf"
	done
	onu-net del nets
	fw_clear
	return 0
}

# onu-fw's table away, once one was put in place.
fw_clear() {
	[ -e "$RUN/onu-fw.conf" ] || return 0
	onu-fw clear || log "onu-fw did not take its table away"
	rm -f "$RUN/onu-fw.conf"
}

# The NAT the local networks go out through, and the protection that keeps
# the internet's new connections from them, as onu-fw's table: each
# network's interface and addresses, and the GEM interface of each session
# they go out by, whose flows the switch carries. Without networks the
# table goes.
lans_fw() {
	lf_all=$(lans)
	if [ -z "$lf_all" ]; then
		fw_clear
		return 0
	fi
	{
		for lf in $lf_all; do
			echo "lan $(lan_if "$lf") $(lan_net "$lf")"
		done
		for lf in $(for ln in $lf_all; do lan_session "$ln"; done | sort -u); do
			lf_gem=$(cat "$SESSIONS/$lf/gem" 2>/dev/null)
			[ -n "$lf_gem" ] && echo "wan $lf_gem"
		done
	} >"$RUN/onu-fw.conf.new"
	# What onu-fw holds already is not put in place again.
	if [ -e "$RUN/onu-fw.conf" ] &&
		[ "$(cat "$RUN/onu-fw.conf.new")" = "$(cat "$RUN/onu-fw.conf")" ]; then
		rm -f "$RUN/onu-fw.conf.new"
		return 0
	fi
	mv "$RUN/onu-fw.conf.new" "$RUN/onu-fw.conf"
	onu-fw apply "$RUN/onu-fw.conf" || {
		log "onu-fw did not take the NAT of the local networks"
		rm -f "$RUN/onu-fw.conf"
	}
}

ttl_decrement() {
	onu-nl param l3_ttl_decrement "$1" ||
		log "the switch did not take l3_ttl_decrement $1"
}

# Passthrough mode: the links to the host, one for each VLAN the sessions
# hand their addresses down in, a VLAN on the host link or the host link
# itself, with the stick's address on each; the sessions' addresses come
# later. The stick stands in for the operator's ONT between the router and
# the concentrator, which is no hop: the switch routes the sessions' packets
# with their TTL unchanged, as it does the gateway the router is given.
# A link forwards only what comes from the address it hands on (BCP 38): a
# strict reverse-path check drops a packet whose source the stick would not
# route back by the link. Without it, packets of any source that reached the
# stick's MAC on the link went out into the session (measured: about half of
# 1000, the rest cut by the limit on the frames to the CPU). The switch routes
# only the handed address's own packets in hardware.
pass_up() {
	echo 1 >"$FORWARD"
	# A router of local networks is a hop: what it routes counts it.
	if [ -n "$(lans)" ]; then
		ttl_decrement true
	else
		ttl_decrement false
	fi
	# $(pass_links) is a list of names, split on purpose.
	links_net $(pass_links)
}

# The links $@ as netifd's part "links": each a VLAN on the host link, or the
# host link itself, with the stick's address, a strict reverse-path check,
# and IPv6 where a session hands its prefix down by it (the host link keeps
# its own). Without links the part goes.
links_net() {
	if [ $# -eq 0 ]; then
		onu-net del links
		return
	fi
	for lan in "$@"; do
		v6=0
		[ "$lan" = sfp ] && v6=1
		for ln in $(sessions); do
			[ "$(link_of "$(down_vlan "$ln")")" = "$lan" ] && hands "$ln" ipv6 && v6=1
		done
		printf "config device\n"
		[ "$lan" = sfp ] ||
			printf "\toption type '8021q'\n\toption ifname 'sfp'\n\toption vid '%s'\n" "${lan#lan}"
		printf "\toption name '%s'\n\toption rpfilter 'strict'\n\toption ipv6 '%s'\n\n" "$lan" "$v6"
		printf "config interface '%s'\n\toption device '%s'\n\toption proto 'static'\n" "$lan" "$lan"
		printf "\toption ipaddr '%s/32'\n\n" "$LINK_ADDRESS"
	done | onu-net set links || log "netifd was not given the links to the host"
}

pass_down() {
	lans_down
	sessions_down
	links_net
	rm -f "$RUN/onu-lan" "$RUN/onu-pass" "$RUN/onu-pass-proxy"
	ttl_decrement true
	echo 0 >"$FORWARD"
	echo 0 >"$FORWARD6" 2>/dev/null
	return 0
}

# The identity to the PON driver, which takes it while the PON is down, then
# the PON up. Twenty hex digits of PLOAM password are its ten octets.
identity() {
	serial=$(grep '^serial=' "$IDENTITY" 2>/dev/null | cut -d= -f2)
	ploam=$(grep '^ploam_password=' "$IDENTITY" 2>/dev/null | cut -d= -f2-)
	if [ -z "$serial" ]; then
		log "no serial number: the PON stays down"
		return 1
	fi
	onu-nl param gpon_serial "$serial" ||
		log "the PON driver did not take the serial number"
	if [ -n "$ploam" ]; then
		case $ploam in
		*[!0-9A-Fa-f]*) ;;
		*) [ ${#ploam} -eq 20 ] && ploam=0x$ploam ;;
		esac
		onu-nl param gpon_password "$ploam" ||
			log "the PON driver did not take the PLOAM password"
	fi
	onu-nl link set pon up || log "the PON does not come up"
}

# A new identity: the OLT sees the stick leave and a new one arrive, and
# omcid starts again; it goes on from the MIB it kept in /run/omcid/mib until
# the OLT builds a new one for it.
reidentify() {
	# The sessions end first, while the PON still carries their PADT: a
	# concentrator keeps a session it is not told of until its LCP gives up
	# (seen: a session of before stayed beside the new one). They come back
	# once the OLT provisions the new identity's GEM ports (sync).
	if [ "$(cat "$RUN/onu-mode" 2>/dev/null)" = passthrough ]; then
		load
		sessions_down
	fi
	onu-nl link set pon down
	identity || return 1
	want=
	[ -r "$RUN/onu-omcid" ] && read -r want _ <"$RUN/onu-omcid"
	svc_stop omcid
	# procd ends it in its own time: until it has, omcid_run would find the
	# daemon on its way out and signal it, rather than start one.
	i=0
	while pidof omcid >/dev/null 2>&1 && [ $i -lt 50 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	if pidof omcid >/dev/null 2>&1; then
		log "omcid did not end in 5 s: killed"
		killall -KILL omcid
		sleep 0.1
	fi
	case $want in
	router) omcid_run router ;;
	*) omcid_run bridge ;;
	esac
	log "registering again"
}

# The settings of $CONF, and the shape they make, which no setting chooses:
# an account makes the stick hold its sessions, and none leaves the OLT's
# bridge.
load_mode() {
	load
	if [ -n "$(sessions)" ]; then
		MODE=passthrough
	else
		MODE=bridge
	fi
}

apply() {
	old=
	[ -r "$RUN/onu-mode" ] && read -r old <"$RUN/onu-mode"
	load_mode
	# From passthrough to passthrough nothing comes down here: the sessions
	# whose makings changed go down and up again in sessions_sync(), and
	# the others stay up.
	if [ "$old" = passthrough ] && [ "$MODE" != passthrough ]; then
		# Down with the settings it came up with.
		[ -r "$RUN/onu-mode.conf" ] && CONF=$RUN/onu-mode.conf
		load
		pass_down
		CONF=$RUN/onu.conf
		load_mode
	fi
	omcid_sync "$(omcid_want)"
	echo "$MODE" >"$RUN/onu-mode"
	[ "$MODE" != passthrough ] || pass_up
	[ "$MODE" != passthrough ] || lans_up
	cp "$CONF" "$RUN/onu-mode.conf" 2>/dev/null
	settings_copy "$APPLIED"
	log "$MODE mode"
	sync_all
}

# The settings in force, /run/onu.conf and the sessions' accounts, copied
# to the directory $1 whole, readable by root alone; nothing is left of
# what $1 held.
settings_copy() {
	rm -rf "$1.new"
	(
		umask 077
		mkdir "$1.new" && cp "$CONF" "$1.new/onu.conf" || exit 1
		for f in "$RUN"/onu-pppoe[1-7]; do
			[ ! -e "$f" ] || cp "$f" "$1.new/" || exit 1
		done
	) || {
		rm -rf "$1.new"
		log "the settings were not copied to $1"
		return 1
	}
	rm -rf "$1" && mv "$1.new" "$1"
}

# Seconds of /proc/uptime.
uptime_s() {
	up=0
	read -r up _ <"$ROOT/proc/uptime" 2>/dev/null
	echo "${up%%.*}"
}

# The change onu-config change left in PENDING put in force: each account it
# changed, an empty file for one it removed, then the settings. Until then
# an onu-apply sync applies the settings in force alone.
pending_take() {
	[ -d "$PENDING" ] || return 0
	for f in "$PENDING"/onu-pppoe[1-7]; do
		[ -e "$f" ] || continue
		if [ -s "$f" ]; then
			mv "$f" "$RUN/${f##*/}"
		else
			rm -f "$f" "$RUN/${f##*/}"
		fi
	done
	[ ! -e "$PENDING/onu.conf" ] || mv "$PENDING/onu.conf" "$CONF"
	accounts_to_pppoed
	rm -rf "$PENDING"
}

# A change on trial (ADR 0014): the settings of /run/onu.conf and the accounts
# applied but not saved, and the ones applied before kept aside. Unless it
# is confirmed in TRIAL_LIMIT seconds, the stick goes back to those, so that
# a change that cut off whoever made it comes undone. A change during a
# trial starts it again, and goes back to the settings of before the first.
try_change() {
	if [ ! -e "$TRIAL" ]; then
		rm -rf "$KEPT"
		[ ! -d "$APPLIED" ] || cp -R "$APPLIED" "$KEPT" ||
			log "the settings in force are not kept: an unconfirmed change stays"
	fi
	pending_take
	apply
	token=$$
	mkdir -p "${TRIAL%/*}" &&
		printf 'UNTIL=%s\nTOKEN=%s\n' "$(($(uptime_s) + TRIAL_LIMIT))" "$token" \
			>"$TRIAL.new" && mv "$TRIAL.new" "$TRIAL" || return 1
	log "the change is on trial for $TRIAL_LIMIT s"
	# The keeper of the deadlines (onu-change watch) takes it back, with the
	# token, which keeps it from ending a later trial.
}

# The change on trial kept, in the configuration store as well.
confirm() {
	[ -e "$TRIAL" ] || return 0
	if command -v onu-config >/dev/null; then
		onu-config save || log "the change is kept until the next start only"
	fi
	rm -f "$TRIAL"
	rm -rf "$KEPT"
	log "the change is confirmed"
}

# The trial named by $1, its token, ended: back to the settings kept.
expire() {
	[ -r "$TRIAL" ] && [ "$(sed -n 's/^TOKEN=//p' "$TRIAL")" = "$1" ] || return 0
	rm -f "$TRIAL"
	if [ -r "$KEPT/onu.conf" ] && cat "$KEPT/onu.conf" >"$CONF.new" &&
		chmod 644 "$CONF.new"; then
		rm -f "$RUN"/onu-pppoe[1-7]
		for f in "$KEPT"/onu-pppoe[1-7]; do
			[ ! -e "$f" ] || mv "$f" "$RUN/"
		done
		accounts_to_pppoed
		mv "$CONF.new" "$CONF"
	fi
	rm -rf "$KEPT" "$CONF.new"
	apply
	log "the change was not confirmed: back to the settings of before"
}

# The state last brought up, as the lines "name=value" for the status daemon,
# which asks for them through onu-act and reads no file of /run itself: the
# mode, the name servers, the address handed to the router and where, what
# became of the settings in the store, each session's facts (session.N.dev,
# gem, hands, ipv6, lan, gateway), and when each change on trial goes back
# (trial.NAME, and trial.mgmt.address). A fact that is not there is left out.
# This is the one place that names these files for a reader, and the lines are
# the contract: the files themselves may change under it.
state_line() {
	st_v=
	[ -r "$2" ] || return 0
	read -r st_v <"$2" || [ -n "$st_v" ] || return 0
	[ -z "$st_v" ] || echo "$1=$st_v"
}

state() {
	state_line mode "$RUN/onu-mode"
	state_line dns "$RUN/onu-dns"
	if [ -r "$RUN/onu-pass" ]; then
		state_line pass.address "$RUN/onu-pass"
		state_line pass.lan "$RUN/onu-lan"
		state_line pass.peer_gateway "$RUN/onu-pass-proxy"
	fi
	state_line store "$RUN/onu-store"
	st_n=1
	while [ "$st_n" -le "$MAX_SESSIONS" ]; do
		for st_f in dev gem hands ipv6 lan gateway; do
			state_line "session.$st_n.$st_f" "$SESSIONS/$st_n/$st_f"
		done
		st_n=$((st_n + 1))
	done
	# onu-change status: "NAME UNTIL", and for mgmt "NAME UNTIL ADDRESS".
	onu-change status 2>/dev/null | while read -r st_name st_until st_addr; do
		[ -n "$st_until" ] || continue
		echo "trial.$st_name=$st_until"
		[ -z "$st_addr" ] || echo "trial.$st_name.address=$st_addr"
	done
}

case ${1:-} in
start | reload | try | confirm | revert | expire | stop | identity | reidentify | iface) lock ;;
esac

case ${1:-} in
start)
	[ -e "$CONF" ] || cp "$ROOT/etc/onu.conf" "$CONF" 2>/dev/null || : >"$CONF"
	if [ -z "$(sessions)" ] && [ -r "$ROOT/etc/onu-pppoe" ]; then
		(umask 077 && cp "$ROOT/etc/onu-pppoe" "$RUN/onu-pppoe1")
	fi
	apply
	;;
reload)
	if command -v onu-config >/dev/null; then
		onu-config save || log "the settings are applied but not saved"
	fi
	# What is saved is kept: no trial goes back on it.
	rm -f "$TRIAL"
	rm -rf "$KEPT"
	apply
	;;
try)
	try_change
	;;
confirm)
	confirm
	;;
revert)
	[ -r "$TRIAL" ] && expire "$(sed -n 's/^TOKEN=//p' "$TRIAL")"
	;;
expire)
	expire "${2:-}"
	;;
stop)
	load
	mode=
	[ -r "$RUN/onu-mode" ] && read -r mode <"$RUN/onu-mode"
	[ "$mode" != passthrough ] || pass_down
	svc_stop omcid
	rm -f "$RUN/onu-mode" "$RUN/onu-omcid" "$RUN/onu-held-vlans" "$RUN/omcid.mode" "$RUN/omcid/applied"
	;;
identity)
	identity
	;;
reidentify)
	reidentify
	;;
status)
	mode=
	[ -r "$RUN/onu-mode" ] && read -r mode <"$RUN/onu-mode"
	echo "mode ${mode:-none}"
	for d in "$SESSIONS"/*; do
		[ -r "$d/dev" ] || continue
		line="session ${d##*/} on $(cat "$d/dev") ($(cat "$d/family"))"
		[ -r "$d/ppp" ] && line="$line, up on $(cat "$d/ppp")"
		[ -r "$d/ipv4" ] && line="$line, $(cat "$d/ipv4")"
		echo "$line"
	done
	[ -s "$RUN/onu-dns" ] && echo "dns $(cat "$RUN/onu-dns")"
	[ -r "$TRIAL" ] && echo "trial until $(sed -n 's/^UNTIL=//p' "$TRIAL")"
	for d in "$SESSIONS"/*; do
		[ -r "$d/pass" ] &&
			echo "pass $(cat "$d/pass") on $(cat "$d/lan") from session ${d##*/}"
	done
	exit 0
	;;
state)
	state
	exit 0
	;;
sync | omcid | dhcp6d)
	# A change told while another waits for the lock is that one's too:
	# at most one waits, and it reads everything once it holds the lock.
	take "$AGAIN" || exit 0
	lock
	rm -f "$AGAIN"
	load
	sync_all
	;;
iface)
	load
	iface_event
	;;
guard)
	for d in "$SESSIONS"/*; do
		[ -r "$d/ppp" ] && [ -e "$d/up" ] && guard "$(cat "$d/ppp")"
	done
	exit 0
	;;
*)
	echo "usage: onu-apply start|reload|try|confirm|revert|stop|identity|reidentify|status|state|sync|guard" >&2
	exit 2
	;;
esac
