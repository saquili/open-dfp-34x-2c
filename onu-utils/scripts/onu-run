#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Paweł Phan <szop.hektar_1w@icloud.com>
#
# onu-run: a server of the host side, or the console's login, in the
# foreground, for procd, which starts it again whenever it ends: a server as
# a service that the boot script starts (onu-svc), the console's login from
# /etc/inittab once the boot script is done.
#
#   onu-run ssh     the ssh server: root's password and keys, on the
#                   management address and on the host link's, if any
#   onu-run pond    the status daemon and its panel, on the same, over HTTPS
#                   on port 443 with the key of /run/pond/tls.key, the boot
#                   script's copy of onu-config's, and on port 80 to send
#                   browsers there; without the key, over HTTP on port 80.
#                   It runs as the account pond that procd starts it as (ADR
#                   0014), which may listen on these ports as the boot script
#                   lets every account from port 80 up: its output goes to
#                   /run/pond/log, and the token of scripts is
#                   /run/pond/token, the boot script's copy of
#                   /etc/pond.token, which root alone reads
#   onu-run console the login prompt on the console, which asks for root's
#                   password; a bench whose /etc/board.conf has
#                   CONSOLE_AUTOLOGIN=root has root's shell there without
#                   one, which the image without that file never has
#   onu-run omcid   the OMCI daemon in the mode onu-apply last gave it in
#                   /run/omcid.mode: with the OLT's bridge ("bridge") or
#                   without it ("router", omcid -r), its output appended to
#                   /run/omcid.log; one started again after a crash takes
#                   up the mode the stick is in, and the MIB the OLT set up,
#                   which it keeps in /run/omcid/mib (omcid -m), so that the
#                   OLT sees no new ONU. It runs as the account omcid with the
#                   two powers it uses (onu-drop), in /run/omcid, and tells
#                   onu-apply of each change it publishes by onu-call (omcid -x)
#   onu-run ntp     ntpd, which sets the clock and keeps it, as the account ntp
#                   with the one power to set the clock (onu-drop), from the
#                   server that the stick's settings name (NTP_SERVER of
#                   /run/onu-system) or, without one, from the router at the
#                   other end of the management link: the stick has no way of
#                   its own to the internet, and the OLT gives no date
#
# The addresses are the pair in use, from /run/onu-mgmt, which onu-mgmt keeps:
# a server started again after a change of the pair listens on the new one.
# The servers listen on the host side and nowhere else: the stick has no
# packet filter, and nothing on the PON side is to reach them. Without the
# addresses it waits a little before it fails, so that procd does not start
# it again twice a second. The console and omcid need no address, and come
# up whatever the boot script did. ONU_ROOT, when set, is put in front of /run
# and /etc, for the tests.

set -u
RUN=${ONU_ROOT:-}/run
BOARD=${ONU_ROOT:-}/etc/board.conf
STATE=$RUN/onu-mgmt
SYSTEM=$RUN/onu-system
KEY=$RUN/dropbear/host_key
# Starts a program as an account of its own, with the powers it needs.
LIB=${ONU_ROOT:-}/usr/lib/onu
DROP=$LIB/onu-drop
# The OMCI port of the PON driver, which omcid opens.
OMCI_PORT=${ONU_ROOT:-}/dev/pon0omci0

# The console: a login prompt, or on a bench that says so root's shell.
# board.conf is read as data, never run.
if [ "${1:-}" = console ]; then
	if [ "$(sed -n 's/^CONSOLE_AUTOLOGIN=//p' "$BOARD" 2>/dev/null | tail -n 1)" = root ]; then
		exec login -f root
	fi
	exec getty -L console 0 vt100
fi

if [ "${1:-}" = omcid ]; then
	# The OMCI port is the group omcid's, as the driver makes it root's.
	[ ! -e "$OMCI_PORT" ] || { chown :omcid "$OMCI_PORT" && chmod 660 "$OMCI_PORT"; } ||
		echo "onu-run: omcid cannot open $OMCI_PORT" >&2
	mode=
	[ "$(cat "$RUN/omcid.mode" 2>/dev/null)" = router ] && mode=-r
	# $mode is an option or nothing, left unquoted on purpose.
	exec "$DROP" -c net_admin,net_raw omcid omcid $mode -m "$RUN/omcid/mib" \
		-x "$LIB/onu-call" >>"$RUN/omcid.log" 2>&1
fi

field() {
	sed -n "s/^$1=//p" "$STATE" 2>/dev/null | head -n 1
}

# The other end of a point-to-point link, from an IPv4 address and its
# length: the other host of a /30, the other address of a /31. A longer or a
# shorter network has none that is known.
peer() {
	addr=${1%/*}
	len=${1#*/}
	case $len in
	30 | 31) ;;
	*) return 1 ;;
	esac
	case $addr in
	*[!0-9.]* | *..* | .* | *.) return 1 ;;
	esac
	old_ifs=$IFS
	IFS=.
	# shellcheck disable=SC2086 # the octets, split on the dots
	set -- $addr
	IFS=$old_ifs
	[ $# -eq 4 ] || return 1
	n=0
	for o in "$@"; do
		# Without its leading zeros, which arithmetic would read as octal.
		o=${o#"${o%%[!0]*}"}
		[ "${o:-0}" -le 255 ] || return 1
		n=$((n * 256 + ${o:-0}))
	done
	if [ "$len" = 31 ]; then
		p=$((n ^ 1))
	else
		case $((n & 3)) in
		1) p=$((n + 1)) ;;
		2) p=$((n - 1)) ;;
		*) return 1 ;;
		esac
	fi
	echo "$((p >> 24 & 255)).$((p >> 16 & 255)).$((p >> 8 & 255)).$((p & 255))"
}

# The time. The server is read as data, never run; onu-config took it only in
# the shape of an address or a name. Without a server it waits an hour before
# it fails, so that procd asks again once an hour, as the link may change.
# Its process is ntpd's, whose id onu-mgmt takes to end it when the
# management link changes, and procd starts it again for the new one.
if [ "${1:-}" = ntp ]; then
	server=$(sed -n 's/^NTP_SERVER=//p' "$SYSTEM" 2>/dev/null | tail -n 1)
	[ -n "$server" ] || server=$(peer "$(field ADDRESS)")
	if [ -z "$server" ]; then
		echo "onu-run: no time server: NTP_SERVER is not set and the management link is no /30 or /31" >&2
		sleep 3600
		exit 1
	fi
	echo $$ >"$RUN/ntpd.pid"
	exec "$DROP" -c sys_time ntp ntpd -n -p "$server"
fi

mgmt=$(field ADDRESS)
data=$(field DATA_ADDRESS)
mgmt=${mgmt%/*}
data=${data%/*}
if [ -z "$mgmt" ]; then
	echo "onu-run: no management address in $STATE" >&2
	sleep 5
	exit 1
fi

case ${1:-} in
ssh)
	# The host key that onu-config ssh wrote from the store, or made and
	# kept there; without one, a key of its own until the next start.
	if [ ! -s "$KEY" ]; then
		mkdir -p "${KEY%/*}"
		dropbearkey -t ed25519 -f "$KEY" >/dev/null 2>&1 || {
			echo "onu-run: no host key" >&2
			sleep 5
			exit 1
		}
	fi
	# Without a store that could be read, root's password is not known
	# (onu-config load): keys only.
	nopw=
	[ "$(cat "$RUN/onu-auth" 2>/dev/null)" = '!' ] && nopw=-s
	exec dropbear -F $nopw -r "$KEY" -P "$RUN/dropbear.pid" -p "$mgmt:22" ${data:+-p "$data:22"}
	;;
pond)
	log=$RUN/pond/log
	[ -w "$RUN/pond" ] || log=/dev/null
	token=
	[ -r "$RUN/pond/token" ] && token=$RUN/pond/token
	# Started as root, the daemon runs as the account pond, with the one
	# power to listen on ports 80 and 443 (pond -u).
	if [ -r "$RUN/pond/tls.key" ]; then
		exec pond -u pond -l "https://$mgmt:443" -l "http://$mgmt:80" \
			${data:+-l "https://$data:443" -l "http://$data:80"} \
			-k "$RUN/pond/tls.key" ${token:+-t "$token"} >>"$log" 2>&1
	fi
	echo "onu-run: no key for HTTPS: the panel over HTTP" >>"$log"
	exec pond -u pond -l "http://$mgmt:80" ${data:+-l "http://$data:80"} \
		${token:+-t "$token"} >>"$log" 2>&1
	;;
*)
	echo "usage: onu-run ssh|pond|console|omcid|ntp" >&2
	exit 2
	;;
esac
