#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Paweł Phan <szop.hektar_1w@icloud.com>
#
# onu-run: a server of the host side, or the console's login, in the
# foreground, for procd, which starts it again whenever it ends: a server as
# a service that the boot script starts (onu-svc), the console's login from
# /etc/inittab once the boot script is done.
#
#   onu-run ssh     the ssh server: root's password and the keys of
#                   /run/dropbear/authorized_keys (onu-config ssh-keys), on the
#                   management address and on the host link's, if any
#   onu-run pond    the status daemon and its panel, on the same, over HTTPS
#                   on port 443 with the key of /run/pond/tls.key, the boot
#                   script's copy of onu-config's, and on port 80 to send
#                   browsers there; without the key, over HTTP on port 80.
#                   It runs as the account pond that procd starts it as (ADR
#                   0011), which may listen on these ports as the boot script
#                   lets every account from port 80 up: its output goes to
#                   /run/pond/log, and the token of scripts is the file
#                   /run/pond/token, onu-config's copy (onu-config token),
#                   which the daemon reads at each request that comes without
#                   a session, so that it need not exist when the daemon starts
#   onu-run console the login prompt on the console, which asks for root's
#                   password; a bench whose /etc/board.conf has
#                   CONSOLE_AUTOLOGIN=root has root's shell there without
#                   one, which the image without that file never has
#   onu-run omcid   the OMCI daemon in the mode onu-apply last gave it in
#                   /run/omcid.mode: with the OLT's bridge ("bridge") or
#                   without it ("router", omcid -r), its output appended to
#                   /run/omcid.log; one started again after a crash takes
#                   up the mode the stick is in, and the MIB the OLT set up,
#                   which it keeps in /run/omcid/mib (omcid -m), so that the
#                   OLT sees no new ONU. It runs as the account omcid with the
#                   two powers it uses (onu-drop), in /run/omcid, and tells
#                   onu-apply of each change it publishes by onu-call (omcid -x)
#   onu-run time    timed, which sets the clock and keeps it, as the account
#                   ntp with the powers to set the clock, to listen for PTP
#                   over layer 2 and on its UDP ports 319 and 320 (onu-drop):
#                   by NTP from the server that the
#                   stick's settings name (NTP_SERVER of /run/onu-system) or,
#                   without one, from the router at the other end of the
#                   management link; by PTP from a master on the management
#                   link's interface; by the PON, once the OLT gave the PTP
#                   hardware clock its time of day, which omcid tells in
#                   /run/omcid/tod; and from the date the OLT gave, which
#                   omcid writes in /run/omcid/clock, when the host gives none.
#                   Where the interface stamps PTP in hardware, timed steers
#                   its PTP hardware clock too, which is the group ntp's, and
#                   the stamps are turned on first, as root (timed -H); and
#                   it is the PTP master on the management link while it hears
#                   no better clock there and has a time worth giving (-M).
#                   The stick has no way of its own to the internet. Its state
#                   is /run/timed/state, which the status daemon reads
#
# The addresses are the pair in use, from /run/onu-mgmt, which onu-mgmt keeps:
# a server started again after a change of the pair listens on the new one.
# The servers listen on the management addresses and nowhere else, and
# onu-apply's guard (onu-fw guard) drops what comes to them by any interface
# but the management VLAN's, and the host link's to its own address there:
# nothing on the PON side, nor a local network, is to reach them. Without the
# addresses it waits a little before it fails, so that procd does not start
# it again twice a second. The console and omcid need no address, and come
# up whatever the boot script did. ONU_ROOT, when set, is put in front of /run
# and /etc, for the tests.

set -u
RUN=${ONU_ROOT:-}/run
BOARD=${ONU_ROOT:-}/etc/board.conf
STATE=$RUN/onu-mgmt
SYSTEM=$RUN/onu-system
KEY=$RUN/dropbear/host_key
# Starts a program as an account of its own, with the powers it needs.
LIB=${ONU_ROOT:-}/usr/lib/onu
DROP=$LIB/onu-drop
# The OMCI port of the PON driver, which omcid opens.
OMCI_PORT=${ONU_ROOT:-}/dev/pon0omci0
# The PTP hardware clocks, /dev/ptp0 and on, which timed steers.
PHC=${ONU_ROOT:-}/dev/ptp

# The console: a login prompt, or on a bench that says so root's shell.
# board.conf is read as data, never run.
if [ "${1:-}" = console ]; then
	if [ "$(sed -n 's/^CONSOLE_AUTOLOGIN=//p' "$BOARD" 2>/dev/null | tail -n 1)" = root ]; then
		exec login -f root
	fi
	exec getty -L console 0 vt100
fi

if [ "${1:-}" = omcid ]; then
	# The OMCI port is the group omcid's, as the driver makes it root's.
	[ ! -e "$OMCI_PORT" ] || { chown :omcid "$OMCI_PORT" && chmod 660 "$OMCI_PORT"; } ||
		echo "onu-run: omcid cannot open $OMCI_PORT" >&2
	mode=
	[ "$(cat "$RUN/omcid.mode" 2>/dev/null)" = router ] && mode=-r
	# $mode is an option or nothing, left unquoted on purpose.
	exec "$DROP" -c net_admin,net_raw omcid omcid $mode -m "$RUN/omcid/mib" \
		-x "$LIB/onu-call" >>"$RUN/omcid.log" 2>&1
fi

field() {
	sed -n "s/^$1=//p" "$STATE" 2>/dev/null | head -n 1
}

# The other end of a point-to-point link, from an IPv4 address and its
# length: the other host of a /30, the other address of a /31. A longer or a
# shorter network has none that is known.
peer() {
	addr=${1%/*}
	len=${1#*/}
	case $len in
	30 | 31) ;;
	*) return 1 ;;
	esac
	case $addr in
	*[!0-9.]* | *..* | .* | *.) return 1 ;;
	esac
	old_ifs=$IFS
	IFS=.
	# shellcheck disable=SC2086 # the octets, split on the dots
	set -- $addr
	IFS=$old_ifs
	[ $# -eq 4 ] || return 1
	n=0
	for o in "$@"; do
		# Without its leading zeros, which arithmetic would read as octal.
		o=${o#"${o%%[!0]*}"}
		[ "${o:-0}" -le 255 ] || return 1
		n=$((n * 256 + ${o:-0}))
	done
	if [ "$len" = 31 ]; then
		p=$((n ^ 1))
	else
		case $((n & 3)) in
		1) p=$((n + 1)) ;;
		2) p=$((n - 1)) ;;
		*) return 1 ;;
		esac
	fi
	echo "$((p >> 24 & 255)).$((p >> 16 & 255)).$((p >> 8 & 255)).$((p & 255))"
}

# The time. The server is read as data, never run; onu-config took it only in
# the shape of an address: the stick runs offline and resolves no name. PTP is
# listened for on the management link's interface, which onu-mgmt records.
# With neither a server nor that interface it waits an hour before it fails,
# so that procd asks again once an hour, as the link may change. Its process
# is timed's, whose id onu-mgmt takes to end it when the management link
# changes, and procd starts it again for the new one.
if [ "${1:-}" = time ]; then
	server=$(sed -n 's/^NTP_SERVER=//p' "$SYSTEM" 2>/dev/null | tail -n 1)
	[ -n "$server" ] || server=$(peer "$(field ADDRESS)")
	iface=$(field IFACE)
	if [ -z "$server" ] && [ -z "$iface" ]; then
		echo "onu-run: no time source: no NTP_SERVER, no /30 or /31 management link, no management interface" >&2
		sleep 3600
		exit 1
	fi
	[ -n "$server" ] ||
		echo "onu-run: no NTP server: NTP_SERVER is not set and the management link is no /30 or /31" >&2
	# The PTP hardware clocks are the group ntp's, as the driver makes them
	# root's. The interface's hardware stamps are turned on here, as root,
	# which timed itself may not; an interface without them leaves timed its
	# software stamps, and so does a failure here.
	for phc in "$PHC"[0-9]*; do
		[ -e "$phc" ] || continue
		{ chown :ntp "$phc" && chmod 660 "$phc"; } || echo "onu-run: timed cannot steer $phc" >&2
	done
	[ -z "$iface" ] || timed -H "$iface" || :
	echo $$ >"$RUN/timed.pid"
	exec "$DROP" -c sys_time,net_raw,net_bind_service ntp timed ${server:+-n "$server"} ${iface:+-p "$iface" -M} \
		-o "$RUN/omcid/clock" -t "$RUN/omcid/tod" -s "$RUN/timed/state"
fi

mgmt=$(field ADDRESS)
data=$(field DATA_ADDRESS)
mgmt=${mgmt%/*}
data=${data%/*}
if [ -z "$mgmt" ]; then
	echo "onu-run: no management address in $STATE" >&2
	sleep 5
	exit 1
fi

case ${1:-} in
ssh)
	# The host key that onu-config ssh wrote from the store, or made and
	# kept there; without one, a key of its own until the next start.
	if [ ! -s "$KEY" ]; then
		mkdir -p "${KEY%/*}"
		dropbearkey -t ed25519 -f "$KEY" >/dev/null 2>&1 || {
			echo "onu-run: no host key" >&2
			sleep 5
			exit 1
		}
	fi
	# Without a store that could be read, root's password is not known
	# (onu-config load), and until one is set it is the default, which is
	# printed in this repository: keys only then. onu-config ends this
	# server when a password is set, and procd starts it again with them.
	# So it does when its owner has it take keys alone, and no password
	# (onu-config ssh-keys only), which it says in $RUN/dropbear/keys-only.
	nopw=
	case $(cat "$RUN/onu-auth" 2>/dev/null) in
	'' | '!') nopw=-s ;;
	esac
	[ -e "$RUN/dropbear/keys-only" ] && nopw=-s
	# The public keys root logs in with are those of
	# $RUN/dropbear/authorized_keys (-D), which onu-config ssh-keys writes
	# from the store, after the image's own: /root is read-only.
	exec dropbear -F $nopw -r "$KEY" -D "$RUN/dropbear" -P "$RUN/dropbear.pid" \
		-p "$mgmt:22" ${data:+-p "$data:22"}
	;;
pond)
	log=$RUN/pond/log
	[ -w "$RUN/pond" ] || log=/dev/null
	token=$RUN/pond/token
	# Started as root, the daemon runs as the account pond, with the one
	# power to listen on ports 80 and 443 (pond -u).
	if [ -r "$RUN/pond/tls.key" ]; then
		exec pond -u pond -l "https://$mgmt:443" -l "http://$mgmt:80" \
			${data:+-l "https://$data:443" -l "http://$data:80"} \
			-k "$RUN/pond/tls.key" -t "$token" >>"$log" 2>&1
	fi
	echo "onu-run: no key for HTTPS: the panel over HTTP" >>"$log"
	exec pond -u pond -l "http://$mgmt:80" ${data:+-l "http://$data:80"} \
		-t "$token" >>"$log" 2>&1
	;;
*)
	echo "usage: onu-run ssh|pond|console|omcid|ntp" >&2
	exit 2
	;;
esac
