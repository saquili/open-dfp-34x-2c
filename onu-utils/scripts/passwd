#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Paweł Phan <szop.hektar_1w@icloud.com>
#
# passwd: a new password for root, the one account of the stick, which the
# console's login, the ssh server and the panel all take. It asks twice, at
# a terminal, without echo, and onu-store keeps it in the configuration
# store, so it holds after a restart and in the panel at once.
#
# The stick has no other account, so passwd takes no user and asks for no
# old password, since whoever runs it is root already. Its messages go to the
# terminal it asks at.

set -u

if [ $# -gt 0 ] && [ "$1" != root ]; then
	echo "The stick has one account, root." >&2
	exit 2
fi
if [ ! -t 0 ]; then
	echo "Run passwd at a terminal." >&2
	exit 2
fi

ask() {
	printf '%s' "$1" >&2
	IFS= read -r -s answer
	status=$?
	echo >&2
	return $status
}

ask "New password: " || exit 1
first=$answer
ask "The new password again: " || exit 1
if [ "$first" != "$answer" ]; then
	echo "The two differ; nothing changed." >&2
	exit 1
fi
if printf '%s\n' "$answer" | onu-store password; then
	echo "Root's password is changed for the console, ssh and the panel." >&2
else
	echo "Nothing changed." >&2
	exit 1
fi
