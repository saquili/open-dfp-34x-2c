#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Paweł Phan <szop.hektar_1w@icloud.com>
#
# onu-mgmt: the VLAN and the address the stick is managed on, from the host
# side, and a change of them that cannot lock anyone out: the new pair is
# added beside the old one, and replaces it only when confirmed, which a
# person can do only once the new pair answers.
#
#   onu-mgmt start VLAN ADDRESS [DATA_ADDRESS]
#                          the pair of the boot, on the interface mgmt, and
#                          the address on the SFP port itself, if any:
#                          recorded, and given to netifd; what is not a pair
#                          fails and changes nothing
#   onu-mgmt status        VLAN, ADDRESS, IFACE, DATA_ADDRESS and, while a
#                          change waits, PENDING_VLAN, PENDING_ADDRESS and
#                          PENDING_UNTIL, as KEY=VALUE lines
#   onu-mgmt add VLAN ADDRESS
#                          add the new pair beside the old: an interface (or
#                          the old one's, in the same VLAN), the switch's
#                          rules that keep the VLAN from the PON, an ssh
#                          server; gone again after PENDING_LIMIT seconds
#                          (600) unless committed
#   onu-mgmt commit        the new pair replaces the old, in the store too
#   onu-mgmt cancel        the new pair goes, the old one stays
#
# The pair in use is recorded in /run/onu-mgmt (VLAN, ADDRESS, IFACE, the
# VLAN's interface, NAME, the pair's interface of netifd, PREF, the priority
# of its switch rules, and DATA_ADDRESS, the address on the SFP port itself,
# if any), by start and again by each commit. netifd brings the pairs up: this script writes them as its part
# "mgmt" of netifd's configuration (onu-net), the pair in use and, while a
# change waits, the new one, and waits for the new address before it starts
# the ssh server on it. The status daemon listens on the addresses itself.
# ONU_ROOT, when set, is put in front of /run and /proc, for the tests.

set -u
ROOT=${ONU_ROOT:-}
RUN=$ROOT/run
# onu-net is one of the helpers out of a person's way (ADR 0015).
PATH=$PATH:$ROOT/usr/lib/onu
STATE=$RUN/onu-mgmt
PENDING=$RUN/onu-mgmt-pending
LIMIT=${PENDING_LIMIT:-600}
KEY=$RUN/dropbear/host_key

log() {
	echo "onu-mgmt: $*" >&2
	logger -t onu-mgmt "$*" 2>/dev/null
	return 0
}

field() {
	sed -n "s/^$1=//p" "$2" 2>/dev/null | head -n 1
}

uptime_s() {
	cut -d. -f1 "$ROOT/proc/uptime"
}

vlan_ok() {
	case $1 in
	"" | *[!0-9]* | 0*) return 1 ;;
	esac
	[ "$1" -ge 1 ] && [ "$1" -le 4094 ]
}

# An IPv4 address with a prefix of 1 to 30 bits.
address_ok() {
	echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}/([1-9]|[12][0-9]|30)$' &&
		echo "${1%/*}" | awk -F. '{ for (i = 1; i <= 4; i++) if ($i > 255) exit 1 }'
}

# The switch's rules for a management VLAN, at a priority of their own: on
# the SFP port's way in its frames go to the CPU alone, on the PON's they are
# dropped, as the boot script sets them for the first pair.
rules_add() {
	tc filter add dev sfp ingress pref "$2" protocol 802.1Q flower skip_sw \
		vlan_id "$1" action trap &&
		tc filter add dev pon ingress pref "$2" protocol 802.1Q flower skip_sw \
			vlan_id "$1" action drop
}

rules_del() {
	tc filter del dev sfp ingress pref "$1" protocol 802.1Q 2>/dev/null
	tc filter del dev pon ingress pref "$1" protocol 802.1Q 2>/dev/null
	return 0
}

# A VLAN on the SFP port that an interface has already, the management's own
# or one of onu-apply's: a second one of the same VLAN cannot be made.
vlan_in_use() {
	awk -F'|' -v vid="$1" 'NR > 2 {
		gsub(/[ \t]/, "", $2)
		gsub(/[ \t]/, "", $3)
		if ($2 == vid && $3 == "sfp")
			found = 1
	} END { exit !found }' "$ROOT/proc/net/vlan/config" 2>/dev/null
}

# A management VLAN as a device of netifd: the VLAN $2 on sfp, named $1, with
# IPv6, which an interface made after the boot has only when given it.
dev_conf() {
	printf "config device\n\toption type '8021q'\n\toption ifname 'sfp'\n"
	printf "\toption vid '%s'\n\toption name '%s'\n\toption ipv6 '1'\n\n" "$2" "$1"
}

# A pair as an interface of netifd: the interface $1 on the device $2 with
# the address $3.
iface_conf() {
	printf "config interface '%s'\n\toption device '%s'\n" "$1" "$2"
	printf "\toption proto 'static'\n\toption ipaddr '%s'\n\n" "$3"
}

# The pairs as netifd's part "mgmt": the one in use and, while a change
# waits, the new one. Each pair is an interface of its own, named once
# (NAME), so that netifd, which takes an interface down and up again when
# its addresses change, leaves the one alone when the other comes or goes:
# the address a person manages the stick from never goes away under them.
# Two pairs in one VLAN are two interfaces on one device.
net_apply() {
	{
		dev_conf "$(field IFACE "$STATE")" "$(field VLAN "$STATE")"
		iface_conf "$(field NAME "$STATE")" "$(field IFACE "$STATE")" "$(field ADDRESS "$STATE")"
		if [ -r "$PENDING" ]; then
			[ "$(field IFACE "$PENDING")" = "$(field IFACE "$STATE")" ] ||
				dev_conf "$(field IFACE "$PENDING")" "$(field VLAN "$PENDING")"
			iface_conf "$(field NAME "$PENDING")" "$(field IFACE "$PENDING")" \
				"$(field ADDRESS "$PENDING")"
		fi
	} | onu-net set mgmt
}

start() {
	vlan_ok "$1" && address_ok "$2" || {
		log "not a VLAN and an address with its prefix: $1 $2"
		return 2
	}
	printf 'VLAN=%s\nADDRESS=%s\nIFACE=mgmt\nNAME=mgmt\nPREF=1\nDATA_ADDRESS=%s\n' \
		"$1" "$2" "$3" >"$STATE.new" && mv "$STATE.new" "$STATE" || return 1
	rm -f "$PENDING"
	net_apply
}

status() {
	for k in VLAN ADDRESS IFACE DATA_ADDRESS; do
		echo "$k=$(field "$k" "$STATE")"
	done
	if [ -r "$PENDING" ]; then
		for k in VLAN ADDRESS UNTIL; do
			echo "PENDING_$k=$(field "$k" "$PENDING")"
		done
	fi
}

# Take the pending pair away again; @1 is the token of the change, so that a
# watcher of an earlier one leaves a later one alone.
drop_pending() {
	[ -r "$PENDING" ] && [ "$(field TOKEN "$PENDING")" = "$1" ] || return 0
	vlan=$(field VLAN "$PENDING")
	address=$(field ADDRESS "$PENDING")
	iface=$(field IFACE "$PENDING")
	pref=$(field PREF "$PENDING")
	pid=$(cat "$RUN/dropbear-pending.pid" 2>/dev/null)
	[ -n "$pid" ] && kill "$pid" 2>/dev/null
	rm -f "$RUN/dropbear-pending.pid" "$PENDING"
	net_apply || log "netifd was not told that $address in VLAN $vlan goes"
	[ "$iface" = "$(field IFACE "$STATE")" ] || rules_del "$pref"
	log "the management address $address in VLAN $vlan taken away"
}

add() {
	vlan=$1
	address=$2
	vlan_ok "$vlan" && address_ok "$address" || {
		log "not a VLAN and an address with its prefix: $vlan $address"
		return 2
	}
	[ -e "$PENDING" ] && {
		log "a change waits already"
		return 1
	}
	old_vlan=$(field VLAN "$STATE")
	old_iface=$(field IFACE "$STATE")
	old_pref=$(field PREF "$STATE")
	[ "$vlan" = "$old_vlan" ] && [ "$address" = "$(field ADDRESS "$STATE")" ] && return 0
	token=$$
	until=$(($(uptime_s) + LIMIT))
	if [ "$vlan" = "$old_vlan" ]; then
		iface=$old_iface
		pref=$old_pref
	else
		iface=mgmt$vlan
		pref=$((3 - ${old_pref:-1}))
		if vlan_in_use "$vlan"; then
			log "VLAN $vlan cannot be added on sfp: it is in use"
			return 1
		fi
		rules_add "$vlan" "$pref" || {
			rules_del "$pref"
			return 1
		}
	fi
	printf 'VLAN=%s\nADDRESS=%s\nIFACE=%s\nNAME=%s\nPREF=%s\nUNTIL=%s\nTOKEN=%s\n' \
		"$vlan" "$address" "$iface" "mgmt$token" "$pref" "$until" "$token" >"$PENDING"
	if ! net_apply || ! onu-net wait "$iface" "$address" 10; then
		log "the management address $address in VLAN $vlan did not come up"
		rm -f "$PENDING"
		net_apply
		[ "$iface" = "$old_iface" ] || rules_del "$pref"
		return 1
	fi
	dropbear -r "$KEY" -P "$RUN/dropbear-pending.pid" -p "${address%/*}:22" ||
		log "no ssh on $address"
	log "the management address $address in VLAN $vlan added beside the old one"
	(
		trap '' HUP
		sleep "$LIMIT"
		"$0" expire "$token"
	) >/dev/null 2>&1 </dev/null &
}

commit() {
	[ -r "$PENDING" ] || {
		log "no change waits"
		return 1
	}
	vlan=$(field VLAN "$PENDING")
	address=$(field ADDRESS "$PENDING")
	iface=$(field IFACE "$PENDING")
	name=$(field NAME "$PENDING")
	pref=$(field PREF "$PENDING")
	printf 'MGMT_VLAN=%s\nMGMT_ADDRESS=%s\n' "$vlan" "$address" | onu-config system ||
		log "the management address $address is kept until the next start only"
	old_iface=$(field IFACE "$STATE")
	old_pref=$(field PREF "$STATE")
	data=$(field DATA_ADDRESS "$STATE")
	printf 'VLAN=%s\nADDRESS=%s\nIFACE=%s\nNAME=%s\nPREF=%s\nDATA_ADDRESS=%s\n' \
		"$vlan" "$address" "$iface" "$name" "$pref" "$data" >"$STATE.new" &&
		mv "$STATE.new" "$STATE"
	rm -f "$PENDING"
	net_apply || log "netifd was not told that the old management address goes"
	[ "$iface" = "$old_iface" ] || rules_del "$old_pref"
	# One ssh server again, on the new address and the data path's: procd
	# starts the server of the boot again (onu-run) once it ends, with the
	# pair that is now in use.
	for f in "$RUN/dropbear.pid" "$RUN/dropbear-pending.pid"; do
		pid=$(cat "$f" 2>/dev/null)
		[ -n "$pid" ] && kill "$pid" 2>/dev/null
	done
	rm -f "$RUN/dropbear-pending.pid"
	# The time comes from the router at the other end of the management link
	# unless the settings name a server: procd starts ntpd again (onu-run
	# ntp) once it ends, for the new link's.
	pid=$(cat "$RUN/ntpd.pid" 2>/dev/null)
	[ -n "$pid" ] && kill "$pid" 2>/dev/null
	log "the management address is now $address in VLAN $vlan"
}

cancel() {
	[ -r "$PENDING" ] || return 0
	drop_pending "$(field TOKEN "$PENDING")"
}

case ${1:-} in
start) start "${2:-}" "${3:-}" "${4:-}" ;;
status) status ;;
add) add "${2:-}" "${3:-}" ;;
commit) commit ;;
cancel) cancel ;;
expire) drop_pending "${2:-}" ;;
*)
	echo "usage: onu-mgmt start VLAN ADDRESS [DATA_ADDRESS]|status|add VLAN ADDRESS|commit|cancel" >&2
	exit 2
	;;
esac
